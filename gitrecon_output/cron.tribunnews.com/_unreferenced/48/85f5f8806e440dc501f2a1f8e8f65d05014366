<?php/* ini_set('display_errors',1);error_reporting(E_ALL); */error_reporting(0);$time_start = time();define("DOC_ROOT","/var/www/html/cron/");include DOC_ROOT."config/config.php";include DOC_ROOT."lib/simple_html_dom.php";include DOC_ROOT."lib/Opensearch.php";/* Running in cmd / command- sudo -u www-data /usr/bin/php7.4 /var/www/html/cron/tribunnews/klasemen_motogp_konstruktor.php */$html = file_get_html("https://id.motorsport.com/motogp/standings/2022/?type=Constructor&class=", false, null, 0);if($html != false){	$dom = new DOMDocument('1.0', 'UTF-8');	$internalErrors = libxml_use_internal_errors(true);	$dom->loadHTML($html);	$xpath = new DOMXPath($dom);	$div = $xpath->query('//div[@class="ms-table-wrapper"]');	$constructorraw = array();	for ($i=0; $i < 50; $i++) {		$div = $div->item($i);		if ($div){			$xml_string = $dom->saveXML($div);			$xml = simplexml_load_string($xml_string);			$json = json_encode($xml);			$array = json_decode($json,TRUE);			$constructorraw = $array['table']['tbody']['tr'];			if (count($constructorraw) > 0){				break;			}		}	}		$totalUpdate =0;	if (count($constructorraw) > 0){		$cdn_url = 'https://t-1.tstatic.net/';				$constructorLable = [			"honda" => $cdn_url.'img/motogp/country/jp-2.svg',			"suzuki" => $cdn_url.'img/motogp/country/jp-2.svg',			"yamaha" => $cdn_url.'img/motogp/country/jp-2.svg',			"aprilia" => $cdn_url.'img/motogp/country/it-2.svg',			"ktm" => $cdn_url.'img/motogp/country/au-2.svg',			"ducati" => $cdn_url.'img/motogp/country/it-2.svg'		];				$constructordata = array();		for ($i=0; $i < count($constructorraw); $i++) {			$casis = $flag = '';			$win = $podium = $total_point = $position = 0;			$position = trim($constructorraw[$i]['td'][0]);			$casis = trim($constructorraw[$i]['td'][1]);			$flag = $constructorLable[strtolower($casis)];			$total_point = $constructorraw[$i]['td'][2];			//podium : 25 - 1, 20 - 2, 16 - 3			//win : 25			for ($k=3; $k < 40; $k++) {			 if (isset($constructorraw[$i]['td'][$k])){				  if (intval($constructorraw[$i]['td'][$k]) == 25){						 $win++;						 $podium++;					}else if (intval($constructorraw[$i]['td'][$k]) == 20){						 $podium++;					}else if (intval($constructorraw[$i]['td'][$k]) == 16){						 $podium++;					}			 }			}			$constructordata[] = array(			 'Casis' => $casis,			 'casis_flag' => $flag,			 'win' => $win,			 'podium' => $podium,			 'total_point' => trim($total_point),			 'position' => trim($position),			 'date_update' => date('Y-m-d H:i:s')			);		}				if (count($constructordata) > 0){			$opensearchTest = new Opensearch();			$opensearchTest->init(ES_TEST_URL,"","",false);						$opensearchTBO = new Opensearch();			$opensearchTBO->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);						foreach($constructordata as $constructor){				$Casis = $constructor['Casis'];								$condition = array("match_phrase" => array("Casis" => $Casis));				$fields = array("id");				$response = $opensearchTBO->findOne("klasemen_konstruktor_motogp",$condition,$fields);								if($response['status']){					$id = isset($response['data']['_source']['id'])?intval($response['data']['_source']['id']):0;										$casis_flag = isset($constructor['casis_flag'])?$constructor['casis_flag']:"";					$win = isset($constructor['win'])?intval($constructor['win']):0;					$podium = isset($constructor['podium'])?intval($constructor['podium']):0;					$total_point = isset($constructor['total_point'])?intval($constructor['total_point']):0;					$position = isset($constructor['position'])?intval($constructor['position']):0;					$date_update = isset($constructor['date_update'])?$constructor['date_update']:"";										$arrUpdate = array();					$arrUpdate['Casis'] = $Casis;					$arrUpdate['casis_flag'] = $casis_flag;					$arrUpdate['win'] = $win;;					$arrUpdate['podium'] = $podium;					$arrUpdate['total_point'] = $total_point;					$arrUpdate['position'] = $position;					$arrUpdate['date_update'] = $date_update;										//$responseUpdate = $opensearchTest->updateOne("klasemen_konstruktor_motogp", $id, $arrUpdate);					$responseUpdate = $opensearchTBO->updateOne("klasemen_konstruktor_motogp", $id, $arrUpdate);										/* echo $id."<br>";					echo "<pre>";					print_r($responseUpdate);					print_r($arrUpdate);					echo "</pre>"; */										if($responseUpdate['status']){						$totalUpdate++; 					}				}			}		}	}		 echo "Total Update = ".$totalUpdate."\n";}	echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";?>