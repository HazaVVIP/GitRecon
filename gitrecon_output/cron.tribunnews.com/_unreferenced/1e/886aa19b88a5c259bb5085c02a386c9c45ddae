    function url_title($string) {
        // Replace spaces with dashes
        $string = str_replace(' ', '-', $string);
        
        // Remove special characters
        $string = preg_replace('/[^A-Za-z0-9\-]/', '', $string);
        
        // Convert to lowercase
        $string = strtolower($string);
        
        return $string;
    }

