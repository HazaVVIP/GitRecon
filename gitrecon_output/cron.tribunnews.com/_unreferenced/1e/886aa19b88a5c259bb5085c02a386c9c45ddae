    function convert_date_indo($tanggal)
    {
        $bulan = array (
            1 => 'Januari',
            2 =>'Februari',
            3 => 'Maret',
            4 => 'April',
            5 => 'Mei',
            6 => 'Juni',
            7 => 'Juli',
            8 => 'Agustus',
            9 => 'September',
            10 => 'Oktober',
            11 =>'November',
            12 => 'Desember'
        );
        $split = explode('-', $tanggal);
        return $split[2] . ' ' . $bulan[ (int)$split[1] ] . ' ' . $split[0];
    }

    function http_client($url, $data=array(), $method="GET") {

        $auth = base64_encode(''.API_TJB_AUTH_USERNAME.':'.API_TJB_AUTH_PASSWORD.'');
        $data_send = http_build_query($data); 

        $opts = array(
            'http'=>array(
                'method' => "".$method."",
                'timeout' => 5,
                'header' => "Accept-language: en\r\n" .
                            "Authorization: Basic ".$auth."\r\n" .
                            "Api-Key: ".API_TJB_AUTH_KEY."\r\n" .
                            "Content-Length: " . strlen($data_send) . "\r\n",
                            'content' => $data_send
            ),
            'ssl'  => array (
                'verify_peer'      => false,
                'verify_peer_name' => false,
            )
        );

        $context = stream_context_create($opts);
        $response = @file_get_contents($url, false, $context);

        return $response;
    }

