        private function LogMessage($message,  $status="INFO")
		{
			$formattedMessage = "[".$status."][".$this->services_name."][" . date("Y-m-d H:i:s") . "] " . $message . PHP_EOL;

			$currentContent = file_get_contents($this->logger);
			$lineCount = substr_count($currentContent, PHP_EOL);
			if ($lineCount >= 100) {
				file_put_contents($this->logger, '', LOCK_EX);
			}

			file_put_contents($this->logger, $formattedMessage, FILE_APPEND | LOCK_EX);
		}

        private function ReadLogMessages() 
        {
			if (!file_exists($this->logger)) {
				$this->logMessage("LOG FILE NOT FOUND", "ERROR");
				return false;
			}
		
			$logLines = file($this->logger, FILE_IGNORE_NEW_LINES);
		
			if (!is_array($logLines)) {
				$this->logMessage("LOG FILE NOT READING", "ERROR");
				return false;
			}
		
			foreach ($logLines as $line) {
				echo $line . "<br>";
			}
		}

		function convert_date_indo($tanggal)
		{
			$bulan = array (
				1 => 'Januari',
				2 =>'Februari',
				3 => 'Maret',
				4 => 'April',
				5 => 'Mei',
				6 => 'Juni',
				7 => 'Juli',
				8 => 'Agustus',
				9 => 'September',
				10 => 'Oktober',
				11 =>'November',
				12 => 'Desember'
			);
			$split = explode('-', $tanggal);
			return $split[2] . ' ' . $bulan[ (int)$split[1] ] . ' ' . $split[0];
		}

		private function cron_iklan_premium()
		{
			$date = date('Y-m-d');
			$arrData = array();
			$response = array();
			if(!empty($date))
			{
				$queryGetIklanPremium = $this->model->check_iklan_premium($date);
				$totalDataIklanPremium = mysqli_num_rows($queryGetIklanPremium);
				$row_data = mysqli_fetch_assoc($queryGetIklanPremium);
				while($row_data = mysqli_fetch_assoc($queryGetIklanPremium))
    			{
					$arrData[] = array(
						'invoice' => $row_data['invoice'],
						'email_user' => $row_data['email_user'],
						'judul_iklan' => $row_data['title'],
						'paket_iklan' => $row_data['premium_name']." ".$row_data['product_title'],
						'periode_tayang' => $this->convert_date_indo(date('Y-m-d', strtotime($row_data['date_request'])))." - ".$this->convert_date_indo(date('Y-m-d', strtotime($row_data['date_expired']))),
						'date_request' => $row_data['date_request'],
						'date_expired' => $row_data['date_expired']
					);
				}
			}
			$response = array(
				'status' => true,
				'total_iklan' => $totalDataIklanPremium,
				'data' => $arrData
			);
			echo json_encode($response);
		}

