<?php
ini_set('display_errors',1);
error_reporting(E_ALL);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT."config/config.php";
include DOC_ROOT."config/other_config.php";
include DOC_ROOT."lib/Opensearch.php";

$domain = isset($_GET['domain'])?$_GET['domain']:"depok";
$dateStart = isset($_GET['start'])?$_GET['start']:"";
$dateEnd = isset($_GET['end'])?$_GET['end']:"";

if(empty($dateStart)){	
	$dateStart = date("Y-m-d", strtotime('-1 days'));
}

if(empty($dateEnd)){	
	$dateEnd = date("Y-m-d", strtotime('-1 days'));
}

echo $domain."<br>";
echo $dateStart." - ".$dateEnd."<br>";


$opensearchTest = new Opensearch();
$opensearchTest->init(OS_DEV_URL,OS_DEV_USERNAME,OS_DEV_PASSWORD,true);

$opensearchAllNetwork = new Opensearch();
$opensearchAllNetwork->init(OS_ALLNETWOORK_URL,OS_ALLNETWOORK_USERNAME,OS_ALLNETWOORK_PASSWORD,true);

$opensearch = new Opensearch();
$opensearch->init(OS_URL,OS_USERNAME,OS_PASSWORD,true);

$opensearchDaerah = new Opensearch();
$opensearchDaerah->init(OS_DAERAH_URL,OS_DAERAH_USERNAME,OS_DAERAH_PASSWORD,true);

$opensearchDaerahNew = new Opensearch();
$opensearchDaerahNew->init(OS_DAERAH_NEW_URL,OS_DAERAH_NEW_USERNAME,OS_DAERAH_NEW_PASSWORD,true);

$opensearchDaerahCluster = new Opensearch();
$opensearchDaerahCluster->init(OS_DAERAH_CLUSTER_URL,OS_DAERAH_CLUSTER_USERNAME,OS_DAERAH_CLUSTER_PASSWORD,true);

$opensearchCommerce = new Opensearch();
$opensearchCommerce->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);

$opensearchTBO = new Opensearch();
$opensearchTBO->init(OS_TBO_NEW_URL,OS_TBO_NEW_USERNAME,OS_TBO_NEW_PASSWORD,true);


$where = array();
array_push($where,array("range" => array("publish_date" => array("gte" => ''.$dateStart.' 00:00:00', "lte" => ''.$dateEnd.' 23:59:59'))));	
array_push($where,array("match_phrase" => array("domain" => $domain)));

$condition = array();
if(count($where) > 0){
	$condition = array("bool" =>
					array("must" =>
						$where
					)
				);
}
$index = "tribunnetwork-articles";
$response_os_allnetwork = $opensearchAllNetwork->count_total($index,$condition);	

$totalOsAllNetwork = 0;
if($response_os_allnetwork['status']){
	$totalOsAllNetwork = isset($response_os_allnetwork['total'])?$response_os_allnetwork['total']:0;
} 

echo "Total OS All Network : ".$totalOsAllNetwork."<br>";


/////////////////////////


$where = array();
array_push($where,array("range" => array("publish_date" => array("gte" => ''.$dateStart.' 00:00:00', "lte" => ''.$dateEnd.' 23:59:59'))));
$condition = array();
if(count($where) > 0){
	$condition = array("bool" =>
					array("must" =>
						$where
					)
				);
}

if($domain == "tribunnews"){
	$index = "tribunnews-articles";
	$response_os = $opensearch->count_total($index,$condition);	
} else {
	if(in_array($domain, LIST_COMMERCE_CLUSTER)){
		$index = $domain.".articles";
		$response_os = $opensearchCommerce->count_total($index,$condition);		
	} else if(in_array($domain, LIST_TBO_CLUSTER)){
		$index = $domain.".articles";
		$response_os = $opensearchTBO->count_total($index,$condition);	
	} else if(in_array($domain, LIST_DAERAH_NEW)){
		$index = $domain.".tribundaerah-articles";
		$response_os = $opensearchDaerahNew->count_total($index,$condition);
	} else if(in_array($domain, LIST_DAERAH_CLUSTER)){
		$index = $domain.".tribundaerah-articles";
		$response_os = $opensearchDaerahCluster->count_total($index,$condition);
	} else { 
		$index = $domain.".tribundaerah-articles";
		$response_os = $opensearchDaerah->count_total($index,$condition);
	}
}

$totalOs = 0;
if($response_os['status']){
	$totalOs = isset($response_os['total'])?$response_os['total']:0;
} 

echo "Total OS : ".$totalOs."<br>";


unset($opensearch);
unset($opensearchDaerah);
unset($opensearchDaerahNew);
unset($opensearchDaerahCluster);
unset($opensearchCommerce);
unset($opensearchTBO);
unset($opensearchAllNetwork);

echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";
?>