		$idCompetition = 17;
		$idSeason = isset($results['seasonId'])?intval($results['seasonId']):0;
		
		foreach($resultsTeams as $idx => $arrTeams){
			$negaraId = isset($arrTeams['teamId'])?intval($arrTeams['teamId']):0;
			$negara_eng = isset($arrTeams['teamName'])?$arrTeams['teamName']:"";
			
			$negara_eng = str_replace($arrFindCountry,$arrReplCountry,$negara_eng);
			$negara_key = strtolower(trim($negara_eng));
			$negara_alias = str_replace(" ","-",$negara_key);
			$negara_ind = $countries[$negara_key] ?? $negara_eng;
			$negara_short_eng = $countries_short[$negara_key] ?? $negara_eng;
			
			$image_negara_link = "https://asset-1.tribunnews.com/img/pialadunia2026/negara/".$negara_alias.".png";
			
			$confederation = isset($arrTeams['teamId'])?$arrTeams['teamId']:"";
			$confederation = isset($arrTeams['confederationId'])?$arrTeams['confederationId']:"";
			$stage = isset($arrTeams['stage'])?$arrTeams['stage']:"";
			$worldRanking = isset($arrTeams['worldRanking'])?intval($arrTeams['worldRanking']):0;
			$appearances = isset($arrTeams['appearances'])?intval($arrTeams['appearances']):0;
			$hostTeam = isset($arrTeams['hostTeam'])?intval($arrTeams['hostTeam']):0;
			
			echo "<img src='".$image_negara_link."' width='20' onerror='this.onerror=null;this.src=\"https://asset-2.tribunnews.com/default-2.jpg\";'> | ".$negara_eng." (".$negara_ind.") - ".$negara_short_eng." - ".$confederation."<br>"; 
			echo $stage."<br>";
			echo "Peringkat FIFA : ".$worldRanking."<br>";
			echo "Total Tampil : ".$appearances."<br>";
			if($hostTeam) echo "Tuan Rumah<br>";
			echo "<hr>";
			
			$where = array();
			array_push($where,array("match_phrase" => array("negara_eng" => $negara_eng)));
			array_push($where,array("match_phrase" => array("index_year" => "2026")));
			
			$condition = array();
			if(count($where) > 0){
				$condition = array("bool" =>
								array("filter" =>
									$where
								)
							);
			}
			
			$fields = array("id","image_negara_link");
			$response = $opensearchTBO->findOne("klasemen_pialadunia",$condition,$fields);
			
			if($response['status']){
				$id = isset($response['data']['_source']['id'])?intval($response['data']['_source']['id']):0;
				
				$arrUpdate = array();
				$arrUpdate['id_negara'] = $negaraId;
				$arrUpdate['id_competition'] = $idCompetition;
				$arrUpdate['id_season'] = $idSeason;
				$arrUpdate['confederation'] = $confederation;
