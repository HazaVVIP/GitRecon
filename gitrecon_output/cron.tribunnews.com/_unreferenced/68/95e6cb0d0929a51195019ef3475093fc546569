				$arrUpdate['total_penampilan'] = intval($appearances);
				$arrUpdate['tuan_rumah'] = intval($hostTeam);
				$arrUpdate['modified_date'] = date("Y-m-d H:i:s");
				
				/* echo "<pre>";
