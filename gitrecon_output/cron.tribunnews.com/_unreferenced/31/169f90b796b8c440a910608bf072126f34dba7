	public function get_data_voucher_pending_active($date_now)
	{   
        $con = $this->conn_db_tjb->conn_to_db_tjb_prod();
		$sql = "SELECT id_voucher, campaign_name, voucher_code, status_voucher, daily_balance, start_date, end_date, is_deleted
		FROM voucher_promo 
		WHERE DATE(start_date) <= '".$date_now."' and is_deleted = 0 and status_voucher = 'pending'
		ORDER BY id_voucher ASC";

		$result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}

	public function get_data_voucher_active_expired($date_now)
	{
        $con = $this->conn_db_tjb->conn_to_db_tjb_prod();
		$sql = "SELECT id_voucher, campaign_name, voucher_code, status_voucher, daily_balance, start_date, end_date, is_deleted
		FROM voucher_promo 
		WHERE DATE_ADD(end_date, INTERVAL 1 DAY) <= '".$date_now."' and is_deleted = 0 and status_voucher = 'active'
		ORDER BY id_voucher ASC";
		
		$result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}

