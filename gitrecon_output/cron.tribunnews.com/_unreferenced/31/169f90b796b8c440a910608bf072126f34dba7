	function check_iklan_premium($date)
	{
		$con = $this->conn_db_tjb->conn_to_db_tjb_dev();
        $sql = "SELECT pp.post_premium_id, pp.post_id, pp.user_id, pp.invoice, pp.product_json, pp.date_request, pp.date_expired, 
		s.email_user, sd.product_id, p.product_package_id, p.product_title, p2.title, ipp.premium_name FROM post_premium pp 
		LEFT JOIN post p2 ON p2.id = pp.post_id 
		LEFT JOIN settlement s ON s.invoice = pp.invoice
		LEFT JOIN settlement_detail sd on sd.settlement_id = s.settlement_id
		LEFT JOIN product p on sd.product_id = p.product_id 
		LEFT JOIN iklan_premium_package ipp on ipp.id_premium_package = p.product_package_id 
		WHERE DATE(pp.date_request) = '".$date."'";
        $result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}
