<?php
//ini_set('display_errors',1);
//error_reporting(E_ALL);
error_reporting(0);

$time_start = time();
include "config/config.php";
include "lib/Opensearch.php";
include "lib/Writelog.php";

$date = isset($_GET['date'])?$_GET['date']:"";

if(!empty($date)){
	$dateStart = $date;
	$dateEnd = $date;
} else {	
	$dateStart = date("Y-m-d", strtotime('-1 days'));
	$dateEnd = date("Y-m-d", strtotime('-1 days'));
}

echo $dateStart." - ".$dateEnd."<br>";

$condition 	= array (
				'bool' => 
				array (
				  'filter' => 
				  array (
					0 => 
					array (
					  'range' => 
					  array (
						'publish_date' => 
						array (
						  'gte' => ''.$dateStart.' 00:00:00',
						  'lte' => ''.$dateEnd.' 23:59:59',
						),
					  ),
					),
				  ),
				),
			  );	
$fields = array('id');
$sort = array("publish_date" => "asc");
$start = 0;
$limit = 1000;

//ES
$elasticsearch = new Opensearch();
$elasticsearch->init(ES_URL,"","",false);
$response_es = $elasticsearch->find('tribunnews-articles',$condition,$fields,$sort,$start,$limit);
$totalEs = 0;
$arrIDEs = array();
if($response_es['status']){
	$totalEs = isset($response_es['total_row'])?$response_es['total_row']:0;
	$dataEs = isset($response_es['data'])?$response_es['data']:array();
	
	if(count($dataEs) > 0){
		foreach($dataEs as $rowes){
			array_push($arrIDEs, intval($rowes['_source']['id']));
		}
	}
}

echo "Total ES : ".$totalEs."<br>";

//RDS
$con = mysqli_connect(RDS_HOST,RDS_USERNAME,RDS_PASSWORD,"tribunnews");
if (mysqli_connect_errno()) {
	echo "Failed to connect to MySQL: " . mysqli_connect_error();
	exit();
}

$totalRds = 0;
$arrIDRds = array();
$sql = "SELECT a.id
		FROM articles a
	    WHERE a.publish_date BETWEEN '".$dateStart." 00:00:00' AND '".$dateEnd." 23:59:59'
	    ORDER BY a.publish_date ASC";
$result = mysqli_query($con, $sql);
$totalRds = mysqli_num_rows($result);

if($totalRds > 0){
	while($post = mysqli_fetch_assoc($result))
	{
		array_push($arrIDRds, intval($post['id']));
	}	
}

echo "Total RDS : ".$totalRds."<br>";

$arrID = array();
$arrID = array_diff($arrIDRds, $arrIDEs);

$totalSyncEs = 0;
if(count($arrID) > 0){
	$id_diff = implode($arrID, ", ");
	
	$sql = "SELECT a.*, s.alias as section,ue.fullname as editor_fullname, uw.fullname as writter_fullname,ue.username as editor,
                  uw.id as writter,uw.id as writter_id,ue.id as editor_id,
                  cat.title as c_title, cat.alias as c_alias, s.title as s_title, s.status as sstatus,
                  sourc.name_source, sourc.url_source, sourc.source_group
                  FROM articles a 
				  inner join sections s on a.section_id = s.id 
                  left join categories cat on cat.id = a.category_id
                  left join source_news sourc on sourc.id = a.source
				  left join users uw on a.written_by = uw.id
                  left join users ue on a.editor_by = ue.id where a.id in (".$id_diff.")";
	$result = mysqli_query($con, $sql);
	$total = mysqli_num_rows($result);
	
	$idx = 0;
	if ($total > 0){
		while($row = mysqli_fetch_assoc($result))
		{
			if(isset($row['id']) && !empty($row['id'])){
				if($idx == 250) break;
				$row['hit'] = 0;
				$title = $row['title'];
				if(!mb_check_encoding($title, 'UTF-8')){
					$title = mb_convert_encoding ($title, 'UTF-8');
					$title = str_replace("?"," ",$title);
				}
				$row['title'] = trim($title);
				$row['frontpage_category'] = boolval($row['frontpage_category']);
				$row['frontpage_section'] = boolval($row['frontpage_section']);
				$row['keyword'] = boolval($row['keyword']);
				$foto_caption = $row['foto_caption'];
				if(!mb_check_encoding($foto_caption, 'UTF-8')){
					$foto_caption = mb_convert_encoding ($foto_caption, 'UTF-8');
					$foto_caption = str_replace("?"," ",$foto_caption);
				}
				$row['foto_caption'] = trim($foto_caption);
				$foto_source = $row['foto_source'];
				if(!mb_check_encoding($foto_source, 'UTF-8')){
					$foto_source = mb_convert_encoding ($foto_source, 'UTF-8');
					$foto_source = str_replace("?"," ",$foto_source);
				}
				$row['foto_source'] = trim($foto_source);
				$introtext = $row['introtext'];
				if(!mb_check_encoding($introtext, 'UTF-8')){
					$introtext = mb_convert_encoding ($introtext, 'UTF-8');
					$introtext = str_replace("?","",$introtext);
				}	
				$row['introtext'] = trim($introtext);
				$fulltexts = $row['fulltexts'];
				if(!mb_check_encoding($fulltexts, 'UTF-8')){
					$fulltexts = mb_convert_encoding ($fulltexts, 'UTF-8');
				}
				$row['fulltexts'] = trim($fulltexts);
				$row['subtitle_alias'] = isset($row['subtitle'])?strtolower(str_replace(" ","-",$row['subtitle'])):"";
				
				$responseInsertEs = $elasticsearch->insert("tribunnews-articles", $row);
				
				/* echo "<pre>";
				print_r($row);
				print_r($responseInsertEs);
				echo "</pre>"; */
				
				if($responseInsertEs['status']){
					$totalSyncEs++; 
				}
				$idx++; 
				//die;
			}
		}
		
	}
}

echo "Total SYNC RDS ke ES : ".$totalSyncEs."<br>";

mysqli_free_result($result);
mysqli_close($con);
unset($elastisearch);


echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";
?>