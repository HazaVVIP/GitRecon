function scrapeBiKursTransaksi(): ?array
{
    try {
        $url = 'https://www.bi.go.id/id/statistik/informasi-kurs/transaksi-bi/default.aspx';
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 2);
		curl_setopt($ch, CURLOPT_TIMEOUT, 3);
        // for tricked webserver that check user agent
        curl_setopt($ch, CURLOPT_USERAGENT, 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36');

        $html = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
		
        if ($html === false || $httpCode !== 200) {
            error_log("Failed to fetch URL: $url with HTTP code: $httpCode");
            return null;
        }

        // Parse the HTML using DOMDocument and DOMXPath ---
        $dom = new DOMDocument();
        libxml_use_internal_errors(true); // Suppress errors from SharePoint's complex HTML
        $dom->loadHTML($html);
        libxml_clear_errors();

        $xpath = new DOMXPath($dom);

        $dateNode = $xpath->query("//div[contains(., 'Update Terakhir')]/span")->item(0);
        $date = $dateNode ? trim($dateNode->textContent) : 'Date not found';

        $tableWrapperId = 'ctl00_PlaceHolderMain_g_6c89d4ad_107f_437d_bd54_8fda17b556bf_ctl00_GridView1';
        $rows = $xpath->query("//div[@id='$tableWrapperId']//tbody/tr");

        // Check if the query found the table rows. If not, the page structure might have changed.
        if ($rows->length === 0) {
            error_log("Scraper failed: Could not find table rows with the specified XPath.");
            return null;
        }

        $data = [];
        foreach ($rows as $row) {
            $cells = $xpath->query('td', $row);
            if ($cells->length >= 4) {
                $data[] = [
                    'mata_uang' => trim($cells->item(0)->textContent),
                    'nilai'     => format_indonesian_number($cells->item(1)->textContent),
                    'kurs_jual' => format_indonesian_number($cells->item(2)->textContent),
                    'kurs_beli' => format_indonesian_number($cells->item(3)->textContent),
                ];
            }
        }
        return [
            'sumber' => 'Bank Indonesia',
            'tanggal_kurs' => $date,
            'tanggal_fetch' => date('Y-m-d H:i:s'),
            'url' => $url,
            'tanggal_dt' => parse_indonesian_date($date),
            'data' => $data
        ];
    } catch (Exception $e) {
        error_log("Error in scrapeBiKursTransaksi: " . $e->getMessage());
        return null;
    }
}
