function getAqiDescription($aqi) {
    if ($aqi >= 0 && $aqi <= 50) {
        return [
            'kategori' => 'Baik',
            'dampak' => 'Tidak ada risiko atau dampak terhadap kesehatan. Udara bersih dan aman untuk semua orang.'
        ];
    } elseif ($aqi <= 100) {
        return [
            'kategori' => 'Sedang',
            'dampak' => 'Masih bisa diterima, tetapi ada beberapa orang yang sangat sensitif terhadap polusi mungkin mengalami efek kecil.'
        ];
    } elseif ($aqi <= 150) {
        return [
            'kategori' => 'Tidak sehat bagi kelompok sensitif',
            'dampak' => 'Kelompok sensitif, seperti anak-anak, orang tua, dan individu dengan masalah pernapasan, disarankan untuk membatasi aktivitas luar ruangan.'
        ];
    } elseif ($aqi <= 200) {
        return [
            'kategori' => 'Tidak sehat',
            'dampak' => 'Semua orang dapat mulai merasakan dampak kesehatan. Kelompok sensitif mungkin mengalami dampak yang lebih serius.'
        ];
    } elseif ($aqi <= 300) {
        return [
            'kategori' => 'Sangat tidak sehat',
            'dampak' => 'Peringatan kesehatan dikeluarkan. Risiko kesehatan meningkat untuk semua orang.'
        ];
    } else {
        return [
            'kategori' => 'Berbahaya',
            'dampak' => 'Kondisi darurat kesehatan. Seluruh populasi berisiko mengalami dampak kesehatan yang serius.'
        ];
    }
}
