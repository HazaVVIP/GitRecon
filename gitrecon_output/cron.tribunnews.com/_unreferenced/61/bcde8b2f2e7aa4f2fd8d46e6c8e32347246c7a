	private function call($method = 'GET', $index = "", $data = null, $json=false){
		$result = array();
		
		$url = $this->shipper_base_url.$index;
		
		if($this->method == "file_get_contents"){
			if($json){
				$data = json_encode($data);
			} else {
				$data = http_build_query($data);
			}

			if ($method == 'GET'){
				$opts = array(
					'http'=>array(
					  'method'=>$method,
					  'timeout' => $this->shipper_api_timeout,
					  'header'=>"Content-Type: application/json\r\n" .
								"X-API-Key: ".$this->shipper_api_key."\r\n"
					)
				  );
			} else {
				$opts = array(
					'http'=>array(
					  'method'=>$method,
					  'timeout' => $this->shipper_api_timeout,
					  'header'=>"Content-Type: application/json\r\n" .
								"Api-Key: ".$this->shipper_api_key."\r\n",
					  'content' => $data
					)
				  );
			}
			
			$context = stream_context_create($opts);
			$response = @file_get_contents($url, false, $context);
			$response_error = error_get_last();
			
			$httpCode = "";
			$httpMessage = "";
			$status_response_header = isset($http_response_header[0])?$http_response_header[0]:"";
			if(!empty($status_response_header)){
				preg_match('{HTTP\/\S*\s(\d{3})}', $status_response_header, $match);
				$httpCode = isset($match[1])?$match[1]:"";
				$arrMessage = explode($httpCode, $status_response_header);
				$httpMessage = isset($arrMessage[1])?trim($arrMessage[1]):"";
				if(empty($httpMessage)){
					$httpMessage = isset($response_error['message'])?$response_error['message']:"";
				}	
			}
			
			/* echo $httpCode."<br>";
			echo $url."<br>";
			echo "<pre>";
			print_r($opts);
			print_r($data);
			print_r($response);
			print_r($response_error);
			echo "</pre>"; */
			
			$arrResponse = null;
			$error_code = "";
			$error_message = "";
			
			if($httpCode == 200){
				$arrResponse = json_decode($response, true);
			} else {
				$arrResponse = json_decode($response, true);
				$error_code = isset($arrResponse['metadata']['errors'][0]['code'])?$arrResponse['metadata']['errors'][0]['code']:"";
				$error_message = isset($arrResponse['metadata']['errors'][0]['message'])?$arrResponse['metadata']['errors'][0]['message']:"";	
			}
			
			$result['http_code'] = $httpCode;
			$result['error_code'] = $error_code;
			$result['error_message'] = $error_message;
			$result['data'] = $arrResponse;
		} else {
			$ch = curl_init();
			curl_setopt($ch, CURLOPT_URL, $url);
			curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
			curl_setopt($ch, CURLOPT_TIMEOUT, $this->shipper_api_timeout);
			curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
			curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
			curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
			$headers = [];
			$headers[] = "X-API-Key: ".$this->shipper_api_key."";
			if($json){
				$headers[] = 'Content-Type: application/json';
				$data = json_encode($data);
			}
			curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
			
			switch($method) {
				case 'GET' :
					break;
				case 'POST' :
					curl_setopt($ch, CURLOPT_POST, true);
					curl_setopt($ch, CURLOPT_POSTFIELDS, $data);
					break;
				case 'PUT' :
					curl_setopt($ch, CURLOPT_CUSTOMREQUEST, 'PUT');
					curl_setopt($ch, CURLOPT_POSTFIELDS, $data);
					break;
				case 'DELETE' :
					curl_setopt($ch, CURLOPT_CUSTOMREQUEST, 'DELETE');
					if(!empty($data)){
						curl_setopt($ch, CURLOPT_POSTFIELDS, $data);
					}
					break;
			}
			
			$response = curl_exec($ch);
			$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
			curl_close($ch);
			
			/* echo $httpCode."<br>";
			echo $url."<br>";
			echo "<pre>";
			print_r($headers);
			print_r($data);
			print_r($response);
			echo "</pre>"; */
			
			$arrResponse = null;
			$error_code = "";
			$error_message = "";
			
			if($httpCode == 200){
				$arrResponse = json_decode($response, true);
			} else {
				$arrResponse = json_decode($response, true);

				$error_code = isset($arrResponse['metadata']['errors'][0]['code'])?$arrResponse['metadata']['errors'][0]['code']:"";
				$error_message = isset($arrResponse['metadata']['errors'][0]['message'])?$arrResponse['metadata']['errors'][0]['message']:"";
			}
			
			$result['http_code'] = $httpCode;
			$result['error_code'] = $error_code;
			$result['error_message'] = $error_message;
			$result['data'] = $arrResponse;
		}
		
		
		return $result;
	}	
	
	public function location_search($page=1,$keyword,$adm_level=""){
		$data = array();
		$service = "location?keyword=".$keyword."&limit=100";
		
		if(!empty($page)){
			$service .= "&page=".$page;
		}
		
		if(!empty($adm_level)){
			$service .= "&adm_level=".$adm_level;
		}
			
		$response = $this -> call('GET', $service, $data);
		
		return $response;
	}
	
