				'status' => true,
				'total_iklan' => $totalDataIklanPremium,
				'data' => $arrData
			);

			$json_data = json_encode($response);

			$dataPost = array("json_data" => $json_data);

			$dataSend = http_build_query($dataPost); 

			$apiUrl = API_TJB_URL . "/cron/iklan_premium";

			$resultApis = http_client($apiUrl, $dataPost, "POST");

			$log_data = json_encode(array('json_data' => $json_data, 'apiUrl' => $apiUrl, 'resultApis' => $resultApis));
            $this->LogMessage($log_data);
			return true;
		}

        private function LogMessage($message,  $status="INFO")
		{
			$formattedMessage = "[".$status."][".$this->services_name."][" . date("Y-m-d H:i:s") . "] " . $message . PHP_EOL;

			$currentContent = file_get_contents($this->logger);
			$lineCount = substr_count($currentContent, PHP_EOL);
			if ($lineCount >= 100) {
				file_put_contents($this->logger, '', LOCK_EX);
			}

			file_put_contents($this->logger, $formattedMessage, FILE_APPEND | LOCK_EX);
		}

        private function ReadLogMessages() 
        {
			if (!file_exists($this->logger)) {
				$this->logMessage("LOG FILE NOT FOUND", "ERROR");
				return false;
			}
		
			$logLines = file($this->logger, FILE_IGNORE_NEW_LINES);
		
			if (!is_array($logLines)) {
				$this->logMessage("LOG FILE NOT READING", "ERROR");
				return false;
			}
		
			foreach ($logLines as $line) {
				echo $line . "<br>";
			}
		}

