        public function init($services, $data=array()) 
        {
            if (!isset($this->services[$services])) {
                $this->LogMessage("SERVICES NOT FOUND", "ERROR");
                $this->ReadLogMessages();
                exit();
            }

            if (isset($data)) {
                if (!is_array($data)) {
                    $this->LogMessage("DATA NOT FOUND", "ERROR");
                    $this->ReadLogMessages();
                    exit();
                }
                $this->data = $data;
            }

            $this->services_name = $services;
            eval('$this->' . $this->services[$services] . '();');
			$this->ReadLogMessages();
            exit();
        }

        private function insert_top_classified() 
        {
			$arrResponse = array();
			$time_start = 0;
			$total_analytics = 0;

            $google_analytic = new Google_analytic4(AUTH_CREDENTIAL_STAG);
			$google_analytic->initializeAnalytics($this->propertyId);

			$analytics = (object) $google_analytic->getTopTribunjualbeli($this->ga_domain_web);
			if ($analytics->status == false) {
				$this->LogMessage("STOP processing insert top iklan. Status = false", "INFO");
				return false;
			}

			$total_analytics = count($analytics->data);
			if ($total_analytics <= 0) {
				$this->LogMessage("STOP processing insert top iklan. Data = 0", "INFO");
				return false;
			}

            $this->LogMessage("Processing insert top iklan with data count: " . $total_analytics);

			$fields = GetFieldOSPopularClassified();

			foreach ($analytics->data as $idx => $populer) {

				$condition = ["match" => ["id" => $populer['id']]];
				$response = $this->elastisearch->findOne($this->os_index->web_populer, $condition, $fields);

				if (!$response['status']) {
					$this->LogMessage($response['status'], "ERROR");
					continue;
				}

				$dataEs = isset($response['data']) ? $response['data'] : null;

				if (empty($dataEs) && count($dataEs) <= 0) {
					$this->LogMessage($response['status'], "INFO");
					continue;
				}

				$dataInsert = IterationDataPopularClassified($dataEs);

				$response = $this->elastisearch->insert($this->os_index->web_populer, $dataInsert);

				$res = array();
				$res['id'] = $populer['id'];
				$res['status'] = $response['status'];
				$res['result'] = $response['result'];
				$res['pageviews'] = intval($populer['pageviews']);
				$arrResponse[] = $res;
				$total++;
			}

			$result['status'] = true;
			$result['total'] = $total;
			$result['data'] = $arrResponse;

            $populer_data = isset($result['data']) ? $result['data'] : array();
            $response_data = json_encode(array('total_procced' => count($populer_data), 'source_data' => $total_analytics, 'execution_time' => microtime(true) - $time_start));
            $this->LogMessage($response_data);

            # DELETE ALL TOP IKLAN
            $dateToday = date("Y-m-d");
			$dateDaysAgo = strtotime('-31 day', strtotime($dateToday));
			$startDateDaysAgo = date('Y-m-d 00:00:00', $dateDaysAgo);
			$endDateDaysAgo = date('Y-m-d 23:59:59', $dateDaysAgo);

			$condition = array("range" => array("date_publish" => array("gte" => $startDateDaysAgo, "lte" => $endDateDaysAgo)));
			$response = $this->elastisearch->deleteMany($this->os_index->web_populer, $condition);
			file_get_contents("https://www.tribunjualbeli.com/tcache/clear_home");

			if (!$response['status']) {
				$this->LogMessage("FAILED DELETE TOP IKLAN", "ERROR");
				return false;
			}

			$this->LogMessage("SUCCESS DELETE TOP IKLAN");
			return true;
        }

