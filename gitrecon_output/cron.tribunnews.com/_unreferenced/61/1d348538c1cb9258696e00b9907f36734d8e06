		private function promo_code()
		{
			$time_start = time();
			$dateNow = date("Y-m-d", time());
			$TotalPendingToActiveCount = 0;
			$TotalActiveToExpiredCount = 0;

			$queryGetPendingtoActive = $this->model->get_data_voucher_pending_active($dateNow);

			$response = [];
			while ($dataActive =  mysqli_fetch_assoc($queryGetPendingtoActive)) {
				$response[] = $dataActive;
			}
			
			if (count($response) <= 0) {
				$this->LogMessage("DATA RDS get_data_voucher_pending_active <= 0", "INFO");
				return false;
			}

			foreach($response as $row_active)
			{
				$status_voucher_active = "active";
				$this->model->update_status_voucher($row_active['id_voucher'], $status_voucher_active);
				$TotalPendingToActiveCount++;
			}

			sleep(2);

			$queryGetActivetoExpired = $this->model->get_data_voucher_active_expired($dateNow);

			$response_expired = [];
			while ($dataEx =  mysqli_fetch_assoc($queryGetActivetoExpired)) {
				$response_expired[] = $dataEx;
			}
			
			if (count($response_expired) <= 0) {
				$this->LogMessage("DATA RDS get_data_voucher_active_expired <= 0", "INFO");
				return false;
			}

			foreach($response_expired as $row_expired)
			{
				$status_voucher_active = "expired";
				$this->model->update_status_voucher($row_expired['id_voucher'], $status_voucher_active);
				$TotalActiveToExpiredCount++;
			}

			$log_data = json_encode(array('TotalPendingToActiveCount' => $TotalPendingToActiveCount, 'TotalActiveToExpiredCount' => $TotalActiveToExpiredCount, 'execution_time' => microtime(true) - $time_start) );
            $this->LogMessage($log_data);
			return true;

		}

