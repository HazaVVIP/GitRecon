        private function sync_rds_es_web() 
		{
			$time_start = time();
			$total_process = 0;
			
			$main_at = date("Y-m-d", strtotime('-1 days'));
			$start_at = date("Y-m-d", strtotime('-1 days'));
			// $start_at = date("Y-m-d", strtotime('-10 days'));
			$end_at = $main_at;

			if (isset($_GET['date'])) {
				$start_at = $_GET['date'];
				$end_at = $_GET['date'];
			}
			
			$query = $this->model->get_id_post_by_date($start_at, $end_at);
			$response = [];
			while ($dataEx =  mysqli_fetch_assoc($query)) {
				$response[] = $dataEx;
			}
			
			if (count($response) <= 0) {
				$this->LogMessage("DATA RDS <= 0", "INFO");
				return false;
			}

			$arr_id_rds = [];
			foreach($response as $row){
				array_push($arr_id_rds, $row['id']);
			}

			$condition  = array ( 'bool' => array ( 'filter' => array ( 0 => array ( 'range' => array ( 'date_created' => array ( 'gte' => ''.$start_at.' 00:00:00', 'lte' => ''.$end_at.' 23:59:59'))))));
			$fields = array('id');

			$response_es = $this->elastisearch->find( $this->os_index->web,$condition, $fields);

			if(!$response_es['status']) {
				$this->LogMessage("DATA ES NOT FOUND", "INFO");
				return false;
			}

			$total_es = isset($response_es['total_row'])?$response_es['total_row']:0;
			$arr_es = isset($response_es['data'])?$response_es['data']:array();
			
			if(count($arr_es) <= 0){
				$this->LogMessage("DATA ES <= 0", "INFO");
				return false;
			}

			$arr_id_es = [];
			foreach($arr_es as $row){
				array_push($arr_id_es, $row['_id']);
			}

			if(count($arr_id_rds) <= 0 && count($arr_id_es) <= 0) {
				$this->LogMessage("DATA RDS & DATA ES <= 0", "INFO");
				return false;
			}

			$arr_id = array_diff($arr_id_rds, $arr_id_es);
			if (count($arr_id) <= 0) {
				$this->LogMessage("NOTHING TO SYNC", "INFO");
				return false;
			}

			$query_post = $this->model->get_post_by_array_id($arr_id);

			$response_post = [];
			while ($data_post =  mysqli_fetch_assoc($query_post)) {
				$response_post[] = (object) $data_post;
			}

			if (count($response_post) <= 0) {
				$this->LogMessage("DATA RDS INSERT SYNC <= 0", "INFO");
				return false;
			}

			foreach ($response_post as $rows) {
				$data_insert = IterationDataSyncRdsEsWeb($rows);
				$response_insert_es = $this->elastisearch->insert($this->os_index->web, $data_insert);
				$total_process++;
			}

			$response_data = json_encode(array('total_procced' => $total_process, 'source_data' => count($response_post), 'execution_time' => microtime(true) - $time_start));
            $this->LogMessage($response_data);
            return true;
        }

