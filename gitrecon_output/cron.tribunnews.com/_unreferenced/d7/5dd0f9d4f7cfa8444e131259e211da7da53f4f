<?php
ini_set('display_errors',1);
error_reporting(E_ALL);
//error_reporting(0);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

echo __DIR__."<br>";
echo __DIR__ . "/vendor/autoload.php<br>";
echo __DIR__ . "/google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json<br>";

require_once __DIR__ . "/vendor/autoload.php"; // pastikan composer autoload dipanggil

define("AUTH_CREDENTIAL_PROD", __DIR__."/google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");

// Inisialisasi client
$client = new Google_Client();
$client->setAuthConfig(AUTH_CREDENTIAL_PROD);
$client->addScope('https://www.googleapis.com/auth/indexing');

// Buat service HTTP client
$httpClient = $client->authorize();

// URL yang mau di reindex
$url = 'https://jateng.tribunnews.com/2025/08/14/mengungsi-di-rumah-taylor-swift-gegara-kebakaran-zoe-kravitz-malah-hancurkan-toilet-pakai-linggis';

// Request body
$content = json_encode([
    'url' => $url,
    'type' => 'URL_UPDATED'
]);

$response = $httpClient->post('https://indexing.googleapis.com/v3/urlNotifications:publish', [
    'headers' => ['Content-Type' => 'application/json'],
    'body' => $content
]);

echo "<pre>";
print_r((string)$response->getBody());
echo "</pre>";

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
?>