<?php
date_default_timezone_set('Asia/Jakarta');
//set_time_limit(0);
ini_set('display_errors',1);
error_reporting(E_ALL);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT ."config/config.php";
include DOC_ROOT ."lib/Utils.php";
include DOC_ROOT."lib/Opensearch.php";

$date = isset($_GET['date'])?$_GET['date']:"";
if(empty($date)){
	$date =  date("Y-m-d");
} 

$opensearch = new Opensearch();
$opensearch->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true); //prod
//$opensearch->init(OS_DEV_URL,OS_DEV_USERNAME,OS_DEV_PASSWORD,true); //dev

$index = 'widget_idx';

$where = array();
array_push($where,array("term" => array("tanggal_dt" => $date)));

$condition = array();
if(count($where) > 0){
	$condition = array("bool" =>
					array("must" =>
						$where
					)
				);
}

$fields = array('name','last','chg','cgh_prnct');
$sort = array("last" => "asc");
$start = 0;
$limit = 50;
$response = $opensearch->find($index,$condition,$fields,$sort,$start,$limit);	

if($response['status']){
	$totalValas = isset($response['total_row'])?$response['total_row']:0;
	$dataValas = isset($response['data'])?$response['data']:array();
	
	echo "Update Terakhir : ".$date."<br>";
	echo "Sumber : IQ Plus <br><br>";
	echo "<table border='1'>";
	
	echo "<tr><th>Name</th><th>Last</th><th>Chg</th><th>% Chg</th></tr>";
	
	if(count($dataValas) > 0){
		foreach($dataValas as $rows){
			$row = $rows['_source'];
			
			echo "<tr><td>".$row['name']."</td><td>".$row['last']."</td><td>".$row['chg']."</td><td>".$row['cgh_prnct']."</td></tr>";
		}
	}
	
	echo "</table>";
}

unset($opensearch);

echo "<br>\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
?>