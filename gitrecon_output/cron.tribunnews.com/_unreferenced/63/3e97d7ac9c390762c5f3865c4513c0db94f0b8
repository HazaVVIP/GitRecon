<?php
ini_set('display_errors',1);
error_reporting(E_ALL);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Opensearch.php";

$api_key = YOUTUBE_KEY_DEV;
$channelId = YOUTUBE_CHANNEL_ID;
$max = 50;
$total = 0;
$total_update = 0;

$opensearch = new Opensearch();
$opensearch->init(OS_DEV_URL, OS_DEV_USERNAME, OS_DEV_PASSWORD, true);

$index = "tribunnews-video_streaming";
$videolist = array();

try 
{
    $apiUrl = "https://www.googleapis.com/youtube/v3/search?part=snippet&channelId=".$channelId."&order=date&maxResults=".$max."&type=video&key=".$api_key;
    $opts = array(
        'http'=>array(
            'method'=>"GET",
            'timeout' => 5,
            'header'=>"Accept-language: en\r\n"
        ),
        'ssl'  => array (
            'verify_peer'      => false,
            'verify_peer_name' => false,
          )
        );
    $context = stream_context_create($opts);
    $apiData = @file_get_contents($apiUrl, false, $context);

    if($apiData === FALSE) 
    {
        throw new Exception("Failed to fetch data from YouTube API");
	} 
    else 
    {
        $videolist = json_decode($apiData);

        foreach($videolist->items as $key => $value)
        {
            $video_id = $value->id->videoId;
            $live_broadcast = (isset($value->snippet->liveBroadcastContent) && $value->snippet->liveBroadcastContent === "live") ? 1 : 0;
            
            $condition = array("match_phrase" => array("video_id" => $video_id));
            $fields = array("id");
            $response = $opensearch->findOne($index, $condition, $fields);

            if($response['status'] == 1)
            {
                $id = isset($response['data']['_source']['id']) ? $response['data']['_source']['id'] : 0;
                $video_live = isset($response['data']['_source']['video_live']) ? $response['data']['_source']['video_live'] : 0;
                $update_video_live = 0;
                
                if($live_broadcast == 0 && $video_live == 1)
                {
                    $arrYoutubeUpdate = array();
                    $arrYoutubeUpdate['video_live'] = 0;
                    $arrYoutubeUpdate['video_published_at'] = date('Y-m-d H:i:s', strtotime($value->snippet->publishedAt));

                    $response_update_os = $opensearch->updateOne($index, $id, $arrYoutubeUpdate);

                    if($response_update_os['status'] == 1)
                    {
                        echo "<pre>";
                        echo "Success update live streaming data to opensearch. Data ke: ".$total_update;
                        echo "</pre>";
                        echo "<pre>";
                        print_r($response_update_os);
                        echo "</pre>";
                    }
                }

                $total_update++;
            }

            if($response['status'] == 0)
            {
                $video_title = utf8_encode(trim($value->snippet->title));
                $video_title = preg_replace('/[^(\x20-\x7F)]*/','', $video_title);
                $video_title = str_replace("'","\'",$video_title);

                $arrYoutubeInsert = array();
                $arrYoutubeInsert['id'] = time();
                $arrYoutubeInsert['video_id'] = $video_id;
                $arrYoutubeInsert['video_title'] = isset($video_title) ? $video_title : "";
                $arrYoutubeInsert['video_alias'] = isset($value->snippet->title) ? url_title($value->snippet->title) : "";
                $arrYoutubeInsert['video_description'] = isset($value->snippet->description) ? $value->snippet->description : "";
                $arrYoutubeInsert['video_thumbnail'] = isset($value->snippet->thumbnails->medium->url) ? $value->snippet->thumbnails->medium->url : "";
                $arrYoutubeInsert['video_channel_title'] = isset($value->snippet->channelTitle) ? $value->snippet->channelTitle : "";
                $arrYoutubeInsert['video_live'] = (isset($value->snippet->liveBroadcastContent) && $value->snippet->liveBroadcastContent === "live") ?  1 : 0;
                $arrYoutubeInsert['video_published_at'] = date('Y-m-d H:i:s', strtotime($value->snippet->publishedAt));
                $arrYoutubeInsert['video_insert_at'] = date('Y-m-d H:i:s');

                $response_insert_os = $opensearch->insert($index, $arrYoutubeInsert);

                if($response_insert_os['status'] == 1)
                { 
                    echo "<pre>";
                    echo "Success insert data to opensearch. Data ke: ".$total;
                    echo "</pre>";
                    echo "<pre>";
                    print_r($response_insert_os);
                    echo "</pre>";
                    echo "<pre>";
                    print_r($video_title);
                    echo "</pre>";
                }
                $total++;
            }
        }
	}
}
catch(Exception $e)
{
	$apierror = $e->getMessage();
}

function url_title($str, $separator = '-', $lowercase = FALSE)
{
    if ($separator === 'dash')
    {
        $separator = '-';
    }
    elseif ($separator === 'underscore')
    {
        $separator = '_';
    }

    $q_separator = preg_quote($separator, '#');

    $trans = array(
        '&.+?;'            => '',              // Menghapus entitas HTML
        '[^\w\d _-]'       => '',              // Menghapus karakter non-alfanumerik
        '\s+'              => $separator,      // Mengganti spasi dengan separator
        '('.$q_separator.')+' => $separator   // Mengganti banyak separator berturut-turut dengan satu separator
    );

    $str = strip_tags($str);

    foreach ($trans as $key => $val)
    {
        $str = preg_replace('#'.$key.'#i', $val, $str);
    }

    if ($lowercase === TRUE)
    {
        $str = strtolower($str);
    }

    return trim(trim($str, $separator));
}

echo '<br>Total data: '.$total;
echo '<br>Total data updated: '.$total_update;
echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";
?>