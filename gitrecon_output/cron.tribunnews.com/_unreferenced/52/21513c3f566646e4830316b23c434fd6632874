<?php
ini_set('display_errors',1);
error_reporting(E_ALL);
//error_reporting(0);

use \MongoDB\BSON\UTCDateTime;

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require_once "./../../vendor/autoload.php";
include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Mongodb.php";

//MONGODB
$mongodb = new Mongodb();
$mongodb->connect(MONGODB_USER_HOST_PROD,MONGODB_USER_USERNAME_PROD,MONGODB_USER_PASSWORD_PROD,"tribunnews",true);

$email = isset($_GET['email'])?$_GET['email']:"";
$username = isset($_GET['username'])?$_GET['username']:"";

$userId = 1668565;
if(!empty($email)){
	$condition = array("email" => $email);
	$fields = array("_id","old_id");
	$rsUserCheck = $mongodb->findOne("users",$condition,$fields);
	
	if($rsUserCheck){
		$userId = $rsUserCheck->old_id;
	}	
}

if(!empty($username)){
	$condition = array("username" => $username);
	$fields = array("_id","old_id");
	$rsUserCheck = $mongodb->findOne("users",$condition,$fields);
	
	if($rsUserCheck){
		$userId = $rsUserCheck->old_id;
	}	
}

$dateHistory = date("Ymd", strtotime('-3 days'));

$limit = 5;
$collection = "users_history";


$query = [
			"user_id" => intval($userId),
			"dt" => ['$gte' => intval($dateHistory)]
		];
		
$options = array();
$options = [
    'facet' => [
        'topSections' => [
            ['$group' => ['_id' => '$sec_alias', 'total' => ['$sum' => 1]]],
            ['$sort' => ['total' => -1]],
            ['$limit' => 3]
        ],
        'topCategories' => [
            ['$group' => ['_id' => '$cat_alias', 'total' => ['$sum' => 1]]],
            ['$sort' => ['total' => -1]],
            ['$limit' => 3]
        ],
        'topTags' => [
            ['$unwind' => '$tag'],
            ['$group' => ['_id' => '$tag.alias', 'total' => ['$sum' => 1]]],
            ['$sort' => ['total' => -1]],
            ['$limit' => 5]
        ],
		'topSubtitle' => [
            ['$group' => ['_id' => '$subtitle', 'total' => ['$sum' => 1]]],
            ['$sort' => ['total' => -1]],
            ['$limit' => 5]
        ]
    ]
];
$options['limit'] = 5;
$options['sort'] = ['created_at' => -1];
$resUserHistory = $mongodb->aggregate($collection, $query, $options);

$topSections   = [];
$topCategories = [];
$topTags       = [];
$topSubtitle   = [];

if(count($resUserHistory) > 0){
	$dataUserHistory = $resUserHistory[0];
	
	if (isset($dataUserHistory->topSections)) {
        foreach ($dataUserHistory->topSections as $row) {
            $topSections[] = [
                'name'  => $row->_id,
                'total' => $row->total
            ];
        }
    }
	
    if (isset($dataUserHistory->topCategories)) {
        foreach ($dataUserHistory->topCategories as $row) {
            if(!empty($row->_id)){
				$topCategories[] = [
					'name'  => $row->_id,
					'total' => $row->total
				];
			}
        }
    }

    if (isset($dataUserHistory->topTags)) {
        foreach ($dataUserHistory->topTags as $row) {
            $topTags[] = [
                'name'  => $row->_id,
                'total' => $row->total
            ];
        }
    }
	
	if (isset($dataUserHistory->topSubtitle)) {
        foreach ($dataUserHistory->topSubtitle as $row) {
            if(!empty($row->_id)){
				$topSubtitle[] = [
					'name'  => $row->_id,
					'total' => $row->total
				];
			}
        }
    }
}

echo "Rekomendasi : <br>";
echo "<pre>";
print_r([
    'sections'   => $topSections,
    'categories' => $topCategories,
    'tags'       => $topTags,
    'subtitle'   => $topSubtitle
]);
echo "</pre>";

$mongodb->close();
unset($mongodb);

echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";
?>