if($response != false){	
	$dom = new DOMDocument('1.0', 'UTF-8');
	$dom->preserveWhiteSpace = false; 
	@$dom->loadHTML($response);
	$html = $dom->getElementsByTagName('div');
	
	if($html != false){
		foreach ($html as $idx => $elm) {
			if($idx == 37){
				$nodeValue  = isset($elm->nodeValue)?$elm->nodeValue:"";
				if(!empty($nodeValue)){
					$text = strip_tags($nodeValue);
					
					$arrText1 = explode('{"@context"',$text);
					$strText1 = $arrText1[0] ?? '';

					if(!empty($strText1)){
						$arrText2 = explode('contributors',$strText1);
						$strText2 = $arrText2[1] ?? '';
						
						if(!empty($strText2)){
							$arrText3 = explode('%',$strText2);
							$strText3 = $arrText3[0] ?? '';
							
							if(!empty($strText3)){
								// 1. AQI⁺ US
								preg_match('/(\d+)AQI⁺ US/', $strText3, $match_aqi);
								$aqi = $match_aqi[1] ?? '';

								// 2. Status kualitas udara
								preg_match('/AQI⁺ US(.*?)Polutan utama:/', $strText3, $match_status);
								$status = trim($match_status[1] ?? '');

								// 3–4. Polutan utama dan konsentrasinya
								preg_match('/Polutan utama:(PM\d+(?:\.\d+)?)(\d+(?:\.\d+)?)\s*µg\/m³/u', $strText3, $match_polutan);
								$polutan = $match_polutan[1] ?? '';
								$konsentrasi = $match_polutan[2] ?? '';

								// 5. Suhu (derajat)
								preg_match('/µg\/m³(\d+°)/', $strText3, $match_suhu);
								$suhu = $match_suhu[1] ?? '';
								$suhu = str_replace("°","",$suhu);

								// 6. Kecepatan angin
								preg_match('/°([0-9\.]+\s*km\/h)/', $strText3, $match_angin);
								$angin = $match_angin[1] ?? '';
								$angin = str_replace("km/h","",$angin);

								// 7. Kelembaban
								preg_match('/km\/h(\d+)/', $strText3, $match_kelembaban);
