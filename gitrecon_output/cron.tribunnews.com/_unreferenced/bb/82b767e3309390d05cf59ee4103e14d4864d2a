		<script>
		document.addEventListener('DOMContentLoaded', function () {
			// Toggle tafsir
			document.querySelectorAll('.tafsir-toggle').forEach(function (btn) {
				btn.addEventListener('click', function () {
					const index = this.dataset.index;
					const tafsir = document.getElementById('tafsir-' + index);

					if (!tafsir) return;

					if (tafsir.classList.contains('tafsir-hidden')) {
						tafsir.classList.remove('tafsir-hidden');
						this.textContent = 'Sembunyikan Tafsir';
					} else {
						tafsir.classList.add('tafsir-hidden');
						this.textContent = 'Lihat Tafsir';
					}
				});
			});

			const players = Array.from(document.querySelectorAll('.audio-player'));
			const ayahItems = Array.from(document.querySelectorAll('.ayah-item'));
			const FALLBACK_TIMEOUT = 3000; // 3 detik

			if (!players.length) {
				return;
			}

			function clearActiveAyah() {
				ayahItems.forEach(function (item) {
					item.classList.remove('active-playing');
				});
			}

			function setActiveAyah(index) {
				clearActiveAyah();

				const currentAyah = document.querySelector('.ayah-item[data-ayah-index="' + index + '"]');

				if (currentAyah) {
					currentAyah.classList.add('active-playing');
					currentAyah.scrollIntoView({
						behavior: 'smooth',
						block: 'center'
					});
				}
			}

			function stopOtherPlayers(activeIndex) {
				players.forEach(function (otherPlayer, otherIndex) {
					if (otherIndex !== activeIndex) {
						clearPlayerTimeout(otherPlayer);
						otherPlayer.pause();
						otherPlayer.currentTime = 0;
						otherPlayer.dataset.shouldPlay = 'false';
					}
				});
			}

			function clearPlayerTimeout(player) {
				if (player._fallbackTimer) {
					clearTimeout(player._fallbackTimer);
					player._fallbackTimer = null;
				}
			}

			function playPlayer(player) {
				if (!player) return;

				player.dataset.shouldPlay = 'true';

				const playPromise = player.play();
				if (playPromise && typeof playPromise.catch === 'function') {
					playPromise.catch(function (err) {
						console.log('Play gagal atau diblokir browser:', err);
					});
				}
			}

			function startFallbackTimeout(player) {
				clearPlayerTimeout(player);

				// cuma pasang timeout jika masih source utama
				if (player.dataset.fallbackUsed === 'true') {
					return;
				}

				player._fallbackTimer = setTimeout(function () {
					const shouldPlay = player.dataset.shouldPlay === 'true';

					// kalau user sudah tidak ingin play, abaikan
					if (!shouldPlay) {
						return;
					}

					// kalau audio belum siap diputar setelah 5 detik, pindah fallback
					const ready = player.readyState >= 3; // HAVE_FUTURE_DATA
					if (!ready && !player.paused) {
						switchToFallbackAndPlay(player);
					} else if (!ready && shouldPlay) {
						switchToFallbackAndPlay(player);
					}
				}, FALLBACK_TIMEOUT);
			}

			function switchToFallbackAndPlay(player) {
				const source = player.querySelector('source');
				if (!source) return;

				const fallback = player.dataset.fallback ? player.dataset.fallback.trim() : '';
				const fallbackUsed = player.dataset.fallbackUsed === 'true';
				const shouldPlay = player.dataset.shouldPlay === 'true';
				const currentSrc = source.getAttribute('src') || '';

				if (!fallback || fallbackUsed || currentSrc === fallback) {
					return;
				}

				clearPlayerTimeout(player);
				player.dataset.fallbackUsed = 'true';

				console.log('Audio utama gagal/lambat, pindah ke fallback:', fallback);

				source.setAttribute('src', fallback);
				player.load();

				const onCanPlayFallback = function () {
					player.removeEventListener('canplay', onCanPlayFallback);

					if (shouldPlay) {
						playPlayer(player);
					}
				};

				player.addEventListener('canplay', onCanPlayFallback);
			}

			players.forEach(function (player, index) {
				const source = player.querySelector('source');

				player.dataset.index = index;
				player.dataset.shouldPlay = 'false';
				player.dataset.fallbackUsed = 'false';

				player.addEventListener('play', function () {
					player.dataset.shouldPlay = 'true';
					stopOtherPlayers(index);
					setActiveAyah(index);
					startFallbackTimeout(player);
				});

				player.addEventListener('pause', function () {
					if (!player.ended) {
						player.dataset.shouldPlay = 'false';
						clearPlayerTimeout(player);

						const currentAyah = document.querySelector('.ayah-item[data-ayah-index="' + index + '"]');
						if (currentAyah) {
							currentAyah.classList.remove('active-playing');
						}
					}
				});

				player.addEventListener('ended', function () {
					player.dataset.shouldPlay = 'false';
					clearPlayerTimeout(player);

					const nextIndex = index + 1;

					if (players[nextIndex]) {
						setActiveAyah(nextIndex);
						playPlayer(players[nextIndex]);
					} else {
						clearActiveAyah();
					}
				});

				// kalau source sudah siap, timeout dibatalkan
				player.addEventListener('canplay', function () {
					clearPlayerTimeout(player);
				});

				player.addEventListener('playing', function () {
					clearPlayerTimeout(player);
				});

				player.addEventListener('loadeddata', function () {
					clearPlayerTimeout(player);
				});

				// handle error audio
				player.addEventListener('error', function () {
					switchToFallbackAndPlay(player);
				});

				// handle error source
				if (source) {
					source.addEventListener('error', function () {
						switchToFallbackAndPlay(player);
					});
				}

				// kalau user klik langsung play saat masih loading lama
				player.addEventListener('waiting', function () {
					const shouldPlay = player.dataset.shouldPlay === 'true';
					if (shouldPlay && player.dataset.fallbackUsed !== 'true') {
						startFallbackTimeout(player);
					}
				});

				player.addEventListener('stalled', function () {
					const shouldPlay = player.dataset.shouldPlay === 'true';
					if (shouldPlay && player.dataset.fallbackUsed !== 'true') {
						startFallbackTimeout(player);
					}
				});
			});
		});
		</script>
