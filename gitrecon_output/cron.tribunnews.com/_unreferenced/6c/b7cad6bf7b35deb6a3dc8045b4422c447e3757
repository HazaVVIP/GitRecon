/**
 * Push data ke NocoDB
 */
function push_to_lawu($response)
{
    global $config;

    if (!isset($response['data']) || empty($response['data'])) {
        echo "No data found.\n";
        return;
    }

    foreach ($response['data'] as $row) {

        $row = $row['_source'];

	 	$exists = check_nocodb_exists($row['judul'], $row['datepush']);
        if ($exists) {
            echo "SKIP: record {$row['id']} for {$row['datepush']} already exists\n";
            continue;
        }

        $payload = [
            "Origin ID"    => $row['id'] ?? "",
            "Date Push"    => $row['datepush'] ?? "",
            "Image"        => $row['image'] ?? "",
            "User Id"      => (int)($row['user_id'] ?? 0),
            "Deskripsi"    => $row['deskripsi'] ?? "",
            "Full Name"    => $row['fullname'] ?? "",
            "Judul"        => $row['judul'] ?? "",
            "Url"          => $row['url'] ?? "",
            "Content Type" => $row['content_type'] ?? ""
        ];

        $ret = send_to_nocodb($payload);

        echo "PUSH: {$row['id']} → Status: {$ret['status_code']}\n";
    }
}

/**
 * Check if record exists in NocoDB (exact timestamp with 1-second range)
 */
function check_nocodb_exists($judul, $datetime)
{
    global $config;

    $start_time = $datetime;
    $end_time   = date('Y-m-d H:i:s', strtotime($datetime . ' +1 second'));

    $where = '("Judul", eq, "'.$judul.'")~and(Date Push,gte,exactDate,'.$start_time.')';
    $where = urlencode($where);

    $url = $config->noco_url_v3. "?offset=0&limit=1&where={$where}&viewId=vw5iszst4tnm8xe8";

    $curl = curl_init();
    curl_setopt_array($curl, [
        CURLOPT_URL => $url,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_ENCODING => '',
        CURLOPT_MAXREDIRS => 10,
        CURLOPT_TIMEOUT => 0,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
        CURLOPT_CUSTOMREQUEST => 'GET',
        CURLOPT_HTTPHEADER => [
            "xc-token: {$config->noco_token}"
        ],
    ]);

    $response = curl_exec($curl);
    curl_close($curl);

    $data = json_decode($response, true);

    return $data;

    return !empty($data['data']) || !empty($data['list']);
}


/**
 * Fungsi HTTP Client POST
 */
function send_to_nocodb($data)
{
    global $config;

    $ch = curl_init($config->noco_url_v2);

    curl_setopt_array($ch, [
        CURLOPT_HTTPHEADER     => ["xc-token: {$config->noco_token}", "Content-Type: application/json"],
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => json_encode($data),
    ]);

    $response = curl_exec($ch);

    if (curl_errno($ch)) {
        $err = curl_error($ch);
        curl_close($ch);
        return ["success" => false, "error" => $err];
    }

    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    return [
        "success"     => $httpCode >= 200 && $httpCode < 300,
        "status_code" => $httpCode,
        "response"    => json_decode($response, true)
    ];
}



