function normalize($vec) {
    $norm = sqrt(array_sum(array_map(fn($x)=>$x*$x, $vec)));
    return array_map(fn($x)=>$x/$norm, $vec);
}

function autoCleanClickbait($judul) {
    $judul = preg_replace('/[^\p{L}\p{N}\s]/u', '', $judul); // hapus tanda baca

    $clickbait = [
        'fakta baru', 'fakta mengejutkan', 'mengejutkan', 'terungkap', 'bikin merinding',
        'ternyata', 'viral', 'heboh', 'sontak', 'netizen', 'wow', 'parah', 'sungguh', 'astaga',
        'lihatlah', 'simak', 'tak disangka', 'tak terduga', 'siapa sangka', 'yang mengejutkan',
        'benarkah', 'ini dia', 'inilah', 'kamu harus tahu'
    ];

    foreach ($clickbait as $kata) {
        $judul = str_replace($kata, '', $judul);
    }

    // Rapikan spasi
    $judul = preg_replace('/\s+/', ' ', $judul);
    $judul = trim($judul);

    return ucfirst($judul);
}

function ambilIntiKalimat($kalimat) {
    $kalimat = preg_replace('/[^\p{L}\p{N}\s]/u', '', $kalimat);

    $kata_kata = explode(' ', $kalimat);

    // Daftar stopwords
    $stopwords = [
        'yang','dan','di','dengan','karena','itu','saat','untuk','dari','ke',
        'pada','adalah','ini','jadi','juga','atau','kami','kita','mereka','saya',
        'aku','anda','kamu','tidak','ya','bukan','apa','mengapa','bagaimana',
        'sebagai','oleh','tentang','selama','sebelum','sesudah','hingga','sampai',
        'semua','bagi','dalam','luar','antara','bahwa','hanya','lagi','masih',
        'sudah','telah','akan','bisa','harus','dapat','pernah','lah','pun','nya',
        'oleh','setelah','tanpa','oleh','punya','kalau','meski','walaupun',
        'maupun','bahkan','namun','tetapi','melainkan','agar','supaya',
        'demi','yakni','misalnya','contohnya','terhadap','dengan','dalam',
        'buat','kepada','selain','oleh','seperti','kecuali','yaitu','yakni',
        'sejak','karena','hingga','sambil','serta','sedangkan','sebab','barangkali',
        'pastinya','mungkin','lagi','malah','justru','bahwa','adapun',
        'seseorang','sesuatu','beberapa','berbagai','setiap','semacam','semisal',
        'siapa','dimana','kapan','mengapa','berapa','semua','semuanya',
        'sendiri','sendirian','sendirinya'
    ];

    $hasil = [];
    foreach ($kata_kata as $kata) {
        // Simpan jika bukan stopword
        if (!in_array($kata, $stopwords)) {
            // Jika kata panjang > 3, atau singkatan uppercase (contoh: TNI, DPR)
            if (strlen($kata) > 3 || ctype_upper($kata)) {
                if (!in_array($kata, $hasil)) {
                    $hasil[] = $kata;
                }
            }
        }
    }

    return array_slice($hasil, 0, 5);
}

function buatRingkasanKalimat($judul) {
	$judul_bersih = autoCleanClickbait($judul);
    $kata_penting = ambilIntiKalimat($judul_bersih);

    if (empty($kata_penting)) {
        return "Tidak ditemukan inti kalimat.";
    }

    return implode(' ', $kata_penting);
}


