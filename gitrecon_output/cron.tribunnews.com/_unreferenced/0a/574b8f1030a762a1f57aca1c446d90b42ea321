<?php 
include_once DOC_ROOT."config/config_db.php";

class model_settlement{

    private $conn_db;
    public function __construct()
    {
        //get conn db
        $this->conn_db = new config_db();
    }

    //using on tjb helper library
    public function get_by_invoice_commerce($invoice) {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT com_settlement_id, invoice, id_user, id_seller_user, email_user, date_request, va_number,
				bank, biller_code, bill_key, store, payment_code, gross_amount, net_amount, shipping_amount, insurance_amount,
				payment_type, transaction_status, settlement_time, 
				lr_id, user_address_seller_id, user_address_id, tjb_status, is_insurance
				FROM com_settlement
				WHERE invoice = ".mysqli_escape_string($con,$invoice);
        $result = mysqli_query($con, $sql);	
		return $result;
	}
    //using on tjb helper library
    public function get_total_settlement_commerce_status($invoice, $tjbstatus=0) {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT count(com_settlement_status_id) as total 
				FROM com_settlement_status 
				WHERE invoice = ".mysqli_escape_string($con,$invoice)." AND tjb_status = ".mysqli_escape_string($con,$tjbstatus);
        $result = mysqli_query($con, $sql);	
		return $result;
	}
    //using on tjb helper library
    public function insert_com_settlement_status($arrInsertData)
    {
        $con = $this->conn_db->conn_to_db();
        $sql = "INSERT INTO com_settlement_status (invoice, com_settlement_id, tjb_status, com_settlement_status_created)
        VALUES ('".mysqli_escape_string($con,$arrInsertData['invoice'])."', '".mysqli_escape_string($con,$arrInsertData['com_settlement_id'])."', '".mysqli_escape_string($con,$arrInsertData['tjb_status'])."', '".mysqli_escape_string($con,$arrInsertData['com_settlement_status_created'])."')";
        $result = mysqli_query($con, $sql);	
        $last_id = mysqli_insert_id($con);
        return $last_id;
    }

    //using on cron finish order buyer
    function get_com_settlement_finish_order_buyer() {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT a.com_settlement_id, a.invoice, a.id_user, a.id_seller_user,
				b.com_settlement_status_created
				FROM com_settlement a
				LEFT JOIN com_settlement_status b ON a.com_settlement_id = b.com_settlement_id 
				WHERE a.tjb_status = 4 AND a.is_request_refund = 0 AND b.tjb_status = 4		
				ORDER BY a.com_settlement_id ASC LIMIT 25";
        $result = mysqli_query($con, $sql);	
		return $result;
	}

    //using on cron finish order buyer
    function get_com_settlement_finish_order_buyer_by_id($lastid) {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT a.com_settlement_id, a.invoice, a.id_user, a.id_seller_user,
				b.com_settlement_status_created
				FROM com_settlement a
				LEFT JOIN com_settlement_status b ON a.com_settlement_id = b.com_settlement_id 
				WHERE a.tjb_status = 4 AND a.is_request_refund = 0 AND b.tjb_status = 4 AND a.com_settlement_id > ".$lastid."			
				ORDER BY a.com_settlement_id ASC
				LIMIT 25";
        $result = mysqli_query($con, $sql);	
        return $result;
	}

    //using on cron failed order seller
    public function get_com_settlement_confirm_order_seller() {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT a.com_settlement_id, a.invoice, a.settlement_time, a.date_request, a.id_user, a.name_user, a.email_user, a.phone_user, a.id_seller_user,
			b.store_name, b.store_name_alias, b.username, a.tjb_status, a.payment_type, a.transaction_status,
			c.shipper_order_id
			FROM com_settlement a
			LEFT JOIN user_profile b ON a.id_user = b.user_id 
			LEFT JOIN com_shipper c ON a.com_settlement_id = c.com_settlement_id 
			WHERE a.tjb_status = 1
			ORDER BY a.settlement_time ASC
			LIMIT 10";

        $result = mysqli_query($con, $sql);	
		return $result;
	}
    //using on cron failed order seller
    public function get_com_settlement_confirm_order_seller_by_id($lastid) {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT a.com_settlement_id, a.invoice, a.settlement_time, a.date_request, a.id_user, a.name_user, a.email_user, a.phone_user, a.id_seller_user,
            b.store_name, b.store_name_alias, b.username, a.tjb_status, a.payment_type, a.transaction_status,
            c.shipper_order_id
            FROM com_settlement a
            LEFT JOIN user_profile b ON a.id_user = b.user_id 
            LEFT JOIN com_shipper c ON a.com_settlement_id = c.com_settlement_id 
            WHERE a.tjb_status = 1 AND a.com_settlement_id > ".$lastid."			
            ORDER BY a.com_settlement_id ASC
            LIMIT 10";

        $result = mysqli_query($con, $sql);	
        return $result;
	}
    // using on cron failed order seller
    function get_details_by_com_settlement($settlementid) {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT a.com_settlement_detail_id, a.product_id, a.quantity,
				b.id, b.title, b.price, b.image, b.date_created 
				FROM com_settlement_detail  a
				LEFT JOIN post b ON a.product_id = b.id
				WHERE com_settlement_id = ".mysqli_escape_string($con,$settlementid);
        $result = mysqli_query($con, $sql);	
        return $result;
	}
    // using on cron failed order seller
    function update_com_settlement_by_id($com_settlement_id, $arrUpdate){
        $con = $this->conn_db->conn_to_db();
        $tjbStatus = $arrUpdate['tjb_status'];
        $date_modify = $arrUpdate['date_modify'];
		$sql ="UPDATE com_settlement SET tjb_status = ".$tjbStatus.", date_modify = ".$date_modify." WHERE com_settlement_id =".mysqli_escape_string($con,$com_settlement_id);		
        $result = mysqli_query($con, $sql);	

        if ($result === TRUE) {
            return TRUE;
          } else {
            return FALSE;
          }
	}
    // using on cron failed order seller
    public function insert_com_settlement_rejected($arrInsertData)
    {
        $con = $this->conn_db->conn_to_db();
        $sql = "INSERT INTO com_settlement_rejected (com_settlement_id, reason_id, post_rejected_created)
        VALUES ('".mysqli_escape_string($con,$arrInsertData['com_settlement_id'])."', '".mysqli_escape_string($con,$arrInsertData['reason_id'])."', '".mysqli_escape_string($con,$arrInsertData['post_rejected_created'])."')";
        $result = mysqli_query($con, $sql);	
        $last_id = mysqli_insert_id($con);
        return $last_id;
    }
}
