<?php
ini_set('display_errors',1);
error_reporting(E_ALL);
//error_reporting(0);

use \MongoDB\BSON\UTCDateTime;

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require_once "./../../vendor/autoload.php";
include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Mongodb.php";
include DOC_ROOT."lib/Opensearch.php";

$date = isset($_GET['date'])?$_GET['date']:"";

if(!empty($date)){
	$dateStart = $date;
} else {	
	$dateStart = date("Y-m-d", strtotime('-1 days'));
}


//MONGODB
$mongodb = new Mongodb();
$mongodb->connect(MONGODB_USER_HOST_DEV,MONGODB_USER_USERNAME_DEV,MONGODB_USER_PASSWORD_DEV,"tribunnews",true);


$collection = "users_history";
$dateHistory = date("Ymd", strtotime($dateStart));

$query = [
			"dt" => ['$lt' => intval($dateHistory)]
		];
$totalUserHistory = $mongodb->total($collection,$query);

if($totalUserHistory > 0){
	$deleteUserHistory = $mongodb->deleteMany($collection,$query);
}

$mongodb->close();
unset($mongodb);


echo 'Total Deleted : '.$totalUserHistory."<br>\n";
echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";
?>