		$opensearchTBO->init(OS_TBO_NEW_URL,OS_TBO_NEW_USERNAME,OS_TBO_NEW_PASSWORD,true);
		
		$opensearchWIKI = new Opensearch();
		$opensearchWIKI->init(OS_TNEWSWIKI_URL,OS_TNEWSWIKI_USERNAME,OS_TNEWSWIKI_PASSWORD,true);
		
		
		foreach($dataArticle as $article){
			$row = $article['_source'];
			
			$id = isset($row['id'])?intval($row['id']):0;
			$domain = isset($row['domain'])?$row['domain']:"";
			$alias = isset($row['alias'])?$row['alias']:"";
			
			if($id > 0){
				if($domain == "www"){
					$fields = array("id","title","alias","publish_date","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
					$query = array("match_phrase" => array("alias" => $alias));
					$response4 = $opensearchTnews->findOne("tribunnews-articles", $query, $fields);	
				} else if($domain == "video"){
					$fields = array("id","title","alias", "topic", "category", "poster", "file", "upload_date", "editor_video", "editor_video_name", "uploader", "uploader_name", "reporter", "cameraman");
					$query = array("match_phrase" => array("alias" => $alias));
					$response4 = $opensearchTnews->findOne("tribunnews-video", $query, $fields);
				} else {
					if(in_array($domain, LIST_COMMERCE_CLUSTER)){
						$fields = array("id","title","alias","publish_date","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
						$query = array("match_phrase" => array("alias" => $alias));
						$response4 = $opensearchCommerce->findOne($domain.".articles", $query, $fields);	
					} else if(in_array($domain, LIST_TBO_CLUSTER)){
						$fields = array("id","title","alias","publish_date","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
						$query = array("match_phrase" => array("alias" => $alias));
						$response4 = $opensearchTBO->findOne($domain.".articles", $query, $fields);	
					} else if($domain == "tribunnewswiki"){
						$fields = array("id","title","alias","publish_date","written_by","writter_fullname","editor_by","editor_fullname","wikiblog");
						$query = array("match_phrase" => array("alias" => $alias));
						$response4 = $opensearchWIKI->findOne("tribunnewswiki-articles", $query, $fields);	
					} else if(in_array($domain, LIST_DAERAH_NEW)){
						$fields = array("id","title","alias","publish_date","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
						$query = array("match_phrase" => array("alias" => $alias));
						$response4 = $opensearchDaerahNew->findOne($domain.".tribundaerah-articles", $query, $fields);
					} else if(in_array($domain, LIST_DAERAH_CLUSTER)){
						$fields = array("id","title","alias","publish_date","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
						$query = array("match_phrase" => array("alias" => $alias));
						$response4 = $opensearchDaerahCluster->findOne($domain.".tribundaerah-articles", $query, $fields);
					} else { 
						$fields = array("id","title","alias","publish_date","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
						$query = array("match_phrase" => array("alias" => $alias));
						$response4 = $opensearchDaerah->findOne($domain.".tribundaerah-articles", $query, $fields);	
					}
				}
				
				if($response4['status']){
					$rows = isset($response4['data']['_source'])?json_decode(json_encode($response4['data']['_source'])):array();
					
					$title = isset($rows->title)?$rows->title:"";
					$publish_date = isset($rows->publish_date)?$rows->publish_date:"";
					$id_article = isset($rows->id)?intval($rows->id):0;
					
					$writter_id = isset($rows->written_by)?intval($rows->written_by):0;
					$writter = isset($rows->written_by)?intval($rows->written_by):0;
					$writter_username = isset($rows->writter_username)?$rows->writter_username:"";
					$writter_fullname = isset($rows->writter_fullname)?$rows->writter_fullname:"";
					
					$editor_id = isset($rows->editor_by)?intval($rows->editor_by):0;
					$editor = isset($rows->editor_by)?intval($rows->editor_by):0;
					$editor_username = isset($rows->editor_username)?$rows->editor_username:"";
					if(empty($editor_username)){
						$editor_username = isset($rows->editor)?$rows->editor:"";
					}
					$editor_fullname = isset($rows->editor_fullname)?$rows->editor_fullname:"";
					
					if($domain == "video"){
						$alias 				= "view/".$id."/".$alias;
					}
					
					if(!empty($id_article)){
						$dataUpdate = array();
						$dataUpdate['id_article'] = $id_article;
						$dataUpdate['title'] = strip_tags($title);
						$dataUpdate['publish_date'] = $publish_date;
						$dataUpdate['editor_id'] = $editor_id;
						$dataUpdate['editor_username'] = $editor_username;
						$dataUpdate['editor_fullname'] = $editor_fullname;
						$dataUpdate['writter_id'] = $writter_id;
						$dataUpdate['writter_username'] = $writter_username;
						$dataUpdate['writter_fullname'] = $writter_fullname;
						$dataUpdate['status'] = 1;
						if($domain == "tribunnewswiki"){
							$wikiblog = isset($rows->wikiblog)?intval($rows->wikiblog):0;
							$dataUpdate['wikiblog'] = $wikiblog;
						}
						
						$responseUpdate = $opensearch->updateOne($index_name,$id,$dataUpdate);
						
						/* echo "<pre>";
						print_r($responseUpdate);
						print_r($dataUpdate);
						echo "</pre>"; */
					
						if($responseUpdate['status']){
							$totalData++;
						}
