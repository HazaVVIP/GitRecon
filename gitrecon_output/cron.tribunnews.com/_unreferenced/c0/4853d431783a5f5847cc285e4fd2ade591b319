<?php
/* ini_set('display_errors',1);
error_reporting(E_ALL); */
error_reporting(0);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

/* 
Running in command
- sudo -u cron /usr/bin/php7.4 /var/www/html/web-cron/daerah/daerah_cluster_sync_rds_os.php depok
*/

include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Opensearch.php";

$daerah = isset($_SERVER["argv"][1])?$_SERVER["argv"][1]:"";
if(isset($_GET['daerah'])){
	$daerah = $_GET['daerah'];
}
$date = isset($_SERVER["argv"][2])?$_SERVER["argv"][2]:"";
if(isset($_GET['date'])){
	$date = $_GET['date'];
}

if(!empty($daerah)){
	if(!empty($date)){
		$dateStart = $date;
		$dateEnd = $date;
	} else {	
		$dateStart = date("Y-m-d", strtotime('-1 days'));
		$dateEnd = date("Y-m-d", strtotime('-1 days'));
	}

	echo $daerah."<br>";
	echo $dateStart." - ".$dateEnd."<br>";
	
	$dateStart = $dateStart.' 00:00:00';
	$dateEnd = $dateEnd.' 23:59:59';
		
	//OS
	$fields = array('domain_id');
	$sort = array("publish_date" => "asc");
	$start = 0;
	$limit = 1000;
	
	$where = array();
	array_push($where,array("match_phrase" => array("domain" => $daerah)));
	array_push($where,array("range" => array("publish_date" => array("gte" => $dateStart, "lte" =>$dateEnd))));

	$condition = array("bool" =>
						array(
							"must" => $where,
						)
			);
	
	$opensearchAllNetwork = new Opensearch();
	$opensearchAllNetwork->init(OS_ALLNETWOORK_URL,OS_ALLNETWOORK_USERNAME,OS_ALLNETWOORK_PASSWORD,true);
	$response_osallnetwork = $opensearchAllNetwork->find('allnetwork-articles',$condition,$fields,$sort,$start,$limit);
	$totalOsNetwork = 0;
	$arrIDOsNetwork = array();
	if($response_osallnetwork['status']){
		$totalOsNetwork = isset($response_osallnetwork['total_row'])?$response_osallnetwork['total_row']:0;
		$dataOsNetwork = isset($response_osallnetwork['data'])?$response_osallnetwork['data']:array();
		
		if(count($dataOsNetwork) > 0){
			foreach($dataOsNetwork as $rowosnetwork){
				array_push($arrIDOsNetwork, intval($rowosnetwork['_source']['domain_id']));
			}
		}
	}

	echo "Total OS Network : ".$totalOsNetwork."<br>";
	
	////
	
	$fields = array('id');
	$sort = array("publish_date" => "asc");
	$start = 0;
	$limit = 1000;
	$where = array();
	array_push($where,array("range" => array("publish_date" => array("gte" => $dateStart, "lte" =>$dateEnd))));

	$condition = array("bool" =>
						array(
							"must" => $where,
						)
			);
	
	$opensearch = new Opensearch();
	$index = $daerah.".tribundaerah-articles";
	$opensearch->init(OS_DAERAH_CLUSTER_URL,OS_DAERAH_CLUSTER_USERNAME,OS_DAERAH_CLUSTER_PASSWORD,true);
	$response_os = $opensearch->find($index,$condition,$fields,$sort,$start,$limit);
	$totalOs = 0;
	$arrIDOs = array();
	if($response_os['status']){
		$totalOs = isset($response_os['total_row'])?$response_os['total_row']:0;
		$dataOs = isset($response_os['data'])?$response_os['data']:array();
		
		if(count($dataOs) > 0){
			foreach($dataOs as $rowos){
				array_push($arrIDOs, intval($rowos['_source']['id']));
			}
		}
	}

	echo "Total OS : ".$totalOs."<br>";
	
	
	//RDS
	$con = mysqli_connect(RDS_DAERAH_NEW_HOST,RDS_DAERAH_NEW_USERNAME,RDS_DAERAH_NEW_PASSWORD,$daerah);
	if (mysqli_connect_errno()) {
		echo "Failed to connect to MySQL: " . mysqli_connect_error();
		exit();
	}

	$arrID = array();
	$arrID = array_diff($arrIDOs, $arrIDOsNetwork);
	$totalSyncOs = 0;

	echo "<pre>";
	print_r($arrID);
	echo "</pre>";
	
	
	echo "Total SYNC OS ke OS Network : ".$totalSyncOs."<br>";
	
	mysqli_close($con);
	unset($opensearch);
	unset($opensearchAllNetwork);
}	

echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";
?>