ment('1.0', 'UTF-8');	$dom->preserveWhiteSpace = false; 	@$dom->loadHTML($response);	$tables = $dom->getElementsByTagName('table');			$opensearchTBO = new Opensearch();	$opensearchTBO->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);		$no = 1;	$totalUpdate = 0;	$index = "klasemen_liga_".$liga;		foreach ($tables as $idx => $table) {		$rows = $table->getElementsByTagName('tr');				foreach ($rows as $ixx => $row) {			$cols = $row->getElementsByTagName('td');						$urutan = @$cols[0]->textContent;			$klub = @$cols[1]->textContent;			$score_D = @$cols[2]->textContent;			$score_M = @$cols[3]->textContent;			$score_S = @$cols[4]->textContent;			$score_K = @$cols[5]->textContent;			$score_GM = @$cols[6]->textContent;			$score_GK = @$cols[7]->textContent;			$score_min_plus = @$cols[8]->textContent;			$score_P = @$cols[9]->textContent;			$lima_hasil_terakhir = "[]";						if(!empty($urutan) && !empty($klub)){				$urutan = intval(trim($urutan));				$klub = trim($klub);				$score_D = intval(trim($score_D));				$score_M = intval(trim($score_M));				$score_S = intval(trim($score_S));				$score_K = intval(trim($score_K));				$score_GM = intval(trim($score_GM));				$score_GK = intval(trim($score_GK));				$score_min_plus = trim($score_min_plus);				$score_P = intval(trim($score_P));								if ($klub == '1. FC Heidenheim 1846') $klub = 'Heidenheim';				if ($klub == '1. FC Union Berlin') $klub = 'Union Berlin';				if ($klub == 'FC Augsburg') $klub = 'Augsburg';				if ($klub == "M'gladbach") $klub = 'Monchengladbach';				if ($klub == "Manchester City") $klub = 'Man. City';				if ($klub == "Brighton and Hove Albion") $klub = 'Brighton';				if ($klub == "Newcastle United") $klub = 'Newcastle';				if ($klub == "Tottenham Hotspur") $klub = 'Tottenham';				if ($klub == "Nottingham Forest") $klub = 'Nottm Forest';				if ($klub == "West Ham United") $klub = 'West Ham';				if ($klub == "Wolverhampton Wanderers") $klub = 'Wolves';						