function removeHarakat(string $text): string
{
    $patterns = [
        '/[\x{064B}-\x{065F}]/u', // fathatan..kasra..sukun..shadda dll
        '/\x{0670}/u',            // superscript alef
        '/[\x{06D6}-\x{06ED}]/u', // tanda quranic annotation
        '/\x{0640}/u',            // tatweel
    ];

    $clean = preg_replace($patterns, '', $text);
    return is_string($clean) ? $clean : $text;
}

function normalizeArabic(string $text): string
{
    $map = [
        'ٱ' => 'ا',
        'أ' => 'ا',
        'إ' => 'ا',
        'آ' => 'ا',
        'ى' => 'ي',
        'ؤ' => 'و',
        'ئ' => 'ي',
        'ة' => 'ه',
    ];

    return strtr($text, $map);
}
