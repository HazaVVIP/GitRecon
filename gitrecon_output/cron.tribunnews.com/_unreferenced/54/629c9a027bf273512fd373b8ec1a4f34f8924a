if($response != false){
	$dom = new DOMDocument('1.0', 'UTF-8');
	$dom->preserveWhiteSpace = false; 
	@$dom->loadHTML($response);
	$tables = $dom->getElementsByTagName('table');	
	
	if($tables != false){
		$index = "widget_idx";
		$tanggal_idx = date("Y-m-d");
		
		$opensearchTBO = new Opensearch();
		$opensearchTBO->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);

		foreach ($tables as $idx => $table) {
			$rows = $table->getElementsByTagName('tr');
			
			foreach ($rows as $row) {
				$cols = $row->getElementsByTagName('td');

				if(count($cols) > 0 && $cols->length == 4){
					$name = isset($cols[0]->textContent)?trim($cols[0]->textContent):"";
					$last = isset($cols[1]->textContent)?floatval($cols[1]->textContent):0;
					$chg = isset($cols[2]->textContent)?floatval($cols[2]->textContent):0;
					$cgh_prnct = isset($cols[3]->textContent)?floatval($cols[3]->textContent):0;

					if(!empty($name) && !empty($last) && !empty($chg) && !empty($cgh_prnct)){
						$id = md5($tanggal_idx . $name);
						
						echo $id." | ".$name." | ".$last." | ".$chg." | ".$cgh_prnct."<br>";
						
						$condition = array("match_phrase" => array("name" => $name));
						$fields = array("id","name","last","chg","cgh_prnct");
						$response = $opensearchTBO->findOne($index,$condition,$fields);
						
						if($response['status']){
							$id = isset($response['data']['_source']['id'])?intval($response['data']['_source']['id']):0;
							$cgh_prnct_bfr = isset($response['data']['_source']['cgh_prnct'])?$response['data']['_source']['cgh_prnct']:0;
							echo "update<br>";
							
							$arrUpdate = array();
							$arrUpdate['name'] = $name;
							$arrUpdate['last'] = $last;
							$arrUpdate['chg'] = $chg;
							$arrUpdate['cgh_prnct'] = $cgh_prnct;
							//$arrUpdate['cgh_prnct_bfr'] = $cgh_prnct_bfr;
							$arrUpdate['tanggal_dt'] = $tanggal_idx;
							$arrUpdate['tanggal_fetch'] = date('Y-m-d H:i:00');
							
							$responseUpdate = $opensearchTBO->updateOne($index, $id, $arrUpdate);
						
							echo "<pre>";
							print_r($arrUpdate);
							print_r($responseUpdate);
							echo "</pre>";
							
							if($responseUpdate['status']){
								$totalInsert++;
							}
						} else {
							echo "insert<br>";
							
							$arrInsert = array();
							$arrInsert['id'] = $id;
							$arrInsert['name'] = $name;
							$arrInsert['last'] = $last;
							$arrInsert['chg'] = $chg;
							$arrInsert['cgh_prnct'] = $cgh_prnct;
							$arrInsert['tanggal_dt'] = $tanggal_idx;
							$arrInsert['tanggal_fetch'] = date('Y-m-d H:i:00');
							
							$responseInsert = $opensearchTBO->insert($index, $arrInsert);
						
							echo "<pre>";
							print_r($arrInsert);
							print_r($responseInsert);
							echo "</pre>";
							
							if($responseInsert['status']){
								$totalUpdate++;
							}
						}
					}
				}
			}
		}
		
		unset($opensearchTBO);
	} 
}

