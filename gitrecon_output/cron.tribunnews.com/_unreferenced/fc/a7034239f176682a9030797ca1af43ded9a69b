function url_title($str, $separator = '-', $lowercase = FALSE)
{
    if ($separator === 'dash')
    {
        $separator = '-';
    }
    elseif ($separator === 'underscore')
    {
        $separator = '_';
    }

    $q_separator = preg_quote($separator, '#');

    $trans = array(
        '&.+?;'            => '', 
        '[^\w\d _-]'       => '', 
        '\s+'              => $separator, 
        '('.$q_separator.')+' => $separator  
    );

    $str = strip_tags($str);

    foreach ($trans as $key => $val)
    {
        $str = preg_replace('#'.$key.'#i', $val, $str);
    }

    if ($lowercase === TRUE)
    {
        $str = strtolower($str);
    }

    return trim(trim($str, $separator));
}

function get_description($description)
{
    $result = "";
    $startPos = strpos($description, "TRIBUN-VIDEO.COM -");

    if ($startPos !== false) 
    {
        $startPos += strlen("TRIBUN-VIDEO.COM - ");
        $result = substr($description, $startPos);
        
        $endPos = strpos($result, "\n\n");
        if ($endPos !== false) 
        {
            $result = substr($result, 0, $endPos);
        }
        return $result;
    } 
    else 
    {
        return $result;
    }
}

function get_description_new($description)
{
    $result = "";
	if(!empty($description)){
		$startPos = strpos($description, "TRIBUN-VIDEO.COM -");

		if ($startPos !== false) 
		{
			$startPos += strlen("TRIBUN-VIDEO.COM - ");
			$result = substr($description, $startPos);
			$result = preg_replace("/[\r\n]/","<p>",$result);
			$result = "<p><strong>TRIBUN-VIDEO.COM</strong> - ".$result;
			$result = str_replace("<p><p>","</p><p>",$result);
			return $result;
		} 
		else 
		{
			return $result;
		}
	} else {
		return $result;
	}
}

function get_tag_string($description) {
	$keywords = "";
	
	/* Match hashtags */
	preg_match_all('/#(\w+)/', $description, $matches);

	/* Add all matches to array */
	foreach ($matches[1] as $match) {
		$keywords .= $match . ', ';
	}
	
	if(!empty($keywords)){
		$keywords = rtrim(trim($keywords), ',');
		$keywords = substr($keywords, 0, -1); 
	}	

	return $keywords;
}

function extract_tag($tags)
{
    $tagsString = implode(", ", $tags);
    return $tagsString;
}

function get_program($string)
{
    $program = ""; 
	$programPos = strpos($string, "Program:");

    if ($programPos !== false) {
        $parts = explode("Program:", $string);

        $program = trim($parts[1]);

        $program = explode("\n", $program)[0];
        $program = trim($program);
    }
	return $program;
}

function get_editor($string)
{
    $editor = "";
    $editorPos = strpos($string, "Editor Video:");

    if ($editorPos !== false) {
        $parts = explode("Editor Video:", $string);

        $editor = trim($parts[1]);

        $editor = explode("\n", $editor)[0];
        $editor = trim($editor);
    } 
	
	return $editor;
}

