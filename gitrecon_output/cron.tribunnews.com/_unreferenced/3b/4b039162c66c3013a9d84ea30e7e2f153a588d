responseUpdate);				echo "</pre>"; */								if($responseUpdate['status']){					$totalUpdate++;				} 			} else {				$filenameklub = strtolower($klub);				$filenameklub = str_replace(array(" ","."),"-",$filenameklub);				$image_klub_link = "https://asset-1.tribunnews.com/img/klubimageasset/uefaclub/".$filenameklub.".png";								$arrInsert = array();				$arrInsert['id'] = $idx;				$arrInsert['klub'] = $klub;				$arrInsert['urutan'] = intval($idx);				$arrInsert['group'] = "";				$arrInsert['image_klub_link'] = $image_klub_link;				$arrInsert['score_D'] = $score_D;				$arrInsert['score_M'] = $score_M;				$arrInsert['score_S'] = $score_S;				$arrInsert['score_K'] = $score_K;				$arrInsert['score_GM'] = $score_GM;				$arrInsert['score_GK'] = $score_GK;				$arrInsert['score_min_plus'] = $score_min_plus;				$arrInsert['score_P'] = $score_P;				$arrInsert['lima_hasil_terakhir'] = $lima_hasil_terakhir;								$responseInsert = $opensearchTBO->insert($index, $arrInsert);								$idx++;								/* echo "<pre>";				print_r($arrInsert);				print_r($responseInsert);				echo "</pre>"; */								if($responseInsert['status']){					$totalInsert++;				}			}		}	}		unset($opensearchTBO);		echo "Total Insert Europa = ".$totalInsert."<br>\n";	echo "Total Update Europa = ".$totalUpdate."<br>\n";}	echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";$opts = array(		  'http'=>array(			'method'=>"GET",			'header'=>"Accept-language: en\r\n" .					  "User-Agent: Mozilla/5.0 AppleWebKit/537.36 (KHTML, like Gecko; compatible; Tribunbot/1.0; +http://tribunnews.com/bot.html) Chrome/W.X.Y.Z Safari/537.36\r\n",			'timeout' => 3		  ),		  'ssl'  => array (			'verify_peer'      => false,			'verify_peer_name' => false,		  )		);$context = stream_context_create($opts);file_get_contents('https://api.tribunnews.com/tcache/update_custom_memcache/dataKlasemenBolaFull'.$liga, false, $context);file_get_contents('https://ap