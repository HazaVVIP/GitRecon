<?php 
include_once "/var/www/html/web-cron/config/config_db_booking.php";

class model_transaction{

    private $conn_db;
    public function __construct()
    {
        //get conn db
        $this->conn_db = new config_db_booking();
    }

    public function get_invoice_expired($dateNow) {
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT id,id_event,id_ticket,jumlah_ticket,kode_invoice,status_paid,transaction_status,custom_field,tgl_transaksi,tgl_expire FROM tbl_transaksi 
        WHERE custom_field != '' AND tgl_expire < '$dateNow' AND status_paid='pending' AND transaction_status='1' LIMIT 20";
        $result = mysqli_query($con, $sql);	
		return $result;
	}

    public function getStockTicket($id){
        $con = $this->conn_db->conn_to_db();
		$sql = "SELECT stock from ticket where id=$id";
		$result = mysqli_query($con, $sql);	
		return $result;
	}
}
?>