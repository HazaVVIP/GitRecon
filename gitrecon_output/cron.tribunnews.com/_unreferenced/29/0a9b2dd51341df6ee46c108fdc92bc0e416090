<?php
date_default_timezone_set('Asia/Jakarta');
set_time_limit(0);
ini_set('display_errors', 1);
error_reporting(E_ALL);

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT . "config/config.php";
include DOC_ROOT . "lib/Utils.php";
include DOC_ROOT . "lib/Opensearch.php";

$opensearchDev = new Opensearch();
$opensearchDev->init(OS_DEV_URL, OS_DEV_USERNAME, OS_DEV_PASSWORD, true);

$opensearchTBO = new Opensearch();
$opensearchTBO->init(OS_TBO_URL, OS_TBO_USERNAME, OS_TBO_PASSWORD, true);

$aggs = array(
    'list_juz' => array(
        'terms' => array(
            'field' => 'juz',
            'size'  => 50,
            'order' => array('_key' => 'asc')
        ),
        'aggs' => array(
            'first_ayah' => array(
                'top_hits' => array(
                    'size' => 1,
                    '_source' => array(
                        'includes' => array(
                            'juz',
                            'chapter_id',
                            'chapter_name_latin_id',
                            'chapter_translation_id',
                            'surah_name',
                            'verse_key',
                            'ayah_text',
                            'ayah_translation_id'
                        )
                    ),
                    'sort' => array(
                        array('ayah_id' => array('order' => 'asc'))
                    )
                )
            ),
            'last_ayah' => array(
                'top_hits' => array(
                    'size' => 1,
                    '_source' => array(
                        'includes' => array(
                            'juz',
                            'chapter_id',
                            'chapter_name_latin_id',
                            'chapter_translation_id',
                            'surah_name',
                            'verse_key',
                            'ayah_text',
                            'ayah_translation_id'
                        )
                    ),
                    'sort' => array(
                        array('ayah_id' => array('order' => 'desc'))
                    )
                )
            )
        )
    )
);

$response = $opensearchTBO->aggregations('quran', $aggs);

$juzList = array();
$errorMessage = '';

if (isset($response['status']) && $response['status'] == 1 && isset($response['data']['list_juz']['buckets'])) {
    foreach ($response['data']['list_juz']['buckets'] as $bucket) {
        $firstSource = isset($bucket['first_ayah']['hits']['hits'][0]['_source'])
            ? $bucket['first_ayah']['hits']['hits'][0]['_source']
            : array();

        $lastSource = isset($bucket['last_ayah']['hits']['hits'][0]['_source'])
            ? $bucket['last_ayah']['hits']['hits'][0]['_source']
            : array();

        $juzList[] = array(
            'juz' => isset($bucket['key']) ? $bucket['key'] : '',
            'total_doc' => isset($bucket['doc_count']) ? $bucket['doc_count'] : 0,

            'first_chapter_id' => isset($firstSource['chapter_id']) ? $firstSource['chapter_id'] : '',
            'first_chapter_name_latin_id' => isset($firstSource['chapter_name_latin_id']) ? $firstSource['chapter_name_latin_id'] : '',
            'first_chapter_translation_id' => isset($firstSource['chapter_translation_id']) ? $firstSource['chapter_translation_id'] : '',
            'first_verse_key' => isset($firstSource['verse_key']) ? $firstSource['verse_key'] : '',

            'last_chapter_id' => isset($lastSource['chapter_id']) ? $lastSource['chapter_id'] : '',
            'last_chapter_name_latin_id' => isset($lastSource['chapter_name_latin_id']) ? $lastSource['chapter_name_latin_id'] : '',
            'last_chapter_translation_id' => isset($lastSource['chapter_translation_id']) ? $lastSource['chapter_translation_id'] : '',
            'last_verse_key' => isset($lastSource['verse_key']) ? $lastSource['verse_key'] : ''
        );
    }
} else {
    $errorMessage = isset($response['error_reason']) ? $response['error_reason'] : 'Data juz tidak ditemukan';
}

unset($opensearchDev);
unset($opensearchTBO);
?>
