$site = isset($_SERVER["argv"][1])?$_SERVER["argv"][1]:"";
if(isset($_GET['site'])){
	$site = $_GET['site'];
}	

$google_analytic = new Google_analytic(AUTH_CREDENTIAL_PROD);

$applicationName = "Tribun All Network Top Article";
$viewId = "90636734"; //tribunnews all network
$google_analytic->initializeAnalytics($applicationName,$viewId);
$analytics = $google_analytic->getReportTopArticle($site);

$dataPopuler = array();
$total = 0;
if($analytics['status']){
	$dataPopuler = $google_analytic->getResultTopArticle($analytics);
	
	if(count($dataPopuler) > 0){
		$opensearchTest = new Opensearch();
		$opensearchTest->init(ES_TEST_URL,"","",false);
		
		$opensearch = new Opensearch();
		$opensearch->init(OS_URL,OS_USERNAME,OS_PASSWORD,true);
		
		$opensearchDaerah = new Opensearch();
		$opensearchDaerah->init(OS_DAERAH_URL,OS_DAERAH_USERNAME,OS_DAERAH_PASSWORD,true);
		
		$opensearchDaerahCluster = new Opensearch();
		$opensearchDaerahCluster->init(OS_DAERAH_CLUSTER_URL,OS_DAERAH_CLUSTER_USERNAME,OS_DAERAH_CLUSTER_PASSWORD,true);
		
		$opensearchTBO = new Opensearch();
		$opensearchTBO->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);
		
		$opensearchWIKI = new Opensearch();
		$opensearchWIKI->init(OS_TNEWSWIKI_URL,OS_TNEWSWIKI_USERNAME,OS_TNEWSWIKI_PASSWORD,true);
		
		foreach($dataPopuler as $row){
			$id = intval($row['id']);
			$domain = $row['site'];
			$title = strip_tags(trim($row['title']));
			$title = trim(str_replace(" -  Halaman all","",$title));
			$section_alias = isset($row['section'])?$row['section']:"";
			$topic = strip_tags(trim($row['topic']));
			$publish_date = $row['publish_date'];
			$editor_fullname = $row['editor'];
			$writter_fullname = $row['author'];
			$pageviews = intval($row['pageviews']);
			$arrContentTag = (isset($row['tag']) && !empty($row['tag']))?explode(",",$row['tag']):array();
			$arrTag = array();
			if(count($arrContentTag) > 0){
				foreach($arrContentTag as $tag){
					$tag_title = strip_tags(trim($tag));
					$tag_alias = $google_analytic->url_title($tag_title);;
					
					$arrTagDetail = array();
					$arrTagDetail['alias'] = $tag_alias;
					$arrTagDetail['title'] = $tag_title;
					array_push($arrTag,$arrTagDetail);
				}	
			}
			
			if($domain == "tribunnews"){
				$fields = array("title", "alias", "section", "section_id", "category_id", "c_alias", "c_title", "s_title", "foto_type", "foto_name", "publish_date", "written_date","introtext","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
				$query = array("match" => array("_id" => $id));
				$response4 = $opensearch->findOne("tribunnews-articles", $query, $fields);	
			} else if($domain == "video"){
				$fields = array("title", "topic", "category", "poster", "file", "upload_date", "editor_video", "editor_video_name", "uploader", "uploader_name", "reporter", "cameraman");
				$query = array("match" => array("id" => $id));
				$response4 = $opensearch->findOne("tribunnews-video", $query, $fields);
			} else {
				if(in_array($domain, LIST_TBO_CLUSTER)){
					$fields = array("title","alias","section","section_id","category_id","c_alias","c_title","s_title","foto_type","foto_name","publish_date", "written_date","introtext","written_by","writter_fullname","editor_by","editor_fullname","editor_username");
					$query = array("match" => array("_id" => $id));
					$response4 = $opensearchTBO->findOne($domain.".articles", $query, $fields);	
				} else if($domain == "trends"){
					//Belum ada
				} else if($domain == "tribunnewswiki"){
					$fields = array("title","alias","foto_type","foto_name","publish_date", "written_date","introtext","written_by","writter_fullname","editor_by","editor_fullname","wikiblog");
					$query = array("match" => array("_id" => $id));
					$response4 = $opensearchWIKI->findOne("tribunnewswiki-articles", $query, $fields);	
				} else if(in_array($domain, LIST_DAERAH_CLUSTER)){
					$fields = array("title","alias","section","section_id","category_id","c_alias","c_title","s_title","foto_type","foto_name","publish_date", "written_date","introtext","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
					$query = array("match" => array("_id" => $id));
					$response4 = $opensearchDaerahCluster->findOne($domain.".tribundaerah-articles", $query, $fields);
				} else { 
					$fields = array("title","alias","section","section_id","category_id","c_alias","c_title","s_title","foto_type","foto_name","publish_date", "written_date","introtext","written_by","writter_fullname","editor_by","editor_fullname","writter_username","editor");
					$query = array("match" => array("_id" => $id));
					$response4 = $opensearchDaerah->findOne($domain.".tribundaerah-articles", $query, $fields);	
				}
			}	
			

			if($response4['status']){
				$rows = isset($response4['data']['_source'])?json_decode(json_encode($response4['data']['_source'])):array();
				
				$alias = isset($rows->alias)?$rows->alias:"";
				$foto_name = isset($rows->foto_name)?$rows->foto_name:"";
				$foto_type = isset($rows->foto_type)?$rows->foto_type:"";
				$written_date = isset($rows->written_date)?$rows->written_date:"";
				$section_id = isset($rows->section_id)?intval($rows->section_id):0;
				$section = isset($rows->s_title)?$rows->s_title:"";
				$category_id = isset($rows->category_id)?intval($rows->category_id):0;
				$category_alias = isset($rows->category_alias)?$rows->category_alias:"";
				if(empty($category_alias)){
					$category_alias = isset($rows->c_alias)?$rows->c_alias:"";
				}	
				$category = isset($rows->category)?$rows->category:"";
				if(empty($category)){
					$category = isset($rows->c_title)?$rows->c_title:"";
				}
				$written_by = isset($rows->written_by)?intval($rows->written_by):0;
				$written_username = isset($rows->writter_username)?$rows->writter_username:"";
				$editor_by = isset($rows->editor_by)?intval($rows->editor_by):0;
				$editor_username = isset($rows->editor_username)?$rows->editor_username:"";
				if(empty($editor_username)){
					$editor_username = isset($rows->editor)?$rows->editor:"";
				}
				$topic_alias = "";
				if(!empty($topic)){
					$topic_alias = $google_analytic->url_title($topic);
				}
				
				$youtube = "";
				if($domain == "video"){
					$section 			= $category;
					$section_alias 		= $category;
					$category_alias 	= $category;
					$alias 				= "view/".$id."/".$alias;
					$youtube_file 		= isset($rows->file)?json_decode($rows->file):"";
					if(!empty($youtube_file)){
						$foto_name = $youtube_file->youtube->id.'/sddefault.jpg';
						$youtube = $youtube_file->youtube->id;
					} else {
						$foto_name = isset($youtube_file->poster)?$youtube_file->poster:"";
					}
				}
				
				if($domain == "tribunnewswiki"){
					$wikiblog = isset($rows->wikiblog)?intval($rows->wikiblog):1;
					$section_id = $wikiblog;
					$section = "Wiki";
					if($wikiblog == 2){
						$section = "Blog";
					}	
					$section_alias = $google_analytic->url_title($section);
				}	
				
				$foto_cross_domain = 0;
				if(!empty($foto_name)){
					$arrFotoName = explode("/",$foto_name);
					$foto_cross_domain = isset($arrFotoName[1])?1:0;
				}
				
				if(!empty($alias)){
					$dataArticleDetail = array();
					$dataArticleDetail['id'] = $domain."-".$id;
					$dataArticleDetail['domain'] = $domain;
					$dataArticleDetail['domain_id'] = $id;
					$dataArticleDetail['title'] = strip_tags($title);
					$dataArticleDetail['section_id'] = $section_id;
					$dataArticleDetail['section_alias'] = strip_tags($section_alias);
					$dataArticleDetail['section'] = strip_tags($section);
					$dataArticleDetail['category_id'] = $category_id;
					$dataArticleDetail['category'] = strip_tags($category);
					$dataArticleDetail['category_alias'] = strip_tags($category_alias);
					$dataArticleDetail['topic'] = $topic;
					$dataArticleDetail['topic_alias'] = $topic_alias;
					$dataArticleDetail['alias'] = strip_tags($alias);
					$dataArticleDetail['publish_date'] = $publish_date;
					$dataArticleDetail['foto_name'] = strip_tags($foto_name);
					$dataArticleDetail['foto_cross_domain'] = $foto_cross_domain;
					$dataArticleDetail['foto_type'] = $foto_type;
					$dataArticleDetail['written_date'] = $written_date;
					$dataArticleDetail['editor_by'] = $editor_by;
					$dataArticleDetail['editor_username'] = $editor_username;
					$dataArticleDetail['editor_fullname'] = $editor_fullname;
					$dataArticleDetail['written_by'] = $written_by;
					$dataArticleDetail['written_username'] = $written_username;
					$dataArticleDetail['writter_fullname'] = $writter_fullname;
					$dataArticleDetail['youtube'] = $youtube;
					$dataArticleDetail['tag'] = $arrTag;
					$dataArticleDetail['pageviews'] = $pageviews;
					
					$responseInsert = $opensearch->insert("network-populer-ga-articles", $dataArticleDetail);
					///$responseInsert = $opensearchTest->insert("network-populer-ga-articles", $dataArticleDetail);
					
					/* echo "<pre>";
					print_r($responseInsert);
					print_r($dataArticleDetail);
					echo "</pre>"; */
				
					if($responseInsert['status']){
						$total++;
					} 
				}	
			}	
		}

		unset($opensearch);
		unset($opensearchDaerah);
		unset($opensearchDaerahCluster);
		unset($opensearchTBO);
		unset($opensearchWIKI);
	}
}

echo "Total : ".$total."\n";

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
?>