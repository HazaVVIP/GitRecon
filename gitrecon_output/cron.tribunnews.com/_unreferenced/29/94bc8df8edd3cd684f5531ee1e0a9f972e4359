- sudo -u cron /usr/bin/php7.4 /var/www/html/web-cron/google_analytic/insert_video_tribunnews.php > /home/cron/log_cron/insert_ga_video_tribunnews.txt
*/

$section = isset($_SERVER["argv"][1])?$_SERVER["argv"][1]:"";
if(isset($_GET['section'])){
	$section = $_GET['section'];
}	

$google_analytic = new Google_analytic(AUTH_CREDENTIAL_PROD);

$applicationName = "Tribunnews Top Video";
$viewId = "142127426"; //tribun video
$google_analytic->initializeAnalytics($applicationName,$viewId);
$analytics = $google_analytic->getTopVideoTribunnews($section);

$dataPopuler = array();
$total = 0;
if($analytics['status']){
	$dataPopuler = $google_analytic->getResultTopVideoTribunnews($analytics);
	
	if(count($dataPopuler) > 0){
		$opensearchTest = new Opensearch();
		$opensearchTest->init(ES_TEST_URL,"","",false);
		
		$opensearch = new Opensearch();
		$opensearch->init(OS_URL,OS_USERNAME,OS_PASSWORD,true);
		
		foreach($dataPopuler as $val){
			$id = intval($val['id']);
			$pageviews = intval($val['pageviews']);
			
			$query = array("match" => array("id" => $id));
			$fields = array("title", "update_date", "views_count");
			$response = $opensearch->findOne("tribunnews-video", $query, $fields);
			//$response = $opensearchTest->findOne("tribunnews-video", $query, $fields);
			
			if($response['status']){
				$value = isset($response['data'])?$response['data']:array();
				
				$arrUpdate = array();
				$arrUpdate['views_count'] = $pageviews;
				
				$responseUpdate = $opensearch->updateOne("tribunnews-video", $id, $arrUpdate);
				//$responseUpdate = $opensearchTest->updateOne("tribunnews-video", $id, $arrUpdate);
				
				echo "<pre>";
				print_r($responseUpdate);
				print_r($arrUpdate);
				echo "</pre>";
				
				if($responseUpdate['status']){
					$total++;
				}
			}	
		}		
	}
}

echo "Total : ".$total."\n";

unset($opensearch);

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
