$playtime_seconds = isset($file['playtime_seconds'])?floor($file['playtime_seconds']):0;

echo "Format : ".$fileformat."<br>";
echo "Size : ".$filesize."<br>";
echo "Durasi : ".$playtime_seconds."<br>";
echo "<pre>";
print_r($file);
echo "</pre>";
?>