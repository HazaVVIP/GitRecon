<?php
ini_set('display_errors',1);
error_reporting(E_ALL);

define("DOC_ROOT","/var/www/html/web-cron/");

$filename = "video1.mp4";

include_once(DOC_ROOT.'tribunnews/video/getID3/getid3/getid3.php');
$getID3 = new getID3;

$pathfile = DOC_ROOT."tribunnews/video/".$filename;
$file = $getID3->analyze($pathfile);

$fileformat = isset($file['fileformat'])?$file['fileformat']:"";
