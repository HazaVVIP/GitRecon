<?php
ini_set('display_errors',1);
error_reporting(E_ALL);
//error_reporting(0);

use \MongoDB\BSON\UTCDateTime;

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require_once "./../../vendor/autoload.php";
include DOC_ROOT."config/config.php";
include DOC_ROOT."config/other_config.php";
include DOC_ROOT."lib/Mongodb.php";
include DOC_ROOT."lib/Opensearch.php";

$date = isset($_GET['date'])?$_GET['date']:"";

if(!empty($date)){
	$dateStart = $date;
} else {	
	$dateStart = date("Y-m-d", strtotime('-1 days'));
}

echo $dateStart."<br><br>";

$dateHistory = date("Ymd", strtotime($dateStart));

//MONGODB
$mongodb_options = array(
					'replicaSet' => 'atlas-105on5-shard-0',
					'readPreference' => 'secondaryPreferred',
					'readPreferenceTags' => array( array('availabilityZone' => 'apse1-az1') ),
					'tls' => true
				   );

$mongodb = new Mongodb();
$mongodb->connect_replika(MONGODB_USER_HOST_READ_PROD,MONGODB_USER_USERNAME_READ_PROD,MONGODB_USER_PASSWORD_READ_PROD,"tribunnews",true,$mongodb_options);



$start = new UTCDateTime(strtotime(''.$dateStart.' 00:00:00') * 1000 + MONGO_DATETIME_GMT7);
$end   = new UTCDateTime(strtotime(''.$dateStart.' 23:59:59') * 1000 + MONGO_DATETIME_GMT7);


$query = [
		'created_at' => [
			'$gte' => $start,
			'$lte' => $end
		],
		"content_type" => "article"
	];
	
$options = [
    'group' => [
        '_id' => null,
        'unique_users' => ['$addToSet' => '$user_id']
    ],
    'project' => [
        '_id' => 0,
        'total_unique_users' => ['$size' => '$unique_users']
    ],
    'sort' => [
        'total_unique_users' => 1
    ]
];

$resUserUniqueActive = $mongodb->aggregate("users_history", $query, $options);
$total_unique_users = isset($resUserUniqueActive[0]->total_unique_users)?intval($resUserUniqueActive[0]->total_unique_users):0;

echo "Total Unique Users (Apps, Desktop, Mobile) = ".$total_unique_users."<br>";


