<?php
//RDS
class config_db{
    private $db_host;
    private $db_username;
    private $db_password;

    public function __construct()
    {
        $this->db_host = RDS_TJB_HOST_DEV;
        $this->db_username = RDS_TJB_USERNAME_DEV;
        $this->db_password = RDS_TJB_PASSWORD_DEV;
    }
    
    public function conn_to_db()
    {
        $db_name = "jualbeli";
        $con = mysqli_connect($this->db_host, $this->db_username,$this->db_password,$db_name);
        if (mysqli_connect_errno()) {
            echo "Failed to connect to MySQL: " . mysqli_connect_error();
            exit();
        }

        return $con;
    }


}


