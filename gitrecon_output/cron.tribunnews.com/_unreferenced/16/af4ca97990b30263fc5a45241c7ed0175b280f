	class Main
	{	
		private $propertyId;
		private $domain;
		private $populer_data;
		private $total;
		private $time_start;
		private $topIklanTribunJualBeli;

		public function __construct()
		{
			$this->propertyId = '325528828';
			$this->domain = 'tribunjualbeli';
			$this->populer_data = array();
			$this->time_start = 0;
			$this->topIklanTribunJualBeli =  new TopIklanTribunJualBeli();
		}

		public function InitTopIklanTribunJualBeli__()
		{
			$google_analytic = new Google_analytic4(AUTH_CREDENTIAL_STAG);

			$google_analytic->initializeAnalytics($this->propertyId);

			$analytics = (object) $google_analytic->getTopTribunjualbeli($this->domain);

			if ($analytics->status == false) {
				$this->topIklanTribunJualBeli->logMessage("STOP processing insert top iklan. Status = false", "ERROR");
				exit();
			}

			if ($analytics->status == true && count($analytics->data) > 0) {

				$this->topIklanTribunJualBeli->logMessage("Processing insert top iklan with data count: " . count($analytics->data));

				$response = $this->topIklanTribunJualBeli->insertTopIklanTribunJualBeli($analytics->data);

				$this->populer_data = isset($response['data']) ? $response['data'] : array();
			}

			$response_data = json_encode(array('total_procced' => count($this->populer_data), 'source_data' => count($analytics->data), 'execution_time' => microtime(true) - $this->time_start));

			$this->topIklanTribunJualBeli->logMessage($response_data);
			
			$this->topIklanTribunJualBeli->deleteAllIklanPopulerGA();

			$this->InitReadLogMessages();
			exit();
		}

		public function InitReadLogMessages() {
			
			$logLines = $this->topIklanTribunJualBeli->readLogMessages(LOGGING);
			foreach ($logLines as $line) {
				echo $line . "<br>";
			}
		}
	}

	class TopIklanTribunJualBeli
	{
		private $opensearch;
		private $opensearch_prod;
		private $index_post;
		private $index_popular;
		

		public function __construct()
		{
			$this->opensearch = new Opensearch();
			$this->opensearch->init(OS_DEV_URL, OS_DEV_USERNAME, OS_DEV_PASSWORD, true);

			$this->opensearch_prod = new Opensearch();
			$this->opensearch_prod->init(OS_TJB_URL, OS_TJB_USERNAME, OS_TJB_PASSWORD, true);

			$this->index_post = 'web-post';
			$this->index_popular = 'web-populer-ga';
		}

		public function deleteAllIklanPopulerGA()
		{
			$dateToday = date("Y-m-d");

			//$dateDaysAgo = strtotime('-31 day', strtotime($dateToday));
			$dateDaysAgo = strtotime('-1 day', strtotime($dateToday));

			$startDateDaysAgo = date('Y-m-d 00:00:00', $dateDaysAgo);

			$endDateDaysAgo = date('Y-m-d 23:59:59', $dateDaysAgo);

			$condition = array("range" => array("date_publish" => array("gte" => $startDateDaysAgo, "lte" => $endDateDaysAgo)));

			$response = $this->opensearch->deleteMany($this->index_popular, $condition);

			// file_get_contents("https://www.tribunjualbeli.com/tcache/clear_home");

			if (!$response['status']) {
				$this->logMessage("FAILED DELETE TOP IKLAN", "ERROR");
				return false;
			}

			$this->logMessage("SUCCESS DELETE TOP IKLAN");
			return true;
		}

		public function insertTopIklanTribunJualBeli($data)
		{
			$total = 0;

			$arrResponse = array();

			$fields = array("id","title","image","price","date_publish","date_created","category","category_alias","category_title",
			"location","location_alias","location_title","sublocation","sublocation_alias","sublocation_title","status","type","nego",
			"subcategory","subcategory_alias","subcategory_title","is_commerce");

			foreach ($data as $idx => $populer) {

				$condition = ["match" => ["id" => $populer['id']]];

				$response = $this->opensearch_prod->findOne($this->index_post, $condition, $fields);

				if (!$response['status']) {
					$this->logMessage($response['status'], "ERROR");
					continue;
				}

				$dataEs = isset($response['data']) ? $response['data'] : null;

				if (empty($dataEs) && count($dataEs) <= 0) {
					$this->logMessage($response['status'], "ERROR");
					continue;
				}

				$dataInsert = array(
					'id' => intval($dataEs['_source']['id']),
					'title' =>  $dataEs['_source']['title'],
					'price' => $dataEs['_source']['price'],
					'date_publish' => $dataEs['_source']['date_publish'],
					'date_created' => $dataEs['_source']['date_created'],
					'image' => $dataEs['_source']['image'],
					'category' => intval($dataEs['_source']['category']),
					'category_alias' => $dataEs['_source']['category_alias'],
					'category_title' => $dataEs['_source']['category_title'],
					'subcategory' => intval($dataEs['_source']['subcategory']),
					'subcategory_alias' => $dataEs['_source']['subcategory_alias'],
					'subcategory_title' => $dataEs['_source']['subcategory_title'],
					'location' => intval($dataEs['_source']['location']),
					'location_alias' => $dataEs['_source']['location_alias'],
					'subcategory_title' => $dataEs['_source']['subcategory_title'],
					'sublocation' => intval($dataEs['_source']['sublocation']),
					'sublocation_alias' => $dataEs['_source']['sublocation_alias'],
					'sublocation_title' => $dataEs['_source']['sublocation_title'],
					'type' => intval($dataEs['_source']['type']),
					'nego' => intval($dataEs['_source']['nego']),
					'pageviews' => intval($populer['pageviews']),
					'is_commerce' => intval($dataEs['_source']['is_commerce'])
				);

				$response = $this->opensearch->insert($this->index_popular, $dataInsert);

				$res = array();

				$res['id'] = $populer['id'];
				$res['status'] = $response['status'];
				$res['result'] = $response['result'];
				$res['pageviews'] = intval($populer['pageviews']);

				$arrResponse[] = $res;
				$total++;
			}

			$result['status'] = true;
			$result['total'] = $total;
			$result['data'] = $arrResponse;

			return $result;
		}

		public function logMessage($message, $status="INFO")
		{
			$logFile = LOGGING;
			$formattedMessage = "[".$status."][" . date("Y-m-d H:i:s") . "] " . $message . PHP_EOL;

			# TRUNCATE FILE
			$currentContent = file_get_contents($logFile);
			$lineCount = substr_count($currentContent, PHP_EOL);
			if ($lineCount >= 50) {
				file_put_contents($logFile, '', LOCK_EX);
			}

			file_put_contents($logFile, $formattedMessage, FILE_APPEND | LOCK_EX);
		}

		public function readLogMessages($logFilePath) {

			if (!file_exists($logFilePath)) {
				$this->logMessage("Log file not found.", "ERROR");
				return false;
			}
		
			$logLines = file($logFilePath, FILE_IGNORE_NEW_LINES);
		
			if (!is_array($logLines)) {
				$this->logMessage("Error reading log file.", "ERROR");
				return false;
			}
		
			return $logLines;
		}
		
	}

