$http_code = "";
$status_response_header = isset($http_response_header[0])?$http_response_header[0]:"";
if(!empty($status_response_header)){
	preg_match('{HTTP\/\S*\s(\d{3})}', $status_response_header, $match);
	$http_code = isset($match[1])?$match[1]:"";
}

echo $url_klasmen." : ".$http_code."<br><br>";

if($results != false){
	$dom = new DOMDocument('1.0', 'UTF-8');
	$dom->preserveWhiteSpace = false; 
	@$dom->loadHTML($results);
	
	$xpath = new DOMXPath($dom);
	
	$rows = $xpath->query("//table[contains(@class,'result-point')]/tbody/tr");
	
	$arrFindClub = array("PERSIB BANDUNG","BORNEO FC SAMARINDA","DEWA UNITED BANTEN FC","PERSIJA JAKARTA","PERSIS SOLO","BHAYANGKARA PRESISI LAMPUNG FC","PERSEBAYA SURABAYA","PERSIK KEDIRI","PERSITA","BALI UNITED FC","MALUT UNITED FC","AREMA FC","PSIM YOGYAKARTA","PERSIJAP JEPARA","PSM MAKASSAR","MADURA UNITED FC","SEMEN PADANG FC","PSBS BIAK");

	$arrReplClub = array("PERSIB","Borneo FC","Dewa United","Persija","PERSIS","Bhayangkara FC","Persebaya","Persik","Persita","Bali United","Madura United","Arema FC","PSIM Yogyakarta","Persijap","PSM Makassar","Madura United","Semen Padang","PSBS Biak");
	
	$no = 1;
	foreach ($rows as $row) {
		$cols = $xpath->query("./td", $row);
		
		if ($cols->length >= 9) {
			$urutan = trim($cols->item(0)->textContent);
			$klub = trim($cols->item(1)->textContent);
			$score_D = trim($cols->item(2)->textContent);
			$score_M = trim($cols->item(3)->textContent);
			$score_S = trim($cols->item(4)->textContent);
			$score_K = trim($cols->item(5)->textContent);
			$score_GM = trim($cols->item(6)->textContent);
			$score_GK = trim($cols->item(7)->textContent);
			$score_min_plus = trim($cols->item(8)->textContent);
			$score_P = trim($cols->item(9)->textContent);
			$str_LimaHasil = trim($cols->item(10)->textContent);
			
			if(!empty($urutan) && !empty($klub)){
				$arr_LimaHasil = explode(" ",$str_LimaHasil);

				$urutan = intval($urutan);
				$klub = trim($klub);
				$score_D = intval(trim($score_D));
				$score_M = intval(trim($score_M));
				$score_S = intval(trim($score_S));
				$score_K = intval(trim($score_K));
				$score_GM = intval(trim($score_GM));
				$score_GK = intval(trim($score_GK));
				$score_min_plus = trim($score_min_plus);
				$score_P = intval(trim($score_P));
				//$lima_hasil_terakhir = "[]";
				$lima_hasil_terakhir = $arr_LimaHasil;
				
				$klub = str_replace($arrFindClub,$arrReplClub,$klub);
				
				$condition = array("match_phrase" => array("klub" => $klub));
				$fields = array("id","image_klub_link");
				$response = $opensearchTBO->findOne($index,$condition,$fields);
				
				echo $urutan." - ".$klub." - ".$score_D." - ".$score_M." - ".$score_S." - ".$score_K." - ".$score_GM." - ".$score_GK." - ".$score_min_plus." - ".$score_P."<br>";
				
				if($response['status']){
					$id = isset($response['data']['_source']['id'])?intval($response['data']['_source']['id']):0;
					$image_klub_link = isset($response['data']['_source']['image_klub_link'])?$response['data']['_source']['image_klub_link']:"";
					$image_klub_link = str_replace(array("https://t-1.tstatic.net","https://asset-1.tstatic.net"),"https://asset-1.tribunnews.com",$image_klub_link);
					
					$arrUpdate = array();
					$arrUpdate['id'] = $id;
					$arrUpdate['klub'] = $klub;
					$arrUpdate['urutan'] = intval($urutan);
					$arrUpdate['group'] = "";
					$arrUpdate['image_klub_link'] = $image_klub_link;
					$arrUpdate['score_D'] = $score_D;
					$arrUpdate['score_M'] = $score_M;
					$arrUpdate['score_S'] = $score_S;
					$arrUpdate['score_K'] = $score_K;
					$arrUpdate['score_GM'] = $score_GM;
					$arrUpdate['score_GK'] = $score_GK;
					$arrUpdate['score_min_plus'] = $score_min_plus;
					$arrUpdate['score_P'] = $score_P;
					$arrUpdate['lima_hasil_terakhir'] = $lima_hasil_terakhir;
					
					$responseUpdate = $opensearchTBO->updateOne($index, $id, $arrUpdate);
					
					/* echo "Update";
					echo "<pre>";
					print_r($arrUpdate);
					print_r($responseUpdate);
					echo "</pre>"; */
					
					if($responseUpdate['status']){
						$totalUpdate++;
					}
				} else {
					$klub = trim($klub);
					$klub_alias = str_replace(array(" ","."),"-",strtolower($klub));
					
					$image_klub_link = "https://asset-1.tribunnews.com/img/klubimageasset/".$liga."/".$klub_alias.".png";
					
					$arrInsert = array();
					$arrInsert['id'] = time()+$no;
					$arrInsert['klub'] = $klub;
					$arrInsert['urutan'] = intval($urutan);
					$arrInsert['group'] = "";
					$arrInsert['image_klub_link'] = $image_klub_link;
					$arrInsert['score_D'] = $score_D;
					$arrInsert['score_M'] = $score_M;
					$arrInsert['score_S'] = $score_S;
					$arrInsert['score_K'] = $score_K;
					$arrInsert['score_GM'] = $score_GM;
					$arrInsert['score_GK'] = $score_GK;
					$arrInsert['score_min_plus'] = $score_min_plus;
					$arrInsert['score_P'] = $score_P;
					$arrInsert['lima_hasil_terakhir'] = $lima_hasil_terakhir;
					
					$responseInsert = $opensearchTBO->insert($index, $arrInsert);
					
					/* echo "Insert";
					echo "<pre>";
					print_r($arrInsert);
					print_r($responseInsert);
					echo "</pre>"; */
					
					if($responseInsert['status']){
						$totalInsert++;
					}
					
					$no++;
				}
			}
		}
	}
