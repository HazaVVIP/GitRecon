$dataPopuler = array();
$total = 0;
$totalall = 0;
if($analytics['status']){
	$dataPopuler = $google_analytic->printResultTopTagTribunnewsWiki($analytics);

	if(count($dataPopuler) > 0){
		$opensearchTest = new Opensearch();
		$opensearchTest->init(ES_TEST_URL,"","",false);
		
		$opensearchWiki = new Opensearch();
		$opensearchWiki->init(OS_TNEWSWIKI_URL,OS_TNEWSWIKI_USERNAME,OS_TNEWSWIKI_PASSWORD,true);
		
		//Delete
		$condition = array("match_phrase" => array("mode" => "tag"));
		$response1 = $opensearchWiki->deleteMany("tribunnewswiki-populer-ga-tagtopic",$condition);
		//$response1 = $opensearchTest->deleteMany("tribunnewswiki-populer-ga-tagtopic",$condition);
		
		$dataTagPopuler = array();
		$dataTagPopuler['tag'] = isset($dataPopuler)?$dataPopuler:array();
		
		if(count($dataTagPopuler) > 0){
			//Insert
			$arrTags = isset($dataTagPopuler['tag'])?$dataTagPopuler['tag']:array();				
			foreach($arrTags as $idx => $tagSection){
				$section = isset($tagSection['section'])?$tagSection['section']:"";
				$arrTag = isset($tagSection['tag'])?$tagSection['tag']:"";
				
				if(count($arrTag) > 0 && !empty($section)){
					$total = 0;
					$rank = 1;

					foreach($arrTag as $title){
						if(!empty($title)){
							if($section != "home"){
								$alias = "tag-".$google_analytic->url_title($title);
							} else {
								$alias = "tag-".$section."-".$google_analytic->url_title($title);
							}
						
							$arrPopuler = array();
							$arrPopuler['id'] = $alias;
							$arrPopuler['title'] = $title;
							$arrPopuler['mode'] = "tag";
							$arrPopuler['rank'] = $rank;
							$arrPopuler['section'] = $section;
							
							$responseInsert = $opensearchWiki->insert("tribunnewswiki-populer-ga-tagtopic", $arrPopuler);
							//$responseInsert = $opensearchTest->insert("tribunnewswiki-populer-ga-tagtopic", $arrPopuler);
							
							/* echo "<pre>";
