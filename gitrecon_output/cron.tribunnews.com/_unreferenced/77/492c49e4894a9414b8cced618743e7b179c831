<script>
const audios = document.querySelectorAll(".audio-player");

audios.forEach(audio => {

    let hls;

    function initAudio() {
        if (audio.dataset.loaded) return;

        const hlsUrl = audio.dataset.hls;
        const fallback = audio.dataset.fallback;

        if (Hls.isSupported()) {
            hls = new Hls();
            hls.loadSource(hlsUrl);
            hls.attachMedia(audio);

            hls.on(Hls.Events.ERROR, function () {
                audio.src = fallback;
            });

        } else if (audio.canPlayType('application/vnd.apple.mpegurl')) {
            audio.src = hlsUrl;
        } else {
            audio.src = fallback;
        }

        audio.dataset.loaded = "1";
    }

    // 🔥 load saat pertama play (hemat bandwidth)
    audio.addEventListener("play", () => {
        initAudio();

        // stop audio lain
        audios.forEach(a => {
            if (a !== audio) {
                a.pause();
                a.currentTime = 0;
            }
        });
    });

});
</script>

