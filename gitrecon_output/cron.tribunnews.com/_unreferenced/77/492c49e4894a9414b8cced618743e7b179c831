function getSurah($os, $chapter_id) {
    $condition = [
        "bool" => [
            "must" => [
                ["term" => ["chapter_id" => $chapter_id]]
            ]
        ]
    ];
	
	$fields = [
		"ayah_id",
		"ayah_text",
		"ayah_translation_id",
		"ayah_transliteration_en"
	];

    $sort = [
        ["ayah_id" => ["order" => "asc"]]
    ];

    $res = $os->find("quran", $condition, $fields, $sort, 0, 300);

    if ($res['status'] == 1) {
        return array_map(function($hit){
            return $hit['_source'];
        }, $res['data']);
    }

    return [];
}

function getAyah($os, $chapter_id, $ayah) {
    $condition = [
        "bool" => [
            "must" => [
                ["term" => ["chapter_id" => $chapter_id]],
                ["term" => ["ayah_id" => $ayah]]
            ]
        ]
    ];

    $res = $os->findOne("quran", $condition);

    if ($res['status'] == 1) {
        return $res['data']['_source'];
    }

    return null;
}


