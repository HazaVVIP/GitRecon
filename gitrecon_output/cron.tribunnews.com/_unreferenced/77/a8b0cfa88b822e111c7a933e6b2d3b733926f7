                        'string_filter' => new Filter\StringFilter([
                          'match_type' => Filter\StringFilter\MatchType::BEGINS_WITH,
                          'value' => ''.$todayDate.'',
                         ])
                    ])
                ]));
			
			if(!empty($strDomain)){
				array_push($arrFilterExpressionClauses, new FilterExpression([                
                    'filter' => new Filter([
                        'field_name' => 'customEvent:domain',
                        'string_filter' => new Filter\StringFilter([
                          'match_type' => Filter\StringFilter\MatchType::EXACT,
                          'value' => $strDomain,
                         ])
                    ]),   
                ]));
			} else {
				array_push($arrFilterNotExpressionClauses, new FilterExpression([                
                    'filter' => new Filter([
                        'field_name' => 'customEvent:domain',
                        'string_filter' => new Filter\StringFilter([
                          'match_type' => Filter\StringFilter\MatchType::EXACT,
                          'value' => 'tribunnews',
                         ])
                    ]),   
                ]));
			}			
			
			if($hoursNow > 2 && $hoursNow < 6){
				$orderByField = "customEvent:publish_date";
			} else if($hoursNow > 6 && $hoursNow < 10){
				$orderByField = "screenPageViews";
			} else if($hoursNow > 10 && $hoursNow < 14){
				$orderByField = "customEvent:publish_date";
			} else if($hoursNow > 14 && $hoursNow < 18){
				$orderByField = "screenPageViews";
			} else if($hoursNow > 18 && $hoursNow < 23){
				$orderByField = "customEvent:publish_date";
			} else {
				$orderByField = "screenPageViews";
			}
			
			$response = $this->client->runReport([
				'property' => 'properties/' . $this->propertyId,
				'dateRanges' => [
					$arrDateRange
				],
				'dimensions' => [
					new Dimension([
						'name' => 'customEvent:idArticle'
					]),
					new Dimension([
						'name' => 'customEvent:title'
					]),
					new Dimension([
						'name' => 'customEvent:domain'
					]),
					new Dimension([
						'name' => 'customEvent:section'
					]),
					new Dimension([
						'name' => 'customEvent:editor'
					]),
					new Dimension([
						'name' => 'customEvent:penulis'
					]),
					new Dimension([
						'name' => 'customEvent:content_tag'
					]),
					new Dimension([
						'name' => 'customEvent:content_topic'
					]),
					new Dimension([
						'name' => 'customEvent:publish_date'
					])
				],
				'metrics' => [
					new Metric([
						'name' => 'screenPageViews',
					])
				],
				'dimensionFilter' => new FilterExpression([
					'and_group'=>  new FilterExpressionList([
						'expressions'=> $arrFilterExpressionClauses,
						'not_expressions'=> $arrFilterNotExpressionClauses,
					]),
				]),
				'orderBys' => [
					new OrderBy([
						'dimension' => new OrderBy\DimensionOrderBy([
							'dimension_name' => $orderByField,
							'order_type' => OrderBy\DimensionOrderBy\OrderType::ALPHANUMERIC
						]),
						'desc' => true,
					]),
				],
				"limit" => $limit
			]);
			
			echo "<pre>";
			print_r($response);
			echo "</pre>";
			
			$arrPopuler = array();
			foreach ($response->getRows() as $idx => $row) {
				$pageviews = $row->getMetricValues()[0]->getValue();
	
				$id = $row->getDimensionValues()[0]->getValue();
				$title = $row->getDimensionValues()[1]->getValue();
				$domain = $row->getDimensionValues()[2]->getValue();
				$section = $row->getDimensionValues()[3]->getValue();
				$editor = $row->getDimensionValues()[4]->getValue();
				$author = $row->getDimensionValues()[5]->getValue();
				$tag = $row->getDimensionValues()[6]->getValue();
				$topic = $row->getDimensionValues()[7]->getValue();
				$publish_date = $row->getDimensionValues()[8]->getValue();
				
				if($topic == "(not set)") $topic = "";
				if($author == "(not set)") $author = "";
				
				if(!empty($id)){
					$arrPopuler[$idx]['id'] = $id;
					$arrPopuler[$idx]['title'] = $title;
					$arrPopuler[$idx]['domain'] = $domain;
					$arrPopuler[$idx]['section'] = $section;
					$arrPopuler[$idx]['editor'] = $editor;
					$arrPopuler[$idx]['author'] = $author;
					$arrPopuler[$idx]['tag'] = $tag;
					$arrPopuler[$idx]['topic'] = $topic;
					$arrPopuler[$idx]['publish_date'] = $publish_date;
					$arrPopuler[$idx]['pageviews'] = $pageviews;
				}
			}	
			
			$results['status'] = 1;	
			$results['data'] = $arrPopuler;		
		} catch (Exception $e) {
			$errRespond = json_decode($e->getMessage(),TRUE);

			$results['status'] = 0;	
			$results['code'] = isset($errRespond['code'])?$errRespond['code']:"";
			$results['message'] = isset($errRespond['message'])?$errRespond['message']:"";			
		}

		return $results;	
	}
	
	public function url_title($str) {
		 $title = strtolower(trim($str));
		 $replacements = ['@'=> "at", '#' => "hash", '$' => "dollar", '%' => "percentage", '&' => "and", '.' => "dot", 
					'+' => "plus", '-' => "minus", '*' => "multiply", '/' => "devide", '=' => "equal to",
					'<' => "less than", '<=' => "less than or equal to", '>' => "greater than", '<=' => "greater than or equal to",
			];

		 $title = strtr($title, $replacements);
		 return $urlKey = preg_replace('#[^0-9a-z]+#i', '-', $title);
	}
	
	private function array_search_key_exists($value='',$key='', $haystack=array(), $isindex=false){
		foreach ($haystack as $idx => $item) {
			if ($item[$key]===$value) {
				if($isindex){
					return $idx;
				} else {
					return true;
				}
			}
		}
		return false;
	}
