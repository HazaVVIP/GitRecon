PUT quran_ayahs
{
  "settings": {
    "analysis": {
      "normalizer": {
        "lc_norm": {
          "type": "custom",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {

      "id": { "type": "integer" },
      "verse_key": { "type": "keyword" },
      "sort_order": { "type": "integer" },

      "create_date": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },

      "chapter_id": { "type": "byte" },
      "chapter_sequence": { "type": "short" },
      "chapter_total_verses": { "type": "short" },

      "surah_name": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },

      "chapter_name_latin_id": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lc_norm"
          }
        }
      },

      "ayah_text": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },

      "ayah_plain": {
        "type": "text"
      },

      "ayah_translation_id": {
        "type": "text"
      },

      "ayah_audio_primary": {
        "type": "keyword"
      },

      "ayah_audio_secondary": {
        "type": "keyword"
      }
    }
  }
}