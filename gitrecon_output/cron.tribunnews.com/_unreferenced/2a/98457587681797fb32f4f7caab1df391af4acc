$opensearchTest = new Opensearch();
$opensearchTest->init(ES_TEST_URL,"","",false);

$opensearchADS = new Opensearch();
//$opensearchADS->init(OS_DEV_URL,OS_DEV_USERNAME,OS_DEV_PASSWORD,true);
$opensearchADS->init(ES_ADS_URL,ES_ADS_USERNAME,ES_ADS_PASSWORD,true);

$query = array("match_all" => new stdClass());
$fields = array("id","url");	
$sort = array("id" => array("order" => "asc"));
//$response = $opensearchTest->find("tribunnews-ads_job_worker",$query,$fields,$sort,0,20);
$response = $opensearchADS->find("tribunnews-ads_job_worker",$query,$fields,$sort,0,20);

$totalProcess = 0;

if($response['status']){
	$arrJobWorker = isset($response['data'])?$response['data']:array();
	
	if(count($arrJobWorker) > 0){
		foreach($arrJobWorker as $jobworker){
			$id = isset($jobworker['_source']['id'])?intval($jobworker['_source']['id']):0;
			$url = isset($jobworker['_source']['url'])?$jobworker['_source']['url']:"";
			
			if(!empty($url)){
				$options = array(
							  'http'=>array(
								'method'=>"GET",
								'timeout'=>1,
								'header'=>"Accept-language: en\r\n" .
										  "User-Agent: Mozilla/5.0 (iPad; U; CPU OS 3_2 like Mac OS X; en-us) AppleWebKit/531.21.10 (KHTML, like Gecko) Version/4.0.4 Mobile/7B334b Safari/531.21.102011-10-16 20:23:10\r\n"
							  )
							);
				$context = stream_context_create($options);
				$results = file_get_contents($url, false, $context);
				
				echo $url."<br>";
				var_dump($results);
				
				if($results != false){
					//$response1 = $opensearchTest->deleteOne("tribunnews-ads_job_worker",$id);
					$response1 = $opensearchADS->deleteOne("tribunnews-ads_job_worker",$id);
					
					$totalProcess++;
				} 
			}	
		}	
	}
}	

echo "Total Ads : Job Workers = ".$totalProcess."\n";

unset($opensearchTest);
unset($opensearchADS);

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
