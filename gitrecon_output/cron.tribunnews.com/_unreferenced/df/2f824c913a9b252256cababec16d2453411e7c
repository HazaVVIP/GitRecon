<?phpini_set('display_errors',1);error_reporting(E_ALL);//error_reporting(0);$time_start = time();define("DOC_ROOT","/var/www/html/web-cron/");include DOC_ROOT."config/config.php";include DOC_ROOT."lib/simple_html_dom.php";include DOC_ROOT."lib/Opensearch.php";$html = file_get_html('https://www.the-race.com/results/motogp/12170-2023/', false, null, 0);if($html != false){	$dom = new DOMDocument('1.0', 'UTF-8');	$internalErrors = libxml_use_internal_errors(true);	$dom->loadHTML($html);	$xpath = new DOMXPath($dom);	$div = $xpath->query('//table[@class="main-table fixTable"]');		$cdn_url = 'https://asset-1.tstatic.net/';	$countryLable = [			"jepang" => $cdn_url.'img/motogp/country/jp-2.svg',			"indonesia" => $cdn_url.'img/motogp/country/id-2.svg',			"italia" => $cdn_url.'img/motogp/country/it-2.svg',			"malaysia" => $cdn_url.'img/motogp/country/my-2.svg',			"prancis" => $cdn_url.'img/motogp/country/fr-2.svg',			"austria" => $cdn_url.'img/motogp/country/at-2.svg'		];		$arrFlagJepang = array("Monster Energy Yamaha MotoGP","Repsol Honda Team");	$arrFlagIndonesia = array("LCR Honda");	$arrFlagPrancis = array("Gasgas Factory Racing Tech3");	$arrFlagAustria = array("Red Bull KTM Factory Racing");	$arrFlagMalaysia= array("CryptoData RNF MotoGP Team");	$arrFlagItalia = array("Pramac Racing", "Mooney VR46 Racing Team","Ducati Lenovo Team","Aprilia Racing", "Gresini Racing MotoGP");	 	$arrDucati = array("Ducati Lenovo Team","Gresini Racing MotoGP","Pramac Racing","Mooney VR46 Racing Team"); 	$arrAprilia = array("Aprilia Racing","CryptoData RNF MotoGP Team"); 	$arrHonda = array("LCR Honda","Repsol Honda Team"); 	 	$arrStandingTeams = array();		$div = $div->item(1);	if ($div){		$xml_string = $dom->saveXML($div);		$xml = simplexml_load_string($xml_string);		$json = json_encode($xml);		$array = json_decode($json,TRUE);				$rowsTable = $array['tbody']['tr'];				foreach($rowsTable as $rows){			$row = isset($rows['td'])?$rows['td']:array();						if(count($row) > 0){				$win = $podium = 0;								$position = intval(trim($row[0]));				$teamname = trim($row[1]);				$total_point = intval(trim($row[2]));								$team_flag = "";				if (in_array($teamname, $arrFlagJepang)){					$team_flag = $countryLable['jepang'];				} else if (in_array($teamname, $arrFlagItalia)){					$team_flag = $countryLable['italia'];				} else if (in_array($teamname, $arrFlagIndonesia)){					$team_flag = $countryLable['indonesia'];				} else if (in_array($teamname, $arrFlagPrancis)){					$team_flag = $countryLable['prancis'];				} else if (in_array($teamname, $arrFlagAustria)){					$team_flag = $countryLable['austria'];				} else if (in_array($teamname, $arrFlagMalaysia)){					$team_flag = $countryLable['malaysia'];				} 								$constructor = "";				if (in_array($teamname, $arrDucati)){					$constructor = "Ducati";				} else if (in_array($teamname, $arrAprilia)){					$constructor = "Aprilia";				} else if (in_array($teamname, $arrHonda)){					$constructor = "Honda";				} 								$arrStandingTeams[] = array(					 'team' => $teamname,					 'team_flag' => $team_flag,					 'constructor' => $constructor,					 'win' => 0,					 'podium' => 0,					 'total_point' => $total_point,					 'position' => $position,					 'date_update' => date('Y-m-d H:i:s')				 );			}		}		}		$totalUpdate = 0;	if(count($arrStandingTeams)){		echo "<pre>";		print_r($arrStandingTeams);		echo "</pre>"; 	}		}echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";?>