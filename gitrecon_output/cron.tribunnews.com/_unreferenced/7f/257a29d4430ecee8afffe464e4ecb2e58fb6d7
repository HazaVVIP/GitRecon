<?php
ini_set('display_errors',1);
error_reporting(E_ALL);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Opensearch.php";

$api_key = YOUTUBE_KEY_DEV;
$channelId = YOUTUBE_CHANNEL_ID;
$total = 0;
$total_update = 0;

$opensearch = new Opensearch();
$opensearch->init(OS_DEV_URL, OS_DEV_USERNAME, OS_DEV_PASSWORD, true);

$index = "tribunnews-video_streaming";
$videolist = array();

try 
{
    $condition = array("match_phrase" => array("video_live" => "1"));
    $fields = array("id", "video_id");
    $response = $opensearch->find($index, $condition, $fields);
    
    echo "<pre>";
    print_r($response['data']);
    echo "</pre>";

    if($response['status'] == 1)
    {
        foreach($response['data'] as $key => $value)
        {
            $video_id = $value['video_id'];
            $live_broadcast = 0;

            $apiUrl = "https://www.googleapis.com/youtube/v3/videos?part=snippet&id=".$video_id."&key=".$api_key;
            $opts = array(
                'http'=>array(
                    'method'=>"GET",
                    'timeout' => 5,
                    'header'=>"Accept-language: en\r\n"
                ),
                'ssl'  => array (
                    'verify_peer'      => false,
                    'verify_peer_name' => false,
                  )
                );
            $context = stream_context_create($opts);
            $apiData = @file_get_contents($apiUrl, false, $context);

            if($apiData === FALSE) 
            {
                throw new Exception("Failed to fetch data from YouTube API");
            } 
            else 
            {
                $videolist = json_decode($apiData);

                if(isset($videolist->items[0]->snippet->liveBroadcastContent) && $videolist->items[0]->snippet->liveBroadcastContent === "live")
                {
                    $live_broadcast = 1;
                }

                if($live_broadcast == 0)
                {
                    $data = array("video_live" => "0");
                    $condition = array("match_phrase" => array("video_id" => $video_id));
                    $response = $opensearch->update($index, $data, $condition);

                    if($response['status'] == 1)
                    {
                        $total_update++;

                        echo 'Updated video_id: '.$video_id.'<br>';
                    }
                }
            }
        }
    }
}
catch(Exception $e)
{
	$apierror = $e->getMessage();
}

//file_get_contents('https://api.tribunnews.com/tcache/update_custom_memcache/live_stream_os', false);

echo '<br>Total data updated: '.$total_update;
echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";