	}
	
	public function getListAllTransaksiTiketPerEvent(){
		 $con = $this->conn_db->conn_to_db_prod_read();
		$query = "SELECT k.name as nama_kota,tt.id, tt.kode_pemesanan,ti.kode_pemesanan as no_tiket,tt.kode_invoice,tt.bank_type, e.judul, tt.nama,tt.firstname,tt.lastname,tt.phone,tt.paid_time,ti.tgl_scan, tt.transaction_status, tt.status_paid, tt.tgl_transaksi, tt.total_harga, tt.gender,tt.email,ti.seat_no,tt.nik,te.ticket_name,e.event_type,cat.category_name,ti.no_bib,ti.tgl_bib,ti.status_rpc,ti.penerima_rpc,ti.phone_rpc,ti.pic_rpc,ti.tgl_diambil,e.metode_flag,ti.status as statusTicket,
				CASE
					WHEN JSON_VALID(tt.custom_field) AND JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.referral')) IS NOT NULL
					THEN JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.referral'))
					ELSE 0
					END AS referral,
					JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.nmkondar')) AS nmkondar,
					JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.darurat')) AS nokondar,
					JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.nik')) AS nik2,
					JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.golongan')) AS golongandarah,
					JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.dob')) AS dob,
					CASE
					WHEN JSON_VALID(tt.jersey) AND JSON_UNQUOTE(JSON_EXTRACT(tt.jersey, '$.jersey_racer')) IS NOT NULL
					THEN JSON_UNQUOTE(JSON_EXTRACT(tt.jersey, '$.jersey_racer'))
					ELSE 0
					END AS jersey_racer, CASE WHEN JSON_VALID(tt.jersey) AND JSON_UNQUOTE(JSON_EXTRACT(tt.jersey, '$.jersey_finisher')) IS NOT NULL
					THEN JSON_UNQUOTE(JSON_EXTRACT(tt.jersey, '$.jersey_finisher'))
					ELSE 0
					END AS jersey_finisher
					FROM tbl_transaksi tt 
					INNER JOIN `event` e ON tt.id_event=e.id
					INNER JOIN tbl_ticket_transaksi ti ON tt.id = ti.id_transaksi
					LEFT JOIN master_kota k on JSON_UNQUOTE(JSON_EXTRACT(tt.custom_field, '$.id_kota')) = k.id
					INNER JOIN ticket te ON ti.id_ticket = te.id
					LEFT JOIN tbl_ticket_category cat on te.id_category = cat.id where tt.status_paid = 'paid' AND tt.custom_field IS NOT NULL AND JSON_VALID(tt.custom_field) and tt.id_event = 477 LIMIT 5";
		$result = mysqli_query($con, $query);	
		return $result;
		
	}
