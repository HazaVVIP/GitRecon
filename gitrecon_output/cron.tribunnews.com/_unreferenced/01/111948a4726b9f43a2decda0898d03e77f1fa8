<?php
ini_set('display_errors',1);
error_reporting(E_ALL);
//error_reporting(0);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require_once "vendor/autoload.php";
include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Opensearch.php";
include DOC_ROOT."lib/Google_analytic.php";

define("AUTH_CREDENTIAL_PROD", DOC_ROOT."google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");
define("AUTH_CREDENTIAL_STAG", DOC_ROOT."google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");
define("AUTH_CREDENTIAL_DEV", DOC_ROOT."google_analytic/angular-cosmos-220903.iam.gserviceaccount.json");

/* 
Running in command
- sudo -u cron /usr/bin/php7.4 /var/www/html/web-cron/google_analytic/insert_article_allnetwork.php > /home/cron/log_cron/insert_ga_article_allnetwork.txt
*/

$site = isset($_SERVER["argv"][1])?$_SERVER["argv"][1]:"";
if(isset($_GET['site'])){
	$site = $_GET['site'];
}	

$google_analytic = new Google_analytic(AUTH_CREDENTIAL_PROD);

$applicationName = "Tribun All Network Top Article";
$viewId = "90636734"; //tribunnews all network
$google_analytic->initializeAnalytics($applicationName,$viewId);
$analytics = $google_analytic->getReportTopArticle($site);

$dataPopuler = array();
$total = 0;
if($analytics['status']){
	$dataPopuler = $google_analytic->getResultTopArticle($analytics);
	
	if(count($dataPopuler) > 0){
		$opensearchTest = new Opensearch();
		$opensearchTest->init(ES_TEST_URL,"","",false);
		
		$opensearch = new Opensearch();
		$opensearch->init(OS_URL,OS_USERNAME,OS_PASSWORD,true);
		
		echo "<pre>";
		print_r($dataPopuler);
		echo "</pre>";
		
		foreach($dataPopuler as $row){
			$id = intval($row['id']);
			$domain = $row['site'];
			$title = $row['title'];
			$title = trim(str_replace(" -  Halaman all","",$title));
			$section_alias = isset($row['section'])?$row['section']:"";
			$topic = $row['topic'];
			$publish_date = $row['publish_date'];
			$editor_fullname = $row['editor'];
			$writter_fullname = $row['author'];
			$pageviews = intval($row['pageviews']);
			$arrContentTag = (isset($row['tag']) && !empty($row['tag']))?explode(",",$row['tag']):array();
			$arrTag = array();
			if(count($arrContentTag) > 0){
				foreach($arrContentTag as $tag){
					$arrTagDetail = array();
					$arrTagDetail['alias'] = url_title(trim($tag),"dash",true);;
					$arrTagDetail['title'] = trim($tag);
					array_push($arrTag,$arrTagDetail);
				}	
			}
						
		}				
						
	}
}

echo "Total : ".$total."\n";

unset($opensearch);

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
?>