<?php
include_once DOC_ROOT."config/config.php";

//RDS
class config_db_booking{
    private $db_host;
    private $db_username;
    private $db_password;

    public function __construct()
    {
        $this->db_host = BOOKING_HOST_DEV;
        $this->db_username = BOOKING_USERNAME_DEV;
        $this->db_password = BOOKING_PASSWORD_DEV;
    }
    
    public function conn_to_db()
    {
        $db_name = "booking";
        $mysqli = new mysqli($this->db_host, $this->db_username,$this->db_password,$db_name);
        if ($mysqli->connect_errno) {
            echo "Failed to connect to MySQL: " . $mysqli -> connect_error;
            exit();
        }

        return $mysqli;
    }


}


