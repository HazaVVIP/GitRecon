<?php
date_default_timezone_set('Asia/Jakarta');
ini_set('display_errors',1);
error_reporting(E_ALL);

$apiKey = 'bda7647c-53ce-4b2e-a0b7-3d24f2d60fee';
$country = 'Indonesia';
//$state = 'Jakarta'; $city = 'Jakarta';
$state = 'Bali'; $city = 'Denpasar';

$url = "https://api.airvisual.com/v2/city?city={$city}&state={$state}&country={$country}&key={$apiKey}";

$ch = curl_init();
curl_setopt($ch, CURLOPT_URL, $url);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
$response = curl_exec($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

echo $httpCode."<br>";
echo $url."<br>";

if ($httpCode === 200) {
    $data = json_decode($response, true);
	$status = ($data['status'] && $data['status'] == "success") ? 1 : 0;

    if ($status) {
        $res_country = $data['data']['country'];
        $res_state = $data['data']['state'];
		$res_city = $data['data']['city'];
        $res_current = $data['data']['current'];
		
		echo "<pre>";
		print_r($data);
		echo "</pre>";
		
		$weather = $res_current['weather'];
		
		$date = new DateTime($weather['ts'], new DateTimeZone('UTC'));
		$date->setTimezone(new DateTimeZone('Asia/Jakarta'));
		$ts = $date->format('Y-m-d H:i:s');
		
        echo "📍 Lokasi: " . $res_city . "<br>\n";
        echo "Waktu: " . $ts . "<br>\n";
        echo "Suhu: " . $weather['tp'] . "°C<br>\n";
        echo "Kelembapan: " . $weather['hu'] . "%<br>\n";
        echo "Tekanan Udara: " . $weather['pr'] . " hPa<br>\n";
        //echo "Awan: " . $weather['cloud_cover']['value'] . "%<br>\n";
        echo "Kecepatan Angin: " . $weather['ws'] . " km/h<br>\n";
        echo "Arah Angin: " . $weather['wd'] . "°<br>\n";
    } else {
        echo "❌ Data tidak ditemukan untuk kota {$city}\n";
    }
} else {
    echo "❌ HTTP Error Code: {$httpCode}\n";
    echo "Response: {$response}\n";
}