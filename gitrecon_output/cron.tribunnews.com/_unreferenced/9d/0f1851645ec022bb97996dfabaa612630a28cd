<?php
include_once "/var/www/html/web-cron/config/config.php";

ini_set("display_errors",1);
error_reporting(E_ALL);
define('TIMEZONE', 'Asia/Jakarta');
date_default_timezone_set(TIMEZONE);

$time_start = time();
$auth = base64_encode(''.API_TJB_AUTH_USERNAME.':'.API_TJB_AUTH_PASSWORD.'');
$url = "https://cenderaloka.com/cron/generate_data_widget";
$opts = array(
    'http' => array(
        'method' => "GET",
        'timeout' => 3,
        'header' => "Authorization: Basic " . $auth,
        'ignore_errors' => true
    ),
    'ssl'  => array(
        'verify_peer'      => false,
        'verify_peer_name' => false,
    )
);

$context = stream_context_create($opts);
$result = file_get_contents($url, false, $context);

echo "\nCron Execution time in seconds: ". (microtime(true) - $time_start) . "\n";
