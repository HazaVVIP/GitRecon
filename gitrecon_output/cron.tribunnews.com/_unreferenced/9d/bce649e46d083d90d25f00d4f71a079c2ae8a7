error_reporting(0);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require_once "vendor/autoload.php";
include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Google_analytic.php";

define("AUTH_CREDENTIAL_PROD", DOC_ROOT."google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");
define("AUTH_CREDENTIAL_STAG", DOC_ROOT."google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");
define("AUTH_CREDENTIAL_DEV", DOC_ROOT."google_analytic/angular-cosmos-220903.iam.gserviceaccount.json");

/* 
Running in command
- sudo -u cron /usr/bin/php7.4 /var/www/html/web-cron/google_analytic/insert_iklan_tribunjualbeli.php > /home/cron/log_cron/insert_ga_iklan_tribunjualbeli.txt
*/

$google_analytic = new Google_analytic(AUTH_CREDENTIAL_STAG);

$applicationName = "Tribunjualbeli Top Iklan";
$viewId = "90636734"; //tribun all network
$google_analytic->initializeAnalytics($applicationName,$viewId,"tribunjualbeli");
$analytics = $google_analytic->getTopIklanTribunjualbeli();

$populerData = array();
$dataPopuler = array();
$total = 0;
if($analytics['status']){
	$dataPopuler = $google_analytic->getResultTopIklanTribunjualbeli($analytics);
	
	if(count($dataPopuler) > 0){
		$arrPopuler = array();
		if(count($dataPopuler) > 0){
			foreach($dataPopuler as $idx => $populer){
				$post_id = isset($populer['id'])?intval($populer['id']):0; 
				$pageviews = isset($populer['pageviews'])?intval($populer['pageviews']):0; 
				
				if(!empty($post_id)){
					$arrPopuler[$idx]['id'] = $post_id;
					$arrPopuler[$idx]['pageviews'] = $pageviews;
				}
			}

			if(count($arrPopuler) > 0){
				$dataPost = array("populer"=>$arrPopuler);
				$dataSend = http_build_query($dataPost);   
				
				$apiUrl = API_TJB_URL."backend/iklan_insert_populer";
				$auth = base64_encode(''.API_TJB_AUTH_USERNAME.':'.API_TJB_AUTH_PASSWORD.'');
				$opts = array(
				  'http'=>array(
					'method'=>"POST",
					'header'=>"Accept-language: en\r\n" .
							  "Authorization: Basic ".$auth."\r\n" .
							  "Api-Key: ".API_TJB_AUTH_KEY."\r\n" .
							  "Content-Length: " . strlen($dataSend) . "\r\n",
					'content' => $dataSend
				  ),
				  'ssl'  => array (
					'verify_peer'      => false,
					'verify_peer_name' => false,
				  )
				);
				
				$context = stream_context_create($opts);
				$respond = @file_get_contents($apiUrl, false, $context);
				
				if($respond === FALSE){

				} else {
					$arrRespond = json_decode($respond, true);
					
					$populerData = isset($arrRespond['data'])?$arrRespond['data']:array();
				}
			}	
			
			$total = count($populerData);
			
			file_get_contents("https://www.tribunjualbeli.com/tcache/clear_home");
		}
	}
}

echo "Total : ".$total."\n";
echo "<pre>";
print_r($populerData);
echo "</pre>";

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
?>