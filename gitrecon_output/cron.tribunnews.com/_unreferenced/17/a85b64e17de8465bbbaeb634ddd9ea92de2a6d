	public function connect($mongo_host, $mongo_user, $mongo_password, $mongo_dbname, $db_auth=false, $options=array()){
		$connectionKey = md5($mongo_host . $mongo_user . $mongo_dbname);
		
		$this->server = $mongo_host;
		$this->username = $mongo_user;
		$this->password = $mongo_password;
		$this->dbname = $mongo_dbname;
		$this->auth = $db_auth;

		try {
            if (!isset(self::$sharedClients[$connectionKey])) {
                $arrOptions = array(
									'username' 					=> $this->username,
									'password' 					=> $this->password,
									'db'       					=> $this->dbname,
									'port' 						=> 27017
								);

                if (is_countable($options) && count($options)) {
                    $arrOptions = array_merge_recursive($arrOptions, $options);
                }

                if ($db_auth === false) {
                    $uri = "mongodb+srv://{$mongo_host}/?retryWrites=true&w=majority";
                } else {
                    $uri = "mongodb+srv://{$mongo_user}:{$mongo_password}@{$mongo_host}/?retryWrites=true&w=majority";
                }

                self::$sharedClients[$connectionKey] = new Client($uri, $arrOptions);
            }

            $this->client = self::$sharedClients[$connectionKey];
            $this->db = $this->client->{$mongo_dbname};
        } catch (Exception $e) {
            return $e->getMessage();
        }
	}
	
	public function connect_replika($mongo_host, $mongo_user, $mongo_password, $mongo_dbname, $db_auth=false, $options=array()){
		$this->server = $mongo_host;
		$this->username = $mongo_user;
		$this->password = $mongo_password;
		$this->dbname = $mongo_dbname;
		$this->auth = $db_auth;
		
		try {
			if($this->auth === false){
				$this->client = new MongoDB\Client('mongodb+srv://'.$this->server.'');
			} else {													
				$arrOptions = array(
									'username' 					=> $this->username,
									'password' 					=> $this->password,
									'db'       					=> $this->dbname,
									'port' 						=> 27017,
									'connectTimeoutMS' 			=> 2000,
									'socketTimeoutMS' 			=> 3000,
									'serverSelectionTimeoutMS' 	=> 3000,
									'retryReads' 				=> true,
									'retryWrites' 				=> true,
									'maxPoolSize' 				=> 20,
									'minPoolSize' 				=> 3,
									'w' 						=> 'majority'
								);
				if(is_countable($options) && count($options)){
					$arrConnection = array_merge_recursive($arrOptions, $options);
				} else {
					$arrConnection = $arrOptions;
				}

				if ($db_auth === false) {
                    $uri = "mongodb+srv://{$mongo_host}/?retryWrites=true&w=majority";
                } else {
                    $uri = "mongodb+srv://{$mongo_user}:{$mongo_password}@{$mongo_host}/?retryWrites=true&w=majority";
                }

				$this->client = new MongoDB\Client($uri, $arrConnection);
			}

			$this->db = $this->client->{$mongo_dbname};
		} catch (Exception $e) {
			return $e->getMessage();
		}
	}
	
	public function close() {
		unset($this->client);
	}
	
	public function findOne($collection, $condition=array(), $fields=array()) {
		try {
			$options = array('projection'=>array());
			foreach($fields AS $f) {
				$options['projection'][$f] = 1;
			}
			return $this->db->$collection->findOne($condition, $options);
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}
	
	public function total($collection, $condition=array()) {
		try {
			return $this->db->$collection->countDocuments($condition);
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}
	
	public function find($collection, $condition=array(), $projections=array(), $sort=array(), $skip=-1, $limit=-1) {
		try {
			$options = array();
			if( !empty($projections ) ) {
				foreach($projections AS $f) {
					$options['projection'][$f] = 1;
				}
			}
			if( !empty($sort) ) {
				$options['sort'] = $sort;
			}
			if( $skip >= 0) {
				$options['skip'] = $skip;
			}
			if( $limit >= 0 ) {
				$options['limit'] = $limit;
			}
			return $this->db->$collection->find($condition, $options)->toArray();
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}
	
	public function update($collection, $condition=array(), $newVal, $upsert=FALSE) {
		try {
			$options = array();
			if( $upsert ) {
				$options['upsert'] = TRUE;
			}
			
			return $this->db->$collection->updateOne($condition, $newVal, $options);
		} catch (Exception $e) {
			die($e->getMessage());
		}
	}
	
	public function updateMany($collection, $condition=array(), $newVal, $upsert=FALSE) {
		try {
			$options = array();
			if( $upsert ) {
				$options['upsert'] = TRUE;
			}
			$this->db->$collection->updateMany($condition, $newVal, $options);
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}
	
	public function insert($collection, $document) {
		try {
			return $this->db->$collection->insertOne($document);
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}
	
	public function insertMany($collection, $documents) {
		try {
			return $this->db->$collection->insertMany($documents);
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}

	public function findAndUpdate($collection, $query, $newVal, $upsert=false) {
		try {
			$options = array('upsert' => $upsert, 
				'returnDocument' => MongoDB\Operation\FindOneAndUpdate::RETURN_DOCUMENT_AFTER);
			return $this->db->$collection->findOneAndUpdate($query, $newVal, $options);
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}
	
	public function remove($collection, $condition) {
		try {
			if( empty($collection) || empty($condition) ) {
				return FALSE;
			}
			return $this->db->$collection->deleteOne($condition);
		} catch (Exception $e) {
			die($e->getMessage());
		}
	}

	public function renameField(&$obj, $oldField, $newField) {
		if( isset($obj->$oldField) ) {
			$obj->$newField = $obj->$oldField;
			unset($obj->{$oldField});
		}
	}
	
	public function deleteMany($collection, $condition) {	
		try {
			$result = $this->db->$collection->deleteMany($condition);		
			return $result;
		} catch (Exception $e) {
			die($e->getMessage());
		}
	}
	
	public function aggregate($collection, $query, $options) {		
		try {
			$ops = array();
			if( !empty($query ) ) {
				$query = array('$match'=>$query);
				array_push($ops, $query);
			}
			
			if( isset($options['unwind'])) {
				array_push($ops, array('$unwind'=>$options['unwind']));
			}
			
			if (isset($options['group'])) {
				$group = array('$group'=>$options['group']);
				array_push($ops, $group);
			}
			
			if (isset($options['project'])) {
				$project = array('$project'=>$options['project']);
				array_push($ops, $project);
			}
			
			if (isset($options['sort'])) {
				$sort = array('$sort'=>$options['sort']);
				array_push($ops, $sort);
			}
			
			if (isset($options['skip'])) {
				if ($options['skip']>0) {
					$skip = array('$skip'=>$options['skip']);
					array_push($ops, $skip);
				}
			}
			
			if (isset($options['limit'])) {
				if ($options['limit']>0) {
					$limit = array('$limit'=>$options['limit']);
					array_push($ops, $limit);
				}
			}
			
			if (isset($options['facet'])) {
				$facet = array('$facet' => $options['facet']);
				array_push($ops, $facet);
			}
			
			$result = $this->db->$collection->aggregate($ops)->toArray(); 

			return $result;
		} catch (Exception $e) {
			die($e->getMessage());
		}	
	}
