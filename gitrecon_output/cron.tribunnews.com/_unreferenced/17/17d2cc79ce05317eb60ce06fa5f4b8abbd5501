<?php
ini_set('display_errors',1);
error_reporting(E_ALL);
//error_reporting(0);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require_once DOC_ROOT."vendor/autoload.php";
include DOC_ROOT."config/config.php";

define("AUTH_CREDENTIAL_PROD", DOC_ROOT."google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");

$url = isset($_SERVER["argv"][1])?$_SERVER["argv"][1]:"https://kupang.tribunnews.com/2025/06/02/wisata-ntt-sumba-spot-liburan-terbaik-2024-versi-cnn-ini-4-daya-tarik-tanah-marapu";
if(isset($_GET['url'])){
	$url = $_GET['url'];
}	

// Inisialisasi client
$client = new Google_Client();
$client->setAuthConfig(AUTH_CREDENTIAL_PROD);
$client->addScope('https://www.googleapis.com/auth/indexing');

// Buat service HTTP client
$httpClient = $client->authorize();

// Request body
$content = json_encode([
    'url' => $url,
    'type' => 'URL_UPDATED'
]);

$response = $httpClient->post('https://indexing.googleapis.com/v3/urlNotifications:publish', [
    'headers' => ['Content-Type' => 'application/json'],
    'body' => $content
]);

echo $url."<br>";
echo $response->getStatusCode()."<br>";
echo "<pre>";
print_r($response->getBody());
echo "</pre>";

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
?>