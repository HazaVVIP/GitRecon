	public function initializeAnalytics($applicationName,$viewId,$website="",$type="",$period=""){
		if (!function_exists('curl_reset')){
			function curl_reset(&$ch){
				$ch = curl_init();
			}
		}

		$this->applicationName = $applicationName;
		$this->viewId = $viewId;
		$this->website = $website;
		$this->type = $type;
		$this->period = $period;

		$client = new Google_Client();
		$client->setApplicationName($this->applicationName);
		$client->setAuthConfig($this->ga_credential_file);
		$client->setScopes(['https://www.googleapis.com/auth/analytics.readonly']);
		$this->analytics = new Google_Service_AnalyticsReporting($client);

		return $this->analytics;
	}
	
	public function expiredMemcached(){
		$expiredMemcached = $this->ga_memcached_short_expired;
		if($this->type == "date"){
			$timeNow = strtotime(date("Y-m-d"));
			$timePeriod = strtotime($this->period);
			
			if($timePeriod < $timeNow){
				$expiredMemcached = $this->ga_memcached_expired;
			}
		} else if($this->type == "month"){
			$timeNow = strtotime(date("Y-m"));
			$timePeriod = strtotime($this->period);
			
			if($timePeriod < $timeNow){
				$expiredMemcached = $this->ga_memcached_long_expired;
			}
		} else if($this->type == "month"){
			$timeNow = strtotime(date("Y"));
			$timePeriod = strtotime($this->period);
			
			if($timePeriod < $timeNow){
				$expiredMemcached = $this->ga_memcached_long_expired;
			}
		}
		
		return $expiredMemcached;
	}
	
