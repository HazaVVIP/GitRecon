	public function printResultTopArticle($reports,$limit=10) {
		$arrArticle = array();
		
		if(count($reports) > 0){
			$idx = 0;

			if($limit > 100){
				$limit = 100;
			}
			
			foreach($reports as $k_report => $report){
				$rows = $report->getData()->getRows();
				
				foreach($rows as $k_row => $row){
					$id = isset($row->dimensions[0])?$row->dimensions[0]:"";
					$title = isset($row->dimensions[1])?$row->dimensions[1]:"";
					$editor = isset($row->dimensions[2])?$row->dimensions[2]:"";
					$author = isset($row->dimensions[3])?$row->dimensions[3]:"";
					$date = isset($row->dimensions[4])?$row->dimensions[4]:"";
					$section = isset($row->dimensions[5])?$row->dimensions[5]:"";
					$domain = isset($row->dimensions[6])?$row->dimensions[6]:"";
					
					$datePublish = "";
					if(!empty($date)){
						$datePublish = substr(str_replace("-","/",$date),0,10);;
					}

					$metrics = $row->getMetrics();
					$pageviews = isset($metrics[0]['values'][0])?$metrics[0]['values'][0]:0;
					
					if($this->type == "today"){
						$arrArticle[$idx]['site'] = $this->website;
						if($this->viewId != "182427400"){
							$arrArticle[$idx]['site'] = $domain;
						}	
						$arrArticle[$idx]['id'] = $id;
						$arrArticle[$idx]['title'] = $title;
						$arrArticle[$idx]['editor'] = $editor; 
						$arrArticle[$idx]['author'] = $author; 
						$arrArticle[$idx]['section'] = $section; 
						$arrArticle[$idx]['date'] = $date; 
						if($this->viewId == "182427400"){
							$arrArticle[$idx]['url'] = 'https://www.tribunnews.com/'.$datePublish."/".$this->url_title($title,'dash',TRUE); 
						} else {
							$arrArticle[$idx]['url'] = 'https://'.$domain.'.tribunnews.com/'.$datePublish."/".$this->url_title($title,'dash',TRUE); 
						}
						$arrArticle[$idx]['pageviews'] = $pageviews;
						$idx++;
					} else {
						$arrArticle[$idx]['site'] = $this->website;
						if($this->viewId != "182427400"){
							$arrArticle[$idx]['site'] = $domain;
						}
						$arrArticle[$idx]['id'] = $id;
						$arrArticle[$idx]['title'] = $title;
						$arrArticle[$idx]['editor'] = $editor; 
						$arrArticle[$idx]['author'] = $author; 
						$arrArticle[$idx]['section'] = $section; 
						$arrArticle[$idx]['date'] = $date; 
						if($this->viewId == "182427400"){
							$arrArticle[$idx]['url'] = 'https://www.tribunnews.com/'.$datePublish."/".$this->url_title($title,'dash',TRUE); 
						} else {
							$arrArticle[$idx]['url'] = 'https://'.$domain.'.tribunnews.com/'.$datePublish."/".$this->url_title($title,'dash',TRUE); 
						}  
						$arrArticle[$idx]['pageviews'] = $pageviews;
						$idx++;
					}
					
					if($idx == $limit) break;
				}
			}
		}
		
		return $arrArticle;
	}
	
