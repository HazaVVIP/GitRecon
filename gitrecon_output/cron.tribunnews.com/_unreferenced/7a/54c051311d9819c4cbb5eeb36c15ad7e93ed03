	private function array_search_key_exists($value='',$key='', $haystack=array(), $isindex=false){
		foreach ($haystack as $idx => $item) {
			if ($item[$key]===$value) {
				if($isindex){
					return $idx;
				} else {
					return true;
				}
			}
		}
		return false;
	}
	
