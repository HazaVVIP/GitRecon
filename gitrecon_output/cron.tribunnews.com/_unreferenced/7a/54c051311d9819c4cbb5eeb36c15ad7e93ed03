	public function printResultTopTag($reports, $limit=10) {
		$arrTag = array();
		$arrTagDetail = array();
		$arrTagUnique = array();
		
		if(count($reports) > 0){
			$site = "";
			foreach($reports as $k_report => $report){
				$rows = $report->getData()->getRows();
				
				foreach($rows as $k_row => $row){
					$contenttag = isset($row->dimensions[0])?$row->dimensions[0]:"";
					$domain = isset($row->dimensions[1])?$row->dimensions[1]:"";
					
					$arrContentTag = explode(",",$contenttag);
					if(count($arrContentTag) > 0){
						foreach($arrContentTag as $tag){
							$tag = trim($tag);
							array_push($arrTagDetail,$tag);
						}
					}
					
					$site = $this->website;
					if($this->viewId != "90636734"){
						$site = $domain;
					}
				}
				
				$arrTagFilter = array();
				if(count($arrTagDetail) > 0){
					$arrTagDetail = array_count_values($arrTagDetail);
					arsort($arrTagDetail);
					
					foreach($arrTagDetail as $tag => $total){
						array_push($arrTagFilter,$tag);
					}
				}
				
				if(count($arrTagFilter) > 0){
					$arrResultTag = array_unique($arrTagFilter);
					foreach($arrResultTag as $tag){
						array_push($arrTagUnique,$tag);
					}
					$arrTagUnique = array_slice($arrTagUnique, 0, $limit);
				}
			}
			
			
			
			$arrTag['site'] = $site;
