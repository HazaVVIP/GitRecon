	public function getReportTopArticle($strDomain="") {
		$analytic = array();
		$todayDate = date("Y-m-d");
		$hoursNow = date('G');
		
		try {
			$dateRange = new Google_Service_AnalyticsReporting_DateRange();
			if($hoursNow > 7){
				$dateRange->setStartDate("today");
			} else {
				$dateRange->setStartDate("1daysAgo");
			}
			$dateRange->setEndDate("today");
			
			$pageviews = new Google_Service_AnalyticsReporting_Metric();
			$pageviews->setExpression("ga:pageviews");
			$pageviews->setAlias("Pageviews");
			
			// Create the dimension object.
			$id = new Google_Service_AnalyticsReporting_Dimension();
			$id->setName("ga:dimension13");

			$title = new Google_Service_AnalyticsReporting_Dimension();
			$title->setName("ga:dimension6");
			
			$editor = new Google_Service_AnalyticsReporting_Dimension();
			$editor->setName("ga:dimension2");	

			$author = new Google_Service_AnalyticsReporting_Dimension();
			$author->setName("ga:dimension3");
			
			$datePublish = new Google_Service_AnalyticsReporting_Dimension();
			$datePublish->setName("ga:dimension4");
			
			$section = new Google_Service_AnalyticsReporting_Dimension();
			$section->setName("ga:dimension7");
			
			$domain = new Google_Service_AnalyticsReporting_Dimension();
			$domain->setName("ga:dimension5");
			
			$topic = new Google_Service_AnalyticsReporting_Dimension();
			$topic->setName("ga:dimension22");
			
			$tag = new Google_Service_AnalyticsReporting_Dimension();
			$tag->setName("ga:dimension15");
			
			$arrDimensionsFilterClauses = array();
			
			$dimensionFilterTitle = new Google_Service_AnalyticsReporting_SegmentDimensionFilter();
			$dimensionFilterTitle->setDimensionName("ga:dimension6");
			$dimensionFilterTitle->setOperator("REGEXP");
			$dimensionFilterTitle->setExpressions(array(".*[?!halaman|?!halaman|?!topik|?!page|?!page]$"));
			$dimensionFilterClauseTitle= new Google_Service_AnalyticsReporting_DimensionFilterClause();
			$dimensionFilterClauseTitle->setFilters(array($dimensionFilterTitle));
			array_push($arrDimensionsFilterClauses, $dimensionFilterClauseTitle);
			
			if(!empty($strDomain)){
				$strDomain = strtolower($strDomain);
				$dimensionFilterSection = new Google_Service_AnalyticsReporting_SegmentDimensionFilter();
				$dimensionFilterSection->setDimensionName("ga:dimension5");
				$dimensionFilterSection->setOperator("EXACT");
				$dimensionFilterSection->setExpressions(array("$strDomain"));
				$dimensionFilterClauseSection = new Google_Service_AnalyticsReporting_DimensionFilterClause();
				$dimensionFilterClauseSection->setFilters(array($dimensionFilterSection));
				array_push($arrDimensionsFilterClauses, $dimensionFilterClauseSection);
			} else {
				$isAll = true;
				if($hoursNow > 3 && $hoursNow < 6){
					$isAll = false;
				} else if($hoursNow > 9 && $hoursNow < 12){
					$isAll = false;
				} else if($hoursNow > 15 && $hoursNow < 18){
					$isAll = false;
				} else if($hoursNow > 21 && $hoursNow < 24){
					$isAll = false;
				} 
				
				if(!$isAll){
					$dimensionFilterSection = new Google_Service_AnalyticsReporting_SegmentDimensionFilter();
					$dimensionFilterSection->setDimensionName("ga:dimension5");
					$dimensionFilterSection->setOperator("REGEXP");
					$dimensionFilterSection->setExpressions(array("[^tribunnews]"));
					$dimensionFilterClauseSection = new Google_Service_AnalyticsReporting_DimensionFilterClause();
					$dimensionFilterClauseSection->setFilters(array($dimensionFilterSection));
					array_push($arrDimensionsFilterClauses, $dimensionFilterClauseSection);
				}
			}	
			
			//filter publish date
			$todayDate = date("Y-m-d");
			$arrExpressions = array();
			array_push($arrExpressions, array("^".$todayDate.""));
			$dimensionFilterDate = new Google_Service_AnalyticsReporting_SegmentDimensionFilter();
			$dimensionFilterDate->setDimensionName("ga:dimension4");
			$dimensionFilterDate->setOperator("REGEXP");
			$dimensionFilterDate->setExpressions($arrExpressions);
			$dimensionFilterClauseDate = new Google_Service_AnalyticsReporting_DimensionFilterClause();
			$dimensionFilterClauseDate->setFilters(array($dimensionFilterDate));
			array_push($arrDimensionsFilterClauses, $dimensionFilterClauseDate);
			
			$ordering = new Google_Service_AnalyticsReporting_OrderBy();
			if($hoursNow > 2 && $hoursNow < 6){
				$ordering->setFieldName("ga:dimension4");
			} else if($hoursNow > 6 && $hoursNow < 10){
				$ordering->setFieldName("ga:pageviews");
			} else if($hoursNow > 10 && $hoursNow < 14){
				$ordering->setFieldName("ga:dimension4");
			} else if($hoursNow > 14 && $hoursNow < 18){
				$ordering->setFieldName("ga:pageviews");
			} else if($hoursNow > 18 && $hoursNow < 22){
				$ordering->setFieldName("ga:dimension4");
			} else {
				$ordering->setFieldName("ga:pageviews");
			}	
			$ordering->setOrderType("VALUE");   
			$ordering->setSortOrder("DESCENDING");

			// Create the ReportRequest object.
			$request = new Google_Service_AnalyticsReporting_ReportRequest();
			$request->setViewId($this->viewId);
			$request->setDateRanges($dateRange);
			$request->setPageSize(625); 
			$request->setDimensions(array($id,$title,$editor,$author,$datePublish,$section,$domain,$topic,$tag));
			$request->setMetrics(array($pageviews));
			$request->setDimensionFilterClauses($arrDimensionsFilterClauses);
			$request->setOrderBys($ordering);

			$body = new Google_Service_AnalyticsReporting_GetReportsRequest();
			$body->setReportRequests( array( $request) );
			$analytic = $this->analytics->reports->batchGet( $body );
			$analytic['status'] = 1;
		} catch (Exception $e) {
			$errRespond = json_decode($e->getMessage(),TRUE);
			$analytic['code'] = isset($errRespond['error']['code'])?$errRespond['error']['code']:"";
			$analytic['message'] = isset($errRespond['error']['message'])?$errRespond['error']['message']:"";			
			$analytic['status'] = 0;			
		}
		
		return $analytic;
	}
	
