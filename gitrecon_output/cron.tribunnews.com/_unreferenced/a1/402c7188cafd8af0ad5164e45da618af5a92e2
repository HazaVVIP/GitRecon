<?php
ini_set("memory_limit", "-1");
set_time_limit(0);
ini_set("display_errors", 1);
error_reporting(E_ALL);

$time_start = microtime(true);

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT . "config/config.php";
include DOC_ROOT . "lib/Opensearch.php";

/* 
Running in command
- sudo -u www-data /usr/bin/php7.4 /var/www/html/web-cron/tribunnews/video/video_nbs.php > /home/cron/log_cron/video_nbs.txt
*/


$opensearch = new Opensearch();
$opensearch->init(OS_DEV_URL, OS_DEV_USERNAME, OS_DEV_PASSWORD, true);

$apiBaseUrl = URL_NDS;
$sortOptions = [
    "latest" => "video_nbs_latest",
    "popular" => "video_nbs_popular"
];

$status = $opensearch->infoStatus();
if (!$status['status']) {
    die("OpenSearch connection failed: " . ($status['error_reason'] ?? 'Unknown error') . "\n");
}

function fetchVideos($sortBy, $apiBaseUrl, $limit = 50, $skip = 0) {
    $credentials = base64_encode(USERNAME_NDS . ":" . PASSWORD_NDS);
    
    $ch = curl_init();
    
    curl_setopt_array($ch, [
        CURLOPT_URL => "{$apiBaseUrl}/v1/vod-contents?skip={$skip}&limit={$limit}&sortBy={$sortBy}",
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_HTTPHEADER => [
            'Authorization: Basic ' . $credentials
        ]
    ]);
    
    $response = curl_exec($ch);
    $error = curl_error($ch);
    
    curl_close($ch);
    
    if ($error) {
        echo "cURL Error: " . $error . "\n";
        return null;
    }
    
    return json_decode($response, true);
}

function ensureIndexExists($indexName, $opensearch) {
    $check = $opensearch->map($indexName);
    if (!$check['status']) {
        echo "⚠️ Index {$indexName} not found. Creating index...\n";

        $mapping = [
            "id" => "keyword",
            "video_name" => "text",
            "video_slug" => "text",
            "video_description" => "text",
            "video_orientation" => "integer",
            "category_id" => "keyword",
            "category_name" => "text",
            "video_total_view" => "integer",
            "tags" => "nested_tagging_video_nbs",
            "editor_id" => "keyword",
            "editor_name" => "text",
            "host_id" => "keyword",
            "host_name" => "text",
            "cover_url" => "text",
            "video_url" => "text",
            "video_hls_url" => "text",
            "video_dash_url" => "text",
            "video_createdat" => "date",
            "video_publishedat" => "date",
            "video_updatedat" => "date",
            "video_status" => "integer",
            "sort_by" => "keyword"
        ];

        $createIndex = $opensearch->create($indexName, $mapping);
        if (!$createIndex['status']) {
            die("Failed to create index {$indexName}: " . ($createIndex['error_reason'] ?? "Unknown error") . "\n");
        }
    }
}

$totalData = 0;
foreach ($sortOptions as $sortBy => $indexName) {
    ensureIndexExists($indexName, $opensearch);

    $existingRecords = $opensearch->count_total($indexName);

    if ($existingRecords['status'] === 1 && $existingRecords['total'] > 0) {
        $deleteResponse = $opensearch->deleteMany($indexName);

        if (!$deleteResponse['status']) {
            echo "Failed to delete old data in {$indexName}: " . ($deleteResponse['error_reason'] ?? "Unknown error") . "\n";
            continue;
        }
    }

    $videos = fetchVideos($sortBy, $apiBaseUrl, 100);
    if (!$videos || !isset($videos["data"]["items"])) {
        echo "Failed to fetch video data for {$sortBy}\n";
        continue;
    }

    $allVideos = [];
    foreach ($videos["data"]["items"] as $video) {
        $allVideos[] = [
            "id" => $video["xid"],
            "video_name" => $video["name"],
            "video_slug" => $video["slug"],
            "video_description" => strip_tags($video["description"]),
            "video_orientation" => $video["category"]["videoOrientation"]["id"] ?? null,
            "category_id" => $video["category"]["xid"] ?? null,
            "category_name" => $video["category"]["name"] ?? null,
            "video_total_view" => $video["totalViews"] ?? 0,
            "tags" => $video["tags"] ?? [],
            "editor_id" => $video["editor"]["xid"] ?? null,
            "editor_name" => $video["editor"]["name"] ?? null,
            "host_id" => $video["host"]["xid"] ?? null,
            "host_name" => $video["host"]["name"] ?? null,
            "cover_url" => $video["cover"]["url"] ?? null,
            "video_url" => $video["video"]["url"] ?? null,
            "video_hls_url" => $video["playback"]["hls"]["url"] ?? null,
            "video_dash_url" => $video["playback"]["dash"]["url"] ?? null,
            "video_createdat" => date("Y-m-d H:i:s", $video["createdAt"]),
            "video_publishedat" => isset($video["publishedAt"]) ? date("Y-m-d H:i:s", $video["publishedAt"]) : null,
            "video_updatedat" => isset($video["updatedAt"]) ? date("Y-m-d H:i:s", $video["updatedAt"]) : null,
            "video_status" => $video["status"]["id"] ?? null,
            "sort_by" => $sortBy
        ];
    }

    if (empty($allVideos)) {
        echo "No valid video data retrieved for {$sortBy}.\n";
        continue;
    }

    foreach ($allVideos as $video) {
        $insertResponse = $opensearch->insert($indexName, $video);
        if (!$insertResponse['status']) {
            echo "Failed to insert video ID {$video['id']} into {$indexName}: " . ($insertResponse['error_reason'] ?? "Unknown error") . "\n";
        } else {
			$totalData++;
		}	
    }
}

unset($opensearch);

echo "Total : ".$totalData."\n";
echo "⏳ Execution time: " . (microtime(true) - $time_start) . " seconds.\n";
?>
