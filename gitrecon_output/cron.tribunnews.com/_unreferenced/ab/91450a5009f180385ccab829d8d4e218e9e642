<?php
ini_set('display_errors',1);
error_reporting(E_ALL); 
//error_reporting(0);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

/* 
Running in cmd / command
- sudo -u cron /usr/bin/php7.4 /var/www/html/web-cron/ads/ads_sync_rds_os.php
*/

include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Opensearch.php";
include DOC_ROOT."lib/Writelog.php"; 

$writelog = new Writelog();
$writelog->Log(PATH_ROOT."/logs/","ads");

$lastid = 0;
$total = 0;
$filename = PATH_ROOT . "/data/lastid_ads.txt";
$valueLog = file_get_contents($filename);
if ($valueLog !== FALSE) {
	$lastid = $valueLog;
}


//RDS
$con = mysqli_connect(RDS_HOST,RDS_USERNAME,RDS_PASSWORD,"tribunnews");
if (mysqli_connect_errno()) {
	echo "Failed to connect to MySQL: " . mysqli_connect_error();
	exit();
}

$sql = "SELECT count(id) as total FROM ads_setting";
$result = mysqli_query($con, $sql);
$row = mysqli_fetch_assoc($result);
$totalRds = isset($row['total'])?$row['total']:0;


$total = 0;
if (empty($lastid)) {
	$sql = "SELECT *
			FROM ads_setting a
			ORDER BY a.id ASC
			LIMIT 1000";
	$result = mysqli_query($con, $sql);
	$total = mysqli_num_rows($result);
} else {
	$sql = "SELECT *
			FROM ads_setting a
			WHERE a.id > ".$lastid."
			ORDER BY a.id ASC
			LIMIT 1000";
	$result = mysqli_query($con, $sql);
	$total = mysqli_num_rows($result);
}	


//OS
$opensearch = new Opensearch();
$opensearch->init(ES_ADS_URL,ES_ADS_USERNAME,ES_ADS_PASSWORD,true);

$index = "tribunnews-ads_setting";

$totalSyncOs = 0;
if($total > 0){
	while($post = mysqli_fetch_assoc($result))
	{
		$id 						= isset($post['id'])?intval($post['id']):0;
		$unit 						= isset($post['unit'])?$post['unit']:"";
		$pos 						= isset($post['pos'])?$post['pos']:"";
		$page 						= isset($post['page'])?$post['page']:"";
		$section 					= isset($post['section'])?$post['section']:"";
		$status 					= isset($post['status'])?intval($post['status']):0;
		$start 						= isset($post['start'])?$post['start']:null;
		$finish 					= isset($post['finish'])?$post['finish']:null;
		$comment 					= isset($post['comment'])?$post['comment']:"";
		
		if($start == "0000-00-00 00:00:00") $start = null;
		if($finish == "0000-00-00 00:00:00") $finish = null;
		
		$arrInsert = array();
		$arrInsert['id'] = $id;
		$arrInsert['unit'] = $unit;
		$arrInsert['pos'] = $pos;
		$arrInsert['page'] = $page;
		$arrInsert['section'] = $section;
		$arrInsert['status'] = $status;
		$arrInsert['start'] = $start;
		$arrInsert['finish'] = $finish;
		$arrInsert['comment'] = $comment;
		
		$responseInsertOs = $opensearch->insert($index, $arrInsert);
					
		echo "<pre>";
		print_r($responseInsertOs);
		print_r($arrInsert);
		echo "</pre>";
		
		if($responseInsertOs['status']){
			$totalSyncOs++; 
		}
		
		$lastid = $id;
	}	
}

$totalOs = 0;
$condition = array("match_all"=>new stdClass);
$response_total = $opensearch->count_total($index,$condition);
if($response_total['status']){
	$totalOs = isset($response_total['total'])?$response_total['total']:0;
}

echo "TOTAL RDS : " . $totalRds . "\n";
echo "TOTAL OS : " . $totalOs . "\n";
echo "TOTAL MIGRASI : " . $totalSyncOs . "\n";
echo "LAST ID : " . $lastid . "\n";
if (!empty($lastid)) {
	if (!$handle = fopen($filename, 'w+')) {
		die("Cannot open file $filename");
	}
	if (fwrite($handle, $lastid) === FALSE) {
		die("Cannot write to file $this->log_file");
	}
	
	$loginfo = "TOTAL RDS = ".$totalRds." | TOTAL OS = ".$totalOs." | TOTAL MIGRASI = ".$totalSyncOs." | LAST ID = ".$lastid."\n";
	$writelog->doLogInfo($loginfo);
}

mysqli_free_result($result);
mysqli_close($con);
	unset($opensearch);	

echo '<br>Execution time in seconds: ' . (microtime(true) - $time_start) . "<br>";
?>