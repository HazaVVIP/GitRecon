	public function getReportTopArticleTribunnews($strDomain="") {
		$results = array();
		$todayDate = date("Y-m-d");
		$hoursNow = date('G');
		
		try {
			$arrDateRange = new DateRange([
						'start_date' => 'today',
						'end_date' => 'today',
					]);
			
			$limit = 175;
			if($hoursNow < 13){
				$limit = 170;
			} else if($hoursNow < 19 && $hoursNow >= 13){
				$limit = 165;
			} else if($hoursNow < 22 && $hoursNow >= 19){
				$limit = 155;
			} 
			
			$arrFilterExpressionClauses = array();
			array_push($arrFilterExpressionClauses, new FilterExpression([
                    'filter' =>    new Filter([
                        'field_name' => 'customEvent:publish_date',
                        'string_filter' => new Filter\StringFilter([
                          'match_type' => Filter\StringFilter\MatchType::BEGINS_WITH,
                          'value' => ''.$todayDate.'',
                         ])
                    ])
                ]));
				
			if(!empty($strSection)){
				array_push($arrFilterExpressionClauses, new FilterExpression([                
                    'filter' => new Filter([
                        'field_name' => 'customEvent:section',
                        'string_filter' => new Filter\StringFilter([
                          'match_type' => Filter\StringFilter\MatchType::EXACT,
                          'value' => $strSection,
                         ])
                    ]),   
                ]));
			}
				
			if($hoursNow > 0 && $hoursNow < 21){
				$orderByField = "screenPageViews";
			} else {
				$orderByField = "customEvent:publish_date";
			}
					
			$response = $this->client->runReport([
				'property' => 'properties/' . $this->propertyId,
				'dateRanges' => [
					$arrDateRange
				],
				'dimensions' => [
					new Dimension([
						'name' => 'customEvent:idArticle'
					]),
					new Dimension([
						'name' => 'customEvent:content_tag'
					])
				],
				'metrics' => [
					new Metric([
						'name' => 'screenPageViews',
					])
				],
				'dimensionFilter' => new FilterExpression([
					'and_group'=>  new FilterExpressionList([
						'expressions'=> $arrFilterExpressionClauses
					]),
				]),
				'orderBys' => [
					new OrderBy([
						'dimension' => new OrderBy\DimensionOrderBy([
							'dimension_name' => $orderByField,
							'order_type' => OrderBy\DimensionOrderBy\OrderType::ALPHANUMERIC
						]),
						'desc' => true,
					]),
				],
				"limit" => $limit
			]);
			
			$arrPopuler = array();
			foreach ($response->getRows() as $idx => $row) {
				$pageviews = $row->getMetricValues()[0]->getValue();
	
				$id = $row->getDimensionValues()[0]->getValue();
				$tag = $row->getDimensionValues()[1]->getValue();
				
				if(!empty($id)){
					$arrPopuler[$idx]['id'] = $id;
					$arrPopuler[$idx]['tag'] = $tag;
					$arrPopuler[$idx]['pageviews'] = $pageviews;
				}
			}

			$results['status'] = 1;	
			$results['data'] = $arrPopuler;	
		} catch (Exception $e) {
			$errRespond = json_decode($e->getMessage(),TRUE);

			$results['status'] = 0;	
			$results['code'] = isset($errRespond['code'])?$errRespond['code']:"";
			$results['message'] = isset($errRespond['message'])?$errRespond['message']:"";			
		}

		return $results;	
	}	
	
