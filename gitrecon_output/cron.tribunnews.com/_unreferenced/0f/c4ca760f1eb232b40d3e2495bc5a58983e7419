<?php
ini_set('display_errors',1);
error_reporting(E_ALL);

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT."pialadunia2022/simple_html_dom.php";
include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Opensearch.php";

$time_start = time();

$grup_name = isset($_GET['grup'])?$_GET['grup']:"";
$update = isset($_GET['update'])?intval($_GET['update']):0;

if(!empty($grup_name)){
	$grup_name = strtoupper($grup_name);
	$grup_name = "Group ".$grup_name;
}

$url_pildun_klasmen = "https://www.foxsports.com/soccer/2022-fifa-world-cup/standings";

$options = array(
  'http'=>array(
	'method'=>"GET",
	'header'=>"Accept-language: en\r\n" .
			  "User-Agent: Mozilla/5.0 (iPad; U; CPU OS 3_2 like Mac OS X; en-us) AppleWebKit/531.21.10 (KHTML, like Gecko) Version/4.0.4 Mobile/7B334b Safari/531.21.102011-10-16 20:23:10\r\n"
  )
);

$context = stream_context_create($options);
$results = file_get_contents($url_pildun_klasmen, false, $context);

if($results != false){
	$dom = new DOMDocument('1.0', 'UTF-8');
	$dom->preserveWhiteSpace = false; 
	@$dom->loadHTML($results);
	$tables = $dom->getElementsByTagName('table');
	
	$country = array('England', 'Netherlands', 'United States', 'France', 'Spain', 'Switzerland', 'Japan', 'Belgium', 'Germany', 'South Korea');
	$translate = array('Inggris', 'Belanda', 'Amerika serikat', 'Prancis', 'Spanyol', 'Swiss', 'Jepang', 'Belgia', 'Jerman', 'Korea Selatan');
	
	$opensearchTest = new Opensearch();
	$opensearchTest->init(ES_TEST_URL,"","",false);
	
	$opensearchTBO = new Opensearch();
	$opensearchTBO->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);
	
	$no = 1;
	$isUpdate = 0;
	foreach ($tables as $idx => $table) {
		$rows = $table->getElementsByTagName('tr');

		foreach ($rows as $row) {   
            $cols = $row->getElementsByTagName('td');
			
			$urutan = @$cols[0]->textContent;
			$negara = @$cols[1]->textContent;
			$score_D = @$cols[2]->textContent;
			$wdl = @$cols[3]->textContent;
			$score_GM = @$cols[4]->textContent;
			$score_GK = @$cols[5]->textContent;
			$score_min_plus = @$cols[6]->textContent;
			$score_P = @$cols[7]->textContent;
			
			if(!empty($negara)){
				$arrWDL = explode("-",$wdl);
				
				$negara = str_replace($country, $translate, $negara);
				
				$score_M = isset($arrWDL[0])?$arrWDL[0]:0;
				$score_S = isset($arrWDL[1])?$arrWDL[1]:0;
				$score_K = isset($arrWDL[2])?$arrWDL[2]:0;
				
				if($no >= 1 && $no <= 4){
					$grup = "Group A";
				} else if($no >= 5 && $no <= 8){
					$grup = "Group B";
				} else if($no >= 9 && $no <= 12){
					$grup = "Group C";
				} else if($no >= 13 && $no <= 16){
					$grup = "Group D";
				} else if($no >= 17 && $no <= 20){
					$grup = "Group E";
				} else if($no >= 21 && $no <= 24){
					$grup = "Group F";
				} else if($no >= 25 && $no <= 28){
					$grup = "Group G";
				} else if($no >= 29 && $no <= 32){
					$grup = "Group H";
				} else if($no >= 33 && $no <= 36){
					$grup = "Group I";
				} else if($no >= 37 && $no <= 40){
					$grup = "Group J";
				} 
				
				if(!empty($grup_name)){
					if($grup_name == $grup){
						$condition = array("match" => array("negara" => $negara));
						$fields = array("id","image_negara_link","penulis_berita_negara","link_berita_negara");
						$response = $opensearchTBO->findOne("klasemen_pialadunia",$condition,$fields);
						
						/* echo "<pre>";
						print_r($response);
						echo "</pre>"; */
						
						if($response['status']){
							$id = isset($response['data']['_source']['id'])?intval($response['data']['_source']['id']):0;
							$link_berita_negara = isset($response['data']['_source']['link_berita_negara'])?$response['data']['_source']['link_berita_negara']:"";
							$penulis_berita_negara = isset($response['data']['_source']['penulis_berita_negara'])?$response['data']['_source']['penulis_berita_negara']:"";
							$image_negara_link = isset($response['data']['_source']['image_negara_link'])?$response['data']['_source']['image_negara_link']:"";
									
							if ($no%4 == 1) echo $grup."<hr>";
							echo "<img src='".$image_negara_link."' width='20'> | ".$negara." | ".$score_D." | ".$score_M." | ".$score_S." | ".$score_K." | ".$score_GM." | ".$score_GK." | ".$score_min_plus." | ".$score_P."<br>"; 
							if ($no%4 == 0) echo "<br>";
							
							if($update == 1){
								$arrUpdate = array();
								$arrUpdate['urutan'] = intval($urutan);
								$arrUpdate['score_D'] = intval($score_D);
								$arrUpdate['score_M'] = intval($score_M);
								$arrUpdate['score_S'] = intval($score_S);
								$arrUpdate['score_K'] = intval($score_K);
								$arrUpdate['score_GM'] = intval($score_GM);
								$arrUpdate['score_GK'] = intval($score_GK);
								$arrUpdate['score_min_plus'] = intval($score_min_plus);
								$arrUpdate['score_P'] = intval($score_P);
								
								$responseUpdate = $opensearchTBO->updateOne("klasemen_pialadunia", $id, $arrUpdate);
								
								/* echo "<pre>";
								print_r($responseUpdate);
								print_r($arrUpdate);
								echo "</pre>";  */
								
								$isUpdate = 1;
							}
						}
					}	
				} else {
					$condition = array("match" => array("negara" => $negara));
					$fields = array("id","image_negara_link","penulis_berita_negara","link_berita_negara");
					$response = $opensearchTBO->findOne("klasemen_pialadunia",$condition,$fields);
					
					/* echo "<pre>";
					print_r($response);
					echo "</pre>"; */
					
					if($response['status']){
						$id = isset($response['data']['_source']['id'])?intval($response['data']['_source']['id']):0;
						$link_berita_negara = isset($response['data']['_source']['link_berita_negara'])?$response['data']['_source']['link_berita_negara']:"";
						$penulis_berita_negara = isset($response['data']['_source']['penulis_berita_negara'])?$response['data']['_source']['penulis_berita_negara']:"";
						$image_negara_link = isset($response['data']['_source']['image_negara_link'])?$response['data']['_source']['image_negara_link']:"";
						
						if ($no%4 == 1) echo $grup."<hr>";
						echo "<img src='".$image_negara_link."' width='20'> | ".$negara." | ".$score_D." | ".$score_M." | ".$score_S." | ".$score_K." | ".$score_GM." | ".$score_GK." | ".$score_min_plus." | ".$score_P."<br>"; 
						if ($no%4 == 0) echo "<br>";
						
						if($update == 1){
							$arrUpdate = array();
							$arrUpdate['urutan'] = intval($urutan);
							$arrUpdate['score_D'] = intval($score_D);
							$arrUpdate['score_M'] = intval($score_M);
							$arrUpdate['score_S'] = intval($score_S);
							$arrUpdate['score_K'] = intval($score_K);
							$arrUpdate['score_GM'] = intval($score_GM);
							$arrUpdate['score_GK'] = intval($score_GK);
							$arrUpdate['score_min_plus'] = intval($score_min_plus);
							$arrUpdate['score_P'] = intval($score_P);
							
							$responseUpdate = $opensearchTBO->updateOne("klasemen_pialadunia", $id, $arrUpdate);
							
							/* echo "<pre>";
							print_r($responseUpdate);
							print_r($arrUpdate);
							echo "</pre>";  */
							
							$isUpdate = 1;
						}
					}
				}	
				
				
				$no++;
			}	
        }  
	}	
}	

echo 'Update : '.$isUpdate."<br>";
echo 'Total execution time in seconds: ' . (microtime(true) - $time_start);
?>