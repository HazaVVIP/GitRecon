	function get_id_post_by_date($start_date, $end_date) {
		$con = $this->conn_db_tjb->conn_to_db_tjb_prod();
        $sql = "SELECT id FROM post WHERE DATE(date_publish) BETWEEN '".$start_date."' AND '".$end_date."'";
        $result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}

	function get_post_by_array_id($arr_id) {
		$con = $this->conn_db_tjb->conn_to_db_tjb_prod();
		$string_id = implode(',', $arr_id);
		$where = "WHERE a.id IN (".$string_id.")";
		$sql = "SELECT a.id, a.title, a.user_id, a.status, a.price, a.type, a.condition, a.nego,
					a.map, a.description, a.date_created, a.date_publish, a.username, a.name, a.email, a.telephone,
					a.video, a.image, a.image_files, a.meta, a.tp_toplist, a.tp_meta, a.sold, a.is_commerce,
					a.category, c.title as category_title, c.alias as category_alias,
					a.subcategory, sc.title as subcategory_title, sc.alias as subcategory_alias,
					a.location, l.title as location_title, l.alias as location_alias,
					a.sublocation, sl.title as sublocation_title, sl.alias as sublocation_alias,
					a.kecamatan, k.title as kecamatan_title, k.alias as kecamatan_alias,
					a.merk, merk.title as merk_title, merk.alias as merk_alias,
					a.model, model.title as model_title, model.alias as model_alias,
					pr.premium_1, pr.premium_7h, pr.premium_3h,
					pr.premium_2, pr.premium_3, pr.premium_4,
					pr.date_paid as premium_date_paid, pr.status as premium_status
				FROM post a
					LEFT JOIN category c ON a.category = c.id
					LEFT JOIN subcategory sc ON a.subcategory = sc.id
					LEFT JOIN location l ON a.location = l.id
					LEFT JOIN sublocation sl ON a.sublocation = sl.id
					LEFT JOIN kecamatan k ON a.kecamatan = k.id
					LEFT JOIN merk merk on a.merk = merk.id
					LEFT JOIN model model on a.model = model.id
					LEFT JOIN payment pr on a.id = pr.id_post
				".$where;
		$result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}

