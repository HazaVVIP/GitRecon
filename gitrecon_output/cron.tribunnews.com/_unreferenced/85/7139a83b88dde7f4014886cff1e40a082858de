	}

	function update_status_voucher($id_voucher,$status_voucher)
	{
        $con = $this->conn_db_tjb->conn_to_db_tjb_prod();
        $sql = "UPDATE voucher_promo SET status_voucher = '".$status_voucher."', modified_by = 1, modified_date='".date('Y-m-d H:i:s')."' WHERE id_voucher = ".$id_voucher;
        $result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}
}
