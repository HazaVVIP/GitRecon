	function get_rpt_category($start_date, $end_date, $str_user_admin) {
		$con = $this->conn_db_tjb->conn_to_db_tjb_prod();
		$sql = "SELECT a.category, b.alias, count(a.id) as total, 
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '1' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' 
				) as total_publish,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '1' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' AND x.user_id NOT IN (".$str_user_admin.")
				) as total_real_publish,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status <> '1' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' 
				) as total_unpublish,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status <> '1' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' AND x.user_id NOT IN (".$str_user_admin.")
				) as total_real_unpublish,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '0' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' 
				) as total_pending,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '0' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' AND x.user_id NOT IN (".$str_user_admin.")
				) as total_real_pending,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '2' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' 
				) as total_expired,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '2' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' AND x.user_id NOT IN (".$str_user_admin.")
				) as total_real_expired,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '3' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' 
				) as total_delete,
				(
				SELECT count(x.id) as total FROM post x WHERE x.category = a.category AND x.status = '3' AND x.is_commerce = 0 AND x.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59' AND x.user_id NOT IN (".$str_user_admin.")
				) as total_real_delete
				FROM post a 
				INNER JOIN category b ON a.category = b.id 
				WHERE a.date_created BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59'
				GROUP BY a.category ORDER BY category ASC";
		$result = mysqli_query($con, $sql);	
		mysqli_close($con);
		return $result;
	}

	function get_rpt_category_premium($start_date, $end_date) {
		$con = $this->conn_db_tjb->conn_to_db_tjb_prod();
		$sql = "SELECT b.category, c.alias, count(a.post_premium_id) as total FROM post_premium a 
				INNER JOIN post b ON a.post_id = b.id 
				INNER JOIN category c ON b.category = c.id 
				WHERE a.date_request BETWEEN '".$start_date." 00:00:00' AND '".$end_date." 23:59:59'
				GROUP BY b.category ORDER BY b.category ASC";
		$result = mysqli_query($con, $sql);	
		mysqli_close($con);
		return $result;
	}

	function check_iklan_premium($date)
	{
		$con = $this->conn_db_tjb->conn_to_db_tjb_prod();
        $sql = "SELECT pp.post_premium_id, pp.post_id, pp.user_id, pp.invoice, pp.product_json, pp.date_request, pp.date_expired, 
		s.email_user, sd.product_id, p.product_package_id, p.product_title, p2.title, ipp.premium_name FROM post_premium pp 
		LEFT JOIN post p2 ON p2.id = pp.post_id 
		LEFT JOIN settlement s ON s.invoice = pp.invoice
		LEFT JOIN settlement_detail sd on sd.settlement_id = s.settlement_id
		LEFT JOIN product p on sd.product_id = p.product_id 
		LEFT JOIN iklan_premium_package ipp on ipp.id_premium_package = p.product_package_id 
		WHERE DATE(pp.date_request) = '".$date."' and pp.post_id = '2779295'";
        $result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}

	public function get_data_voucher_pending_active($date_now)
	{   
        $con = $this->conn_db_tjb->conn_to_db_tjb_prod();
		$sql = "SELECT id_voucher, campaign_name, voucher_code, status_voucher, daily_balance, start_date, end_date, is_deleted
		FROM voucher_promo 
		WHERE DATE(start_date) <= '".$date_now."' and is_deleted = 0 and status_voucher = 'pending'
		ORDER BY id_voucher ASC";
		$result = mysqli_query($con, $sql);	
        mysqli_close($con);
		return $result;
	}

	public function get_data_voucher_active_expired($date_now)
	{
        $con = $this->conn_db_tjb->conn_to_db_tjb_prod();
		$sql = "SELECT id_voucher, campaign_name, voucher_code, status_voucher, daily_balance, start_date, end_date, is_deleted
		FROM voucher_promo 
		WHERE DATE_ADD(end_date, INTERVAL 1 DAY) <= '".$date_now."' and is_deleted = 0 and status_voucher = 'active'
		ORDER BY id_voucher ASC";
