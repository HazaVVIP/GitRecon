<?php
ini_set("memory_limit", "-1");
set_time_limit(0);
ini_set('display_errors',1);
error_reporting(E_ALL);

/* 
Running in cmd / command
- sudo -u cron /usr/bin/php7.4 /var/www/html/web-cron/tribunnews/privacy_policy/insert_privacy.php 
*/

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT."config/config.php";
include DOC_ROOT."lib/Opensearch.php";

$dateNow = date("Y-m-d");
$filename = "policy_issues_".$dateNow.".csv";
$path_filename = DOC_ROOT."/tribunnews/privacy_policy/data/".$filename;

if (file_exists($path_filename)) {
    echo "File $filename exists\n<br>";
	
	$index_name = "policy_violation";
	$totalData=0;
	$i=0;
	$arrAliasUnique = array();
	$insert_date = date('Y-m-d H:i:s');

	if (($open = fopen($path_filename, "r")) !== false) {
		//OS
		$opensearch = new Opensearch();
		//$opensearch->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);
		$opensearch->init(OS_DEV_URL,OS_DEV_USERNAME,OS_DEV_PASSWORD,true);
		
		$condition = array();
		$fields = array('id');
		$sort = array("id" => "desc");
		$start = 0;
		$limit = 1;
		$response_os = $opensearch->find($index_name,$condition,$fields,$sort,$start,$limit);

		$id = 0;
		if($response_os['status']){
			$id = isset($response_os['data'][0]['_id'])?intval($response_os['data'][0]['_id']):0;
		}	

		while (($records = fgetcsv($open, 1000, ",")) !== false) {
			if($i > 0){
				$domain = "";
				$site = isset($records[0])?trim($records[0]):"";
				if(!empty($site)){
					$arrSite = explode(".",$site);
					$domain = isset($arrSite[0])?$arrSite[0]:"";
					$domain = str_replace("2","",$domain);
					$domain_length = strlen($domain);
					if($domain_length == 1) $domain = str_replace("m","www",$domain);
				}	
				
				$alias = "";
				$url_article = isset($records[4])?trim($records[4]):"";
				if(!empty($url_article)){
					$new_alias = trim(parse_url($url_article)['path']); 
					if(!empty($site) && !empty($new_alias)){
						if($new_alias != "404"){
							$new_alias = str_replace($site."/","",$new_alias);
							
							$arrAlias = explode("/",$new_alias);
							if(count($arrAlias) == 4 || count($arrAlias) == 5){
								$alias = $new_alias;
							}
						}
						
						if($domain == "video"){
							$arrAlias = explode("/",$new_alias);
							
							if(count($arrAlias) == 3){
								$alias = isset($arrAlias[2])?$arrAlias[2]:"";
							}
						}
					}
				}
				
				$must_fix = isset($records[5])?trim($records[5]):"";
				$side_news = isset($records[6])?trim($records[6]):"";
				$date_report = isset($records[10])?trim($records[10]):"";
				
				if(!empty($domain) && !empty($alias) && !empty($side_news) && !empty($date_report)){
					if (!in_array($alias, $arrAliasUnique)){
						
						$condition = array("match_phrase" => array("alias" => $alias));
						$response = $opensearch->findOne($index_name, $condition);
						
						if(!$response['status']){
							$record = array();
							$record['id'] = $id;
							$record['domain'] = $domain;
							$record['alias'] = $alias;
							$record['side_news'] = $side_news;
							$record['side_news_title'] = "flag";
							$record['must_fix'] = $must_fix;
							$record['date_report'] = $date_report." 00:00:00";
							$record['status'] = 0;
							$record['insert_date'] = $insert_date;
							
							$responseInsertLog = $opensearch->insert($index_name, $record);
							
							array_push($arrAliasUnique, $alias);
							
							/* echo "<pre>";
							print_r($record);
							print_r($responseInsertLog);
							echo "</pre>"; */
							
							$totalData++;
							$id++;
						}
					}
				}
			}
			
			$i++;
		}
		
		fclose($open);
		unset($opensearch);
	}	
} else {
    echo "File $filename does not exist\n<br>";
}

echo 'Total insert data: '.$totalData;
echo '\n<br>Execution time in seconds: ' . (microtime(true) - $time_start);
?>