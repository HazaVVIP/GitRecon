<?php
/* ini_set('display_errors',1);
error_reporting(E_ALL); */
error_reporting(0);

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require_once DOC_ROOT."vendor/autoload.php";
include DOC_ROOT."config/config.php";

define("AUTH_CREDENTIAL_PROD", DOC_ROOT."google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");

$url = isset($_SERVER["argv"][1])?$_SERVER["argv"][1]:"https://kupang.tribunnews.com/2025/06/02/wisata-ntt-sumba-spot-liburan-terbaik-2024-versi-cnn-ini-4-daya-tarik-tanah-marapu";
if(isset($_GET['url'])){
	$url = $_GET['url'];
}	
$act = isset($_SERVER["argv"][1])?$_SERVER["argv"][1]:"update";
if(isset($_GET['act'])){
	$act = $_GET['act'];
}

$client = new Google_Client();
$client->setAuthConfig(AUTH_CREDENTIAL_PROD);
$client->addScope('https://www.googleapis.com/auth/indexing'); //https://developers.google.com/search/apis/indexing-api/v3/core-errors

$httpClient = $client->authorize();

$tipe = "URL_UPDATED";
if($act == "delete"){
	$tipe = "URL_DELETED";
} else if($act == "get"){
	$tipe = "";
}	

$content = json_encode([
    'url' => $url,
    'type' => $tipe 
]);

if($act == "get"){
	echo 'https://indexing.googleapis.com/v3/urlNotifications/metadata?url='.$url."<br>";
	$response = $httpClient->get('https://indexing.googleapis.com/v3/urlNotifications/metadata?url='.$url,
		['headers' => ['Content-Type' => 'application/json']
	]);
} else {	
	$response = $httpClient->post('https://indexing.googleapis.com/v3/urlNotifications:publish', [
		'headers' => ['Content-Type' => 'application/json'],
		'body' => $content
	]);
}

/* echo $response->getStatusCode()."<br>";
echo "<pre>";
print_r((string) $response->getBody());
echo "</pre>"; */

if($response->getStatusCode() == 200){
	$body = (string) $response->getBody();
	$data = json_decode($body, true);

	echo "Success ".$tipe." : ".$data['urlNotificationMetadata']['url']."<br>\n";
} else {
	$body = (string) $response->getBody();
	$data = json_decode($body, true);
	
	echo "Error ".$response->getStatusCode()." ".$data['error']['message']." : ".$data['urlNotificationMetadata']['url']."<br>\n";
}	

echo "\nExecution time in seconds: ". (microtime(true) - $time_start) . "\n";
?>