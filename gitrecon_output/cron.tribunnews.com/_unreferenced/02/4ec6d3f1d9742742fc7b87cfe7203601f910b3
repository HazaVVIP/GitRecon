<?php
ini_set('display_errors',1);
error_reporting(E_ALL); 

$time_start = time();

define("DOC_ROOT","/var/www/html/web-cron/");

require 'vendor_new/autoload.php';
include DOC_ROOT."config/config.php";
include DOC_ROOT."config/other_config.php";
include DOC_ROOT."lib/Opensearch.php";
include DOC_ROOT."lib/Google_analytic4.php";

define("AUTH_CREDENTIAL_PROD", DOC_ROOT."google_analytic/tribunnews-17d8f@appspot.gserviceaccount.json");
define("AUTH_CREDENTIAL_STAG", DOC_ROOT."google_analytic/google-analytic-dev@stone-goal-266105.iam.gserviceaccount.json");
define("AUTH_CREDENTIAL_DEV", DOC_ROOT."google_analytic/google-analytic@angular-cosmos-220903.iam.gserviceaccount");

use Google\Analytics\Data\V1beta\BetaAnalyticsDataClient;
use Google\Analytics\Data\V1beta\DateRange;
use Google\Analytics\Data\V1beta\Dimension;
use Google\Analytics\Data\V1beta\Filter;
use Google\Analytics\Data\V1beta\Filter\InListFilter;
use Google\Analytics\Data\V1beta\FilterExpression;
use Google\Analytics\Data\V1beta\FilterExpressionList;
use Google\Analytics\Data\V1beta\Metric;
use Google\Analytics\Data\V1beta\OrderBy;

$property_id = '280294341'; //tribunnews all network

// Using a default constructor instructs the client to use the credentials
// specified in GOOGLE_APPLICATION_CREDENTIALS environment variable.
$client = new BetaAnalyticsDataClient([
	'credentials' => AUTH_CREDENTIAL_PROD
]);

$todayDate = date("Y-m-d");
$hoursNow = date('G');

if($hoursNow > 7){
	$arrDateRange = new DateRange([
            'start_date' => 'today',
            'end_date' => 'today',
        ]);
} else {
	$arrDateRange = new DateRange([
            'start_date' => '1daysAgo',
            'end_date' => 'today',
        ]);
}	

$limit = 625;
if($hoursNow > 19){
	$limit = 525;
}

$arrFilterExpressionClauses = array();
/* array_push($arrFilterExpressionClauses, new FilterExpression([                
                    'filter' => new Filter([
                        'field_name' => 'customEvent:domain',
                        'string_filter' => new Filter\StringFilter([
                          'match_type' => Filter\StringFilter\MatchType::EXACT,
                          'value' => 'tribunnews',
                         ])
                    ]),   
                ])); */
array_push($arrFilterExpressionClauses, new FilterExpression([
                    'filter' =>    new Filter([
                        'field_name' => 'customEvent:publish_date',
                        'string_filter' => new Filter\StringFilter([
                          'match_type' => Filter\StringFilter\MatchType::BEGINS_WITH,
                          'value' => ''.$todayDate.'',
                         ])
                    ])
                ]));

if($hoursNow > 2 && $hoursNow < 6){
	$orderByField = "customEvent:publish_date";
} else if($hoursNow > 6 && $hoursNow < 10){
	$orderByField = "screenPageViews";
} else if($hoursNow > 10 && $hoursNow < 14){
	$orderByField = "customEvent:publish_date";
} else if($hoursNow > 14 && $hoursNow < 18){
	$orderByField = "screenPageViews";
} else if($hoursNow > 18 && $hoursNow < 23){
	$orderByField = "customEvent:publish_date";
} else {
	$orderByField = "screenPageViews";
}

// Make an API call.
$response = $client->runReport([
    'property' => 'properties/' . $property_id,
    'dateRanges' => [
        $arrDateRange
    ],
	'dimensions' => [
        new Dimension([
            'name' => 'customEvent:idArticle'
        ]),
		new Dimension([
            'name' => 'customEvent:title'
        ]),
        new Dimension([
            'name' => 'customEvent:domain'
        ]),
        new Dimension([
            'name' => 'customEvent:section'
        ]),
        new Dimension([
            'name' => 'customEvent:editor'
        ]),
        new Dimension([
            'name' => 'customEvent:penulis'
        ]),
        new Dimension([
            'name' => 'customEvent:content_tag'
        ]),
        new Dimension([
            'name' => 'customEvent:content_topic'
        ]),
        new Dimension([
            'name' => 'customEvent:publish_date'
        ])
    ],
    'metrics' => [
		new Metric([
            'name' => 'screenPageViews',
        ])
    ],
	'dimensionFilter' => new FilterExpression([
        'and_group'=>  new FilterExpressionList([
            'expressions'=> $arrFilterExpressionClauses
        ]),
	]),
	'orderBys' => [
        new OrderBy([
            'dimension' => new OrderBy\DimensionOrderBy([
                'dimension_name' => $orderByField,
                'order_type' => OrderBy\DimensionOrderBy\OrderType::ALPHANUMERIC
            ]),
            'desc' => true,
        ]),
    ],
	"limit" => $limit
]);

// Print results of an API call.
//print 'Report result: ' . PHP_EOL;

foreach ($response->getRows() as $row) {
	$pageviews = $row->getMetricValues()[0]->getValue();
	
	$id = $row->getDimensionValues()[0]->getValue();
	$title = $row->getDimensionValues()[1]->getValue();
	$domain = $row->getDimensionValues()[2]->getValue();
	$section = $row->getDimensionValues()[3]->getValue();
	$editor = $row->getDimensionValues()[4]->getValue();
	$penulis = $row->getDimensionValues()[5]->getValue();
	$tag = $row->getDimensionValues()[6]->getValue();
	$topic = $row->getDimensionValues()[7]->getValue();
	$publish_date = $row->getDimensionValues()[8]->getValue();
	
	if($topic == "(not set)") $topic = "";
	if($penulis == "(not set)") $penulis = "";
	
	
	if(!empty($id)){
		echo $id.' | ' .$title." | ".$domain." | ".$section." | ".$editor." | ".$penulis." | ".$publish_date." | ".$tag." | ".$topic." | ".$pageviews."<hr>";
	}
}
?>