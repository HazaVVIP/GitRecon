function url_title($str, $separator = '-', $lowercase = FALSE)
{
    if ($separator === 'dash')
    {
        $separator = '-';
    }
    elseif ($separator === 'underscore')
    {
        $separator = '_';
    }

    $q_separator = preg_quote($separator, '#');

    $trans = array(
        '&.+?;'            => '',              // Menghapus entitas HTML
        '[^\w\d _-]'       => '',              // Menghapus karakter non-alfanumerik
        '\s+'              => $separator,      // Mengganti spasi dengan separator
        '('.$q_separator.')+' => $separator   // Mengganti banyak separator berturut-turut dengan satu separator
    );

    $str = strip_tags($str);

    foreach ($trans as $key => $val)
    {
        $str = preg_replace('#'.$key.'#i', $val, $str);
    }

    if ($lowercase === TRUE)
    {
        $str = strtolower($str);
    }

    return trim(trim($str, $separator));
}

function get_description($description)
{
    $startPos = strpos($description, "TRIBUN-VIDEO.COM -");

    if ($startPos !== false) 
    {
        $startPos += strlen("TRIBUN-VIDEO.COM - ");
        $result = substr($description, $startPos);
        
        $endPos = strpos($result, "\n\n");
        if ($endPos !== false) 
        {
            $result = substr($result, 0, $endPos);
        }
        return $result;
    } 
    else 
    {
        return "Kata 'TRIBUN-VIDEO.COM -' tidak ditemukan dalam deskripsi.";
    }
}

