<?php
date_default_timezone_set('Asia/Jakarta');
set_time_limit(0);
ini_set('display_errors',1);
error_reporting(E_ALL);

define("DOC_ROOT","/var/www/html/web-cron/");

include DOC_ROOT ."config/config.php";
include DOC_ROOT ."lib/Utils.php";
include DOC_ROOT."lib/Opensearch.php";

$index = "quran";

$opensearchDev = new Opensearch();
$opensearchDev->init(OS_DEV_URL,OS_DEV_USERNAME,OS_DEV_PASSWORD,true);

$opensearchTBO = new Opensearch();
$opensearchTBO->init(OS_TBO_URL,OS_TBO_USERNAME,OS_TBO_PASSWORD,true);

$aggs = array(
    'list_surah' => array(
        'terms' => array(
            'field' => 'chapter_id',
            'size'  => 114,
            'order' => array('_key' => 'asc')
        ),
        'aggs' => array(
            'surah_detail' => array(
                'top_hits' => array(
                    'size' => 1,
                    '_source' => array(
                        'includes' => array(
                            'surah_name',
                            'chapter_id',
                            'chapter_name_latin_id',
							'chapter_translation_en',
                            'chapter_translation_id',
                            'chapter_type_id',
                            'chapter_type_en',
							'chapter_type_ar',
                            'chapter_total_verses',
							'chapter_alias'
                        )
                    ),
                    'sort' => array(
                        array('ayah_id' => array('order' => 'asc'))
                    )
                )
            )
        )
    )
);

$response = $opensearchTBO->aggregations('quran', $aggs);

$arrAlQuran = array();
if (isset($response['status']) && $response['status'] == 1) {
	$totalAyah = isset($response['total_row'])?intval($response['total_row']):0;
	$dataSurah = isset($response['data']['list_surah']['buckets'])?$response['data']['list_surah']['buckets']:array();
	
	if($totalAyah> 0){
		foreach($dataSurah as $arrSurah){
			$arrSurahDetail = isset($arrSurah['surah_detail']['hits']['hits'][0])?$arrSurah['surah_detail']['hits']['hits'][0]:array();
			
			if(count($arrSurahDetail) > 0){
				$row = $arrSurahDetail['_source'];
				
				$chapter_id = intval($row['chapter_id']);
				$chapter_name_ar = $row['surah_name'];
				$chapter_name_id = $row['chapter_name_latin_id'];
				$chapter_name_en = $row['chapter_translation_en'];
				$chapter_translation_id = $row['chapter_translation_id'];
				$chapter_translation_en = $row['chapter_translation_en'];
				$chapter_total_ayah = intval($row['chapter_total_verses']);
				$chapter_type_ar = $row['chapter_type_ar'];
				$chapter_type_id = $row['chapter_type_id'];
				$chapter_type_en = $row['chapter_type_en'];
				$chapter_alias = $row['chapter_alias'];
				
				$arrRow = array();
				$arrRow['chapter_id'] = $chapter_id;
				$arrRow['chapter_name_ar'] = $chapter_name_ar;
				$arrRow['chapter_name_id'] = $chapter_name_id;
				$arrRow['chapter_name_en'] = $chapter_name_en;
				$arrRow['chapter_translation_id'] = $chapter_translation_id;
				$arrRow['chapter_translation_en'] = $chapter_translation_en;
				$arrRow['chapter_total_ayah'] = $chapter_total_ayah;
				$arrRow['chapter_type_ar'] = $chapter_type_ar;
				$arrRow['chapter_type_id'] = $chapter_type_id;
				$arrRow['chapter_type_en'] = $chapter_type_en;
				$arrRow['chapter_alias'] = $chapter_alias;
				
				array_push($arrAlQuran,$arrRow);
			}
		}
	}
} else {
	$errorMessage = isset($response['error_reason']) ? $response['error_reason'] : 'Data surah tidak ditemukan';
}

unset($opensearchDev);
unset($opensearchTBO);
?>

