        // "Name" => "gol-tunggal-mason-greenwood-membuat-manchester-united-menang-1-0-atas-astana-kamis-1992019.jpg" // Tribun
        
    );
    $req->fromJsonString(json_encode($params));

    // The returned "resp" is an instance of the SearchMediaResponse class which corresponds to the request object
    $resp = $client->SearchMedia($req);

    // A string return packet in JSON format is output
    // print_r($resp->toJsonString());
    $resultVod = $resp->toJsonString();
    // print_r(json_decode($resultVod)->MediaInfoSet);
    $arr = array();
    foreach(json_decode($resultVod)->MediaInfoSet as $item){
        $arr_child = array(
            'title' => $item->BasicInfo->Name,
            'url' => $item->BasicInfo->MediaUrl,
            'publish_date' => $item->BasicInfo->CreateTime,
        );
        array_push($arr, $arr_child);
        // echo $item->BasicInfo->Name.'<br>';
    }

    print_r(json_decode($arr));


}
